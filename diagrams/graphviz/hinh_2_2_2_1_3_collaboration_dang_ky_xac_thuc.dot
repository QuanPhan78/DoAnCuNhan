    Auth [label=":CookieAuthHandler\n(Security)"];

    User -> View [label="1: Nhập thông tin & Submit"];
    View -> Ctrl [label="2: POST Register(model)"];
    Ctrl -> DB [label="3: Kiểm tra Email trùng\n5: Lưu NguoiDung mới"];
