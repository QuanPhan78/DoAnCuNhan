    edge [fontname="Segoe UI", fontsize=9.5, color="#000000", penwidth=1.2];

    User [label="Khách hàng\n(Actor)", shape=ellipse, fillcolor="#f4f4f5"];
    View [label=":RegisterView\n(Boundary)"];
    Ctrl [label=":AccountController\n(Control)", fillcolor="#27272a", fontcolor="#ffffff"];
