@startuml
scale max 3800*3800
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10.5
skinparam backgroundColor #ffffff

skinparam actor {
    BorderColor #000000
    BackgroundColor #ffffff
    FontColor #000000
    FontSize 11
    FontStyle bold
}

skinparam boundary {
    BorderColor #000000
    BackgroundColor #ffffff
    FontColor #000000
    FontSize 10.5
}

skinparam control {
    BorderColor #000000
    BackgroundColor #f4f4f5
    FontColor #000000
    FontSize 10.5
    FontStyle bold
}

skinparam entity {
    BorderColor #000000
    BackgroundColor #ffffff
    FontColor #000000
    FontSize 10.5
}

skinparam arrow {
    Color #000000
    Thickness 1.2
    FontColor #000000
    FontSize 10
}

actor "Khách hàng" as ActorKH
actor "Kỹ thuật viên\n(KyThuat)" as ActorKT
actor "Nhân viên Kinh doanh\n(KinhDoanh)" as ActorKD
boundary "Giao diện Nghiệm thu trả máy\n(ReturnMachineView)" as BoundaryReturn
boundary "Giao diện Chi tiết & Hoàn cọc\n(HopDongDetailsView)" as BoundaryDetails
control "Điều khiển Hợp đồng\n(HopDongController: HoanCoc)" as ControlHD
control "Thuật toán Quyết toán cọc\n(DebtCalculationHelper)" as ControlCalc
entity "Biên bản nghiệm thu\n(BienBanBanGiao: Loai 1)" as EntityBienBan
entity "Phiếu chi hoàn tiền\n(PhieuChi: LoaiChi 0)" as EntityPhieuChi
entity "Hợp đồng thuê\n(HopDong)" as EntityHopDong
entity "Thiết bị Serial\n(ThietBi)" as EntityThietBi
entity "Cơ sở dữ liệu\n(ApplicationDbContext)" as EntityDB

ActorKH --> BoundaryReturn : 1. Mang thiết bị hoàn trả tại quầy
ActorKT --> BoundaryReturn : 2. Kiểm tra ngoại quan & phụ kiện máy
ActorKD --> BoundaryDetails : 3. Thực hiện quyết toán & Hoàn cọc

BoundaryReturn --> ControlHD : 4. Lập biên bản nghiệm thu trả máy
BoundaryDetails --> ControlHD : 5. POST /Admin/HopDong/HoanCoc(id, model)

ControlHD --> ControlCalc : 6. Quyết toán: HoanLai = TienCoc - TienNo - PhiDenBu
ControlCalc --> ControlHD : 7. Trả về số tiền thực hoàn trả

ControlHD --> EntityDB : 8. Lưu phiếu chi & Đóng hợp đồng
EntityDB --> EntityBienBan : 9. Tạo BienBanBanGiao (LoaiBienBan = 1)
EntityDB --> EntityPhieuChi : 10. Tạo PhieuChi (LoaiChi = 0: Hoàn cọc)
EntityDB --> EntityHopDong : 11. Đổi HopDong.TrangThai = 2 (Đã hoàn tất)
EntityDB --> EntityThietBi : 12. Trả ThietBi.TrangThai = 0 (Sẵn sàng)

@enduml
