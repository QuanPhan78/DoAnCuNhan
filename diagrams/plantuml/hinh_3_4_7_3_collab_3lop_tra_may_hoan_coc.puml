@startuml
scale max 3800*3800
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10.5
skinparam backgroundColor #ffffff

skinparam rectangle {
    BorderColor #000000
    BackgroundColor #ffffff
    FontColor #000000
    FontSize 10.5
    FontStyle bold
}

skinparam arrow {
    Color #000000
    Thickness 1.2
    FontColor #000000
    FontSize 9.5
}

rectangle "1. Tác nhân\nKhách hàng" as User
rectangle "2. Giao diện\nReturn & Details View" as View
rectangle "3. Bộ điều khiển\nHopDongController" as Ctrl
rectangle "4. Thuật toán\nDebtCalculationHelper" as Helper
rectangle "5. Cơ sở dữ liệu\nApplicationDbContext" as DB
rectangle "6. Thực thể\nPhieuChi & ThietBi" as Entity
rectangle "7. Tác nhân\nNhân viên Kinh doanh" as Staff

User -right-> View : 1: Trả máy tại quầy\n10: Nhận tiền hoàn cọc
View -right-> Ctrl : 2: POST HoanCoc\n9: Xuất phiếu chi
Staff -left-> View : 3: Thực hiện hoàn cọc
Ctrl -down-> Helper : 4: Quyết toán nợ & Hư hỏng
Ctrl -right-> DB : 5: Tạo PhieuChi & Lưu CSDL\n7: await SaveChangesAsync()
DB -down-> Entity : 6: Đổi HopDong.TrangThai = 2\n8: Trả ThietBi về kho (TrangThai = 0)

@enduml
