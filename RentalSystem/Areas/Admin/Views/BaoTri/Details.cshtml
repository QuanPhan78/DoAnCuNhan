@model RentalSystem.Models.PhieuBaoTri
@{ ViewData["Title"] = "Chi tiết Bảo Trì"; }

<div class="mb-3">
    <a asp-action="Index" class="btn btn-light"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow border-0 mb-3">
            <div class="card-header text-brand fw-bold fw-bold">Thông tin sự cố</div>
            <div class="card-body">
                <p><strong>Mã Phiếu:</strong> #@Model.MaPhieu</p>
                <p><strong>Ngày báo lỗi:</strong> @Model.NgayBaoLoi.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Khách hàng:</strong> @Model.HopDong.KhachHang?.HoTen - SĐT: @Model.HopDong.KhachHang?.SoDienThoai</p>
                <p><strong>Sản phẩm:</strong> @Model.ThietBi.SanPham.TenSanPham</p>
                <p><strong>Serial Máy:</strong> @Model.ThietBi.SoSerial</p>
                <p><strong>Mô tả lỗi từ KH:</strong> <br /> <span class="text-danger fw-bold">@Model.MoTaLoi</span></p>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header text-warning fw-bold text-dark fw-bold">Xử lý & Cập nhật</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.MaPhieu" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phân công Kỹ Thuật Viên</label>
                        <select name="maKtv" class="form-select" asp-items="ViewBag.MaKyThuatVien">
                            <option value="">-- Chọn nhân viên Kỹ thuật --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái phiếu</label>
                        <select name="status" class="form-select">
                            <option value="1" selected="@(Model.TrangThai == 1)">Mới báo</option>
                            <option value="2" selected="@(Model.TrangThai == 2)">Đang xử lý</option>
                            <option value="3" selected="@(Model.TrangThai == 3)">Hoàn thành</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Phí đền bù (Nếu lỗi do KH)</label>
                        <input type="number" name="phiDenBu" class="form-control" value="@Model.PhiDenBu" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú sửa chữa của KTV</label>
                        <textarea name="ghiChu" class="form-control" rows="3">@Model.GhiChuSuaChua</textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-brand fw-bold w-100"><i class="fas fa-save"></i> Cập nhật</button>
                </form>
            </div>
        </div>
    </div>
</div>
