@model IEnumerable<RentalSystem.Models.PhieuBaoTri>
@{ ViewData["Title"] = "Quản lý Bảo Trì - Sự Cố"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold"><i class="fas fa-tools text-brand"></i> Quản lý Bảo Trì - Sự Cố</h2>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow border-0">
    <div class="card-body">
        <table class="table table-hover align-middle text-center">
            <thead class="">
                <tr>
                    <th>Mã Phiếu</th>
                    <th>Hợp Đồng</th>
                    <th>Ngày Báo Lỗi</th>
                    <th>Mô Tả Lỗi</th>
                    <th>Kỹ Thuật Viên</th>
                    <th>Trạng Thái</th>
                    <th>Đánh Giá</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold">#@item.MaPhieu</td>
                        <td><a href="/Admin/HopDong/Details/@item.MaHopDong">#@item.MaHopDong</a></td>
                        <td>@item.NgayBaoLoi.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-start">@item.MoTaLoi</td>
                        <td>@(item.KyThuatVien?.HoTen ?? "Chưa phân công")</td>
                        <td>
                            @if (item.TrangThai == 1) { <span class="badge bg-warning text-dark">Mới báo</span> }
                            else if (item.TrangThai == 2) { <span class="badge bg-brand">Đang xử lý</span> }
                            else if (item.TrangThai == 3) { <span class="badge bg-success">Hoàn thành</span> }
                        </td>
                        <td>
                            @if (item.DanhGiaSao.HasValue) {
                                <span class="text-warning">
                                    @for(int i=0; i<item.DanhGiaSao.Value; i++) { <i class="fas fa-star"></i> }
                                </span>
                            } else { <span>Chưa ĐG</span> }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-sm btn-brand"><i class="fas fa-eye"></i> Xử lý</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
