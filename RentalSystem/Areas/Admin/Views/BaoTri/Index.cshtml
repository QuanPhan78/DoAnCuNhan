@model IEnumerable<RentalSystem.Models.PhieuBaoTri>
@{ ViewData["Title"] = "Quản lý Bảo Trì - Sự Cố"; }

<div class="page-header">
    <h3 class="page-title"><i class="fas fa-tools"></i> Quản lý Bảo Trì - Sự Cố</h3>
    <a asp-action="Create" class="btn btn-navy">
        <i class="fas fa-plus-circle me-1"></i> Lập Phiếu Bảo Dưỡng Kho
    </a>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
}
@if (TempData["Error"] != null) {
    <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
}

<!-- Bộ lọc danh sách -->
<div class="mb-3 d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-sm @(ViewBag.CurrentTrangThai == null && ViewBag.CurrentFilter == null ? "btn-navy" : "btn-outline-navy")">Tất cả</a>
    <a asp-action="Index" asp-route-trangThai="1" class="btn btn-sm @(ViewBag.CurrentTrangThai == 1 ? "btn-navy" : "btn-outline-navy")">Mới tiếp nhận</a>
    <a asp-action="Index" asp-route-trangThai="2" class="btn btn-sm @(ViewBag.CurrentTrangThai == 2 ? "btn-navy" : "btn-outline-navy")">Đang xử lý</a>
    <a asp-action="Index" asp-route-trangThai="3" class="btn btn-sm @(ViewBag.CurrentTrangThai == 3 ? "btn-navy" : "btn-outline-navy")">Đã sửa xong</a>
    <a asp-action="Index" asp-route-trangThai="4" class="btn btn-sm @(ViewBag.CurrentTrangThai == 4 ? "btn-navy" : "btn-outline-navy")">Hỏng thanh lý</a>
    <a asp-action="Index" asp-route-trangThai="5" class="btn btn-sm @(ViewBag.CurrentTrangThai == 5 ? "btn-navy" : "btn-outline-navy")">Đã nghiệm thu</a>
    <a asp-action="Index" asp-route-filter="overdue_sla" class="btn btn-sm @(ViewBag.CurrentFilter == "overdue_sla" ? "btn-navy" : "btn-outline-navy")">
        <i class="fas fa-exclamation-triangle me-1"></i> Trễ hạn SLA
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="admin-table text-center mb-0">
                <thead>
                    <tr>
                        <th>Mã Phiếu</th>
                        <th>Hợp Đồng</th>
                        <th>Thiết Bị</th>
                        <th>Ngày Báo Lỗi</th>
                        <th>Cam Kết SLA</th>
                        <th>Kỹ Thuật Viên</th>
                        <th>Trạng Thái</th>
                        <th>Chi Phí / Bồi Thường</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any()) {
                        <tr><td colspan="9" class="py-4 text-muted">Không tìm thấy phiếu bảo trì nào.</td></tr>
                    }
                    @foreach (var item in Model) {
                        bool isOverdue = item.TrangThai < 3 && item.HanHoanThanh.HasValue && item.HanHoanThanh.Value < DateTime.Now;
                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td class="fw-bold">#@item.MaPhieu</td>
                            <td>
                                @if (item.MaHopDong.HasValue) {
                                    <a href="/Admin/HopDong/Details/@item.MaHopDong" class="fw-bold text-decoration-none">#@item.MaHopDong</a>
                                } else {
                                    <span class="status-pill"><span class="status-dot dot-neutral"></span> Bảo dưỡng kho</span>
                                }
                            </td>
                            <td class="text-start">
                                <div class="fw-bold">@item.ThietBi?.SanPham?.TenSanPham</div>
                                <small class="text-muted">Serial: @item.ThietBi?.SoSerial</small>
                            </td>
                            <td>@item.NgayBaoLoi.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.HanHoanThanh.HasValue) {
                                    <div>@item.HanHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (isOverdue) {
                                        <span class="status-pill"><span class="status-dot dot-danger"></span> Quá hạn SLA</span>
                                    } else {
                                        <span class="status-pill"><span class="status-dot dot-success"></span> Còn hạn</span>
                                    }
                                } else {
                                    <span class="text-muted small">--</span>
                                }
                            </td>
                            <td>@(item.KyThuatVien?.HoTen ?? "Chưa phân công")</td>
                            <td>
                                @if (item.TrangThai == 1) { 
                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Mới tiếp nhận</span> 
                                }
                                else if (item.TrangThai == 2) { 
                                    <span class="status-pill"><span class="status-dot dot-navy"></span> Đang sửa</span> 
                                }
                                else if (item.TrangThai == 3) { 
                                    <span class="status-pill"><span class="status-dot dot-navy"></span> Đã sửa xong</span> 
                                }
                                else if (item.TrangThai == 4) { 
                                    <span class="status-pill"><span class="status-dot dot-danger"></span> Hỏng thanh lý</span> 
                                }
                                else if (item.TrangThai == 5) { 
                                    <span class="status-pill"><span class="status-dot dot-success"></span> Đã nghiệm thu</span> 
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="small">Sửa: <strong>@((item.ChiPhiSuaChua ?? 0).ToString("N0")) đ</strong></div>
                                @if (item.PhiDenBu > 0) {
                                    <div class="small text-danger">Đền bù: <strong>@item.PhiDenBu.ToString("N0") đ</strong></div>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaPhieu" class="btn btn-sm btn-outline-navy">
                                    <i class="fas fa-eye me-1"></i> Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
