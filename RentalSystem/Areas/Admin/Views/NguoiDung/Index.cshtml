@model IEnumerable<RentalSystem.Models.NguoiDung>
@{ ViewData["Title"] = "Quản lý Người Dùng"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold"><i class="fas fa-users text-brand"></i> Quản lý Người Dùng / Phân Quyền</h2>
    <a asp-action="Create" class="btn btn-brand fw-bold"><i class="fas fa-plus"></i> Thêm Người Dùng</a>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow border-0">
    <div class="card-body">
        <table class="table table-hover align-middle text-center">
            <thead class="">
                <tr>
                    <th>Họ Tên</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Vai Trò</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.HoTen</td>
                        <td>@item.Email</td>
                        <td>@item.SoDienThoai</td>
                        <td><span class="badge bg-info text-dark">@item.VaiTro?.TenVaiTro</span></td>
                        <td>
                            @(item.TrangThai ? Html.Raw("<span class='badge bg-success'>Hoạt động</span>") : Html.Raw("<span class='badge bg-danger'>Khóa</span>"))
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaNguoiDung" class="btn btn-sm btn-brand"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
