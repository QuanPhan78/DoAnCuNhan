@model IEnumerable<RentalSystem.Models.NguoiDung>
@{ ViewData["Title"] = "Quản lý Người Dùng"; }

<div class="page-header">
    <h3 class="page-title"><i class="fas fa-users"></i> Quản lý Người Dùng / Phân Quyền</h3>
    <a asp-action="Create" class="btn btn-navy"><i class="fas fa-plus me-1"></i> Thêm Người Dùng</a>
</div>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="admin-card">
    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="admin-table text-center">
            <thead class="">
                <tr>
                    <th>Họ Tên</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Vai Trò</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.HoTen</td>
                        <td>@item.Email</td>
                        <td>@item.SoDienThoai</td>
                        <td><span class="badge-soft-navy">@item.VaiTro?.TenVaiTro</span></td>
                        <td>
                            @(item.TrangThai ? Html.Raw("<span class='status-pill'><span class='status-dot dot-success'></span> Hoạt động</span>") : Html.Raw("<span class='status-pill'><span class='status-dot dot-neutral'></span> Đã khóa</span>"))
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaNguoiDung" class="action-btn" title="Sửa"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    </div>
</div>
