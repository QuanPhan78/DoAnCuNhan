@model RentalSystem.Models.NguoiDung
@{ ViewData["Title"] = "Thêm Người Dùng"; }
<h2>Thêm Người Dùng</h2>
<hr />
<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Họ Tên</label>
            <input asp-for="HoTen" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Vai Trò</label>
            <select asp-for="MaVaiTro" class="form-select" asp-items="ViewBag.MaVaiTro"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Email</label>
            <input asp-for="Email" type="email" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Số Điện Thoại</label>
            <input asp-for="SoDienThoai" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Mật Khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">CCCD</label>
            <input asp-for="CCCD" class="form-control" />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label fw-bold">Địa Chỉ</label>
            <input asp-for="DiaChi" class="form-control" />
        </div>
    </div>
    <button type="submit" class="btn btn-brand">Lưu</button>
    <a asp-action="Index" class="btn btn-light">Quay lại</a>
</form>
