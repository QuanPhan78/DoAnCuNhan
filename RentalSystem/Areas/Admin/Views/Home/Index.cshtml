@{
    ViewData["Title"] = "Dashboard Thống Kê";
    var recentOrders = ViewBag.RecentOrders as IEnumerable<RentalSystem.Models.HopDong>;
}

<div class="page-header">
    <h3 class="page-title"><i class="fas fa-chart-pie"></i> Tổng Quan Kinh Doanh</h3>
</div>

<!-- 4 Thẻ Thống Kê (Stat Cards) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-wallet"></i></div>
            <div>
                <div class="stat-label">Doanh thu (Đã thu)</div>
                <div class="stat-value">@((ViewBag.TotalRevenue ?? 0).ToString("N0")) đ</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-laptop"></i></div>
            <div>
                <div class="stat-label">Thiết bị đang cho thuê</div>
                <div class="stat-value">@ViewBag.RentedDevices máy</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-file-contract"></i></div>
            <div>
                <div class="stat-label">Tổng số hợp đồng</div>
                <div class="stat-value">@ViewBag.TotalContracts đơn</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div>
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">@ViewBag.TotalCustomers người</div>
            </div>
        </div>
    </div>
</div>

@{ var overdueInstallments = ViewBag.OverdueInstallments as IEnumerable<RentalSystem.Models.KyHanThanhToan>; }
@if (overdueInstallments != null && overdueInstallments.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="admin-card" >
                <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 fw-bold text-danger"><i class="fas fa-exclamation-triangle me-2"></i> Cảnh Báo: Các Khoản Nợ Quá Hạn Cần Thu Hồi</h6>
                </div>
                <div class="admin-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class=" text-danger">
                                <tr>
                                    <th>Mã HĐ</th>
                                    <th>Khách Hàng</th>
                                    <th>Số Điện Thoại</th>
                                    <th>Kỳ Số</th>
                                    <th>Ngày Đến Hạn</th>
                                    <th>Số Tiền Trễ</th>
                                    <th>Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in overdueInstallments)
                                {
                                    var soTienTre = k.SoTienPhai - k.SoTienDaTra;
                                    <tr>
                                        <td class="fw-bold">#@k.MaHopDong</td>
                                        <td>@k.HopDong?.KhachHang?.HoTen</td>
                                        <td class="fw-bold">@k.HopDong?.KhachHang?.SoDienThoai</td>
                                        <td><span class="badge-soft-neutral font-monospace">Kỳ @k.SoKyHan</span></td>
                                        <td class="text-danger fw-bold">@k.NgayDenHan.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="text-brand fw-bold">@soTienTre.ToString("N0") đ</span>
                                            @if (k.SoTienDaTra > 0)
                                            {
                                                <small class="text-muted d-block">(Đã trả: @k.SoTienDaTra.ToString("N0") đ)</small>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="HopDong" asp-action="Details" asp-route-id="@k.MaHopDong" class="btn btn-sm btn-danger shadow-sm"><i class="fas fa-eye me-1"></i> Xử lý ngay</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Biểu đồ Doanh Thu -->
    <div class="col-xl-8 col-lg-7 mb-4">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h6 class="m-0 fw-bold text-brand">Biểu Đồ Doanh Thu (6 Tháng)</h6>
            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 300px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Đơn hàng gần đây -->
    <div class="col-xl-4 col-lg-5 mb-4">
        <div class="admin-card h-100">
            <div class="admin-card-header">
                <h6 class="m-0 fw-bold text-brand">Đơn Hàng Mới Nhất</h6>
            </div>
            <div class="admin-card-body p-0">
                <ul class="list-group list-group-flush">
                    @if(recentOrders == null || !recentOrders.Any()) {
                        <li class="list-group-item text-center text-muted py-4">Chưa có đơn hàng nào</li>
                    }
                    else {
                        foreach(var order in recentOrders) {
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <h6 class="mb-0 fw-bold">#@order.MaHopDong - @(order.KhachHang?.HoTen ?? "Khách")</h6>
                                    <small class="text-muted">@order.NgayBatDau.ToString("dd/MM/yyyy")</small>
                                </div>
                                @if (order.TrangThai == 0) { <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt</span> }
                                else if (order.TrangThai == 1) { <span class="status-pill"><span class="status-dot dot-navy"></span> Đang thuê</span> }
                                else if (order.TrangThai == 4) { <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ quyết toán</span> }
                                else if (order.TrangThai == 2) { <span class="status-pill"><span class="status-dot dot-success"></span> Hoàn tất</span> }
                                else if (order.TrangThai == 3) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span> }
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="card-footer bg-light text-center border-top-0">
                <a asp-controller="HopDong" asp-action="Index" class="text-brand text-decoration-none fw-bold small">Xem tất cả hợp đồng <i class="fas fa-chevron-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById("revenueChart");
        if(ctx) {
            var labels = @Html.Raw(ViewBag.ChartLabels);
            var data = @Html.Raw(ViewBag.ChartData);

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Doanh thu (VNĐ)",
                        lineTension: 0.3,
                        backgroundColor: "rgba(78, 115, 223, 0.05)",
                        borderColor: "rgba(78, 115, 223, 1)",
                        pointRadius: 3,
                        pointBackgroundColor: "rgba(78, 115, 223, 1)",
                        pointBorderColor: "rgba(78, 115, 223, 1)",
                        pointHoverRadius: 3,
                        pointHoverBackgroundColor: "rgba(78, 115, 223, 1)",
                        pointHoverBorderColor: "rgba(78, 115, 223, 1)",
                        pointHitRadius: 10,
                        pointBorderWidth: 2,
                        data: data,
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value, index, values) {
                                    return new Intl.NumberFormat('vi-VN').format(value) + ' đ';
                                }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return new Intl.NumberFormat('vi-VN').format(context.raw) + ' VNĐ';
                                }
                            }
                        }
                    }
                }
            });
        }
    });
</script>
