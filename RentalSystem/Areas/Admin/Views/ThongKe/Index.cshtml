@{ ViewData["Title"] = "Thống Kê Báo Cáo"; }

<h2 class="fw-bold mb-4"><i class="fas fa-chart-line text-brand"></i> Thống Kê Báo Cáo</h2>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Tổng Doanh Thu</h5>
                <h3 class="fw-bold">@(((decimal)ViewBag.TongDoanhThu).ToString("N0")) đ</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Thiết bị đang cho thuê</h5>
                <h3 class="fw-bold">@ViewBag.DangChoThue Máy</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Thiết bị sẵn sàng</h5>
                <h3 class="fw-bold">@ViewBag.SanSang Máy</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Sự cố chưa xử lý</h5>
                <h3 class="fw-bold">@ViewBag.SuCoChuaXuLy Phiếu</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header text-dark fw-bold fw-bold">Sao lưu & Phục hồi dữ liệu</div>
            <div class="card-body d-flex gap-3">
                <form asp-action="BackupDatabase" method="post">
                    <button class="btn btn-outline-dark fw-bold"><i class="fas fa-database"></i> Backup DB</button>
                </form>
                <form asp-action="RestoreDatabase" method="post">
                    <button class="btn btn-outline-danger fw-bold"><i class="fas fa-undo"></i> Restore DB</button>
                </form>
            </div>
        </div>
    </div>
</div>
