@{ ViewData["Title"] = "Thống Kê Báo Cáo"; }

<h2 class="fw-bold mb-4"><i class="fas fa-chart-line text-brand"></i> Thống Kê Báo Cáo</h2>

@if (TempData["Success"] != null) {
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title text-success fw-bold">Tổng Doanh Thu (Dòng tiền)</h5>
                <h3 class="fw-bold text-success">@(((decimal)ViewBag.TongDoanhThu).ToString("N0")) đ</h3>
                <small class="text-muted d-block">Thực thu: @(((decimal)ViewBag.TongThu).ToString("N0")) đ</small>
                <small class="text-muted d-block">Chi hoàn: @(((decimal)ViewBag.TongChi).ToString("N0")) đ</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Tiền cọc giữ chỗ</h5>
                <h3 class="fw-bold text-primary">@(((decimal)ViewBag.TongCoc).ToString("N0")) đ</h3>
                <small class="text-muted">Các đơn chờ duyệt / đang thuê</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Thiết bị đang thuê / Sẵn sàng</h5>
                <h3 class="fw-bold">@ViewBag.DangChoThue / @ViewBag.SanSang Máy</h3>
                <small class="text-muted">Kho: @ViewBag.DangSuaChua đang sửa</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-left-brand shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Sự cố kỹ thuật</h5>
                <h3 class="fw-bold text-danger">@ViewBag.SuCoChuaXuLy / @ViewBag.TongSuCo Phiếu</h3>
                <small class="text-muted">Phiếu bảo trì chưa xử lý</small>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header text-dark fw-bold fw-bold">Sao lưu & Phục hồi dữ liệu</div>
            <div class="card-body d-flex gap-3">
                <form asp-action="BackupDatabase" method="post">
                    <button class="btn btn-outline-dark fw-bold"><i class="fas fa-database"></i> Backup DB</button>
                </form>
                <form asp-action="RestoreDatabase" method="post">
                    <button class="btn btn-outline-danger fw-bold"><i class="fas fa-undo"></i> Restore DB</button>
                </form>
            </div>
        </div>
    </div>
</div>
