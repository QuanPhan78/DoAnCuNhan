<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/classic-navy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-minimalist.css" asp-append-version="true" />
</head>
<body class="d-flex">

    <!-- Menu điều hướng Sidebar Deep Navy -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-laptop-code me-2"></i> <span class="brand-text">ABC RENTAL</span>
        </div>
@{
    var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    string roleName = User.IsInRole("Admin") ? "Quản trị viên" :
                      User.IsInRole("KinhDoanh") ? "Kinh Doanh" :
                      User.IsInRole("KyThuat") ? "Kỹ Thuật" :
                      User.IsInRole("KhachHang") ? "Khách Hàng" :
                      (!string.IsNullOrWhiteSpace(roleClaim) ? roleClaim : "Quản trị viên");
}
        <div class="sidebar-menu">
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <a href="/Admin/Home"><i class="fas fa-tachometer-alt"></i> <span class="nav-text">Dashboard</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh") || User.IsInRole("KyThuat"))
            {
                <a href="/Admin/SanPham"><i class="fas fa-boxes"></i> <span class="nav-text">Dòng sản phẩm</span></a>
                <a href="/Admin/ThietBi"><i class="fas fa-barcode"></i> <span class="nav-text">Serial Máy</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <a href="/Admin/HopDong"><i class="fas fa-file-contract"></i> <span class="nav-text">Đơn thuê máy</span></a>
                <a href="/Admin/HopDong/YeuCauGiaHan"><i class="fas fa-calendar-plus"></i> <span class="nav-text">Yêu cầu gia hạn</span></a>
                <a href="/Admin/KhuyenMai"><i class="fas fa-tags"></i> <span class="nav-text">Mã khuyến mãi</span></a>
                <a href="/Admin/CongNo"><i class="fas fa-hand-holding-usd"></i> <span class="nav-text">Công nợ</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KyThuat") || User.IsInRole("KinhDoanh"))
            {
                <a href="/Admin/BaoTri"><i class="fas fa-tools"></i> <span class="nav-text">Bảo trì & Sự cố</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <a href="/Admin/PhanCong"><i class="fas fa-tasks"></i> <span class="nav-text">Phân công việc</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh") || User.IsInRole("KyThuat"))
            {
                <a href="/Admin/PhanCong/MyTasks"><i class="fas fa-clipboard-check"></i> <span class="nav-text">Việc của tôi</span></a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin/NguoiDung"><i class="fas fa-users"></i> <span class="nav-text">Phân quyền user</span></a>
                <a href="/Admin/Database"><i class="fas fa-database"></i> <span class="nav-text">Sao lưu CSDL</span></a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <a href="/Admin/ThongKe"><i class="fas fa-chart-line"></i> <span class="nav-text">Thống kê báo cáo</span></a>
            }
        </div>
        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout"><i class="fas fa-sign-out-alt"></i> <span class="nav-text">Đăng xuất</span></button>
        </form>
    </div>

    <!-- Nội dung chính -->
    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-light border" id="toggleSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <div class="d-flex align-items-center gap-3">
                <a href="/Account/ThongBao" class="action-btn" title="Thông báo hệ thống">
                    <i class="fas fa-bell"></i>
                </a>
                <span class="fw-bold text-dark">Chào, @(User.Identity?.Name ?? "Quản trị viên") (@roleName)</span>
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        var toggleBtn = document.getElementById('toggleSidebar');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                var sb = document.getElementById('sidebar');
                if (sb) sb.classList.toggle('collapsed');
            });
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
