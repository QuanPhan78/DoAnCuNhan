<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin-minimalist.css" asp-append-version="true" />
</head>
<body class="d-flex">

    <!-- Menu điều hướng -->
    <div class="sidebar" id="sidebar">
        <div class="p-3 text-center fw-bold fs-4 border-bottom border-secondary">
            <i class="fas fa-tools text-brand me-2"></i> <span class="brand-text">ABC RENTAL</span>
        </div>
        <div class="sidebar-menu">
            <a href="/Admin/Home"><i class="fas fa-tachometer-alt me-2"></i> <span class="nav-text">Dashboard</span></a>
            <a href="/Admin/SanPham"><i class="fas fa-boxes me-2"></i> <span class="nav-text">Dòng sản phẩm</span></a>
            <a href="/Admin/ThietBi"><i class="fas fa-barcode me-2"></i> <span class="nav-text">Serial Máy</span></a>
            <a href="/Admin/HopDong"><i class="fas fa-file-contract me-2"></i> <span class="nav-text">Đơn thuê máy</span></a>
            <a href="/Admin/HopDong/YeuCauGiaHan"><i class="fas fa-calendar-plus me-2 text-info"></i> <span class="nav-text">Yêu cầu gia hạn</span></a>
            <a href="/Admin/KhuyenMai"><i class="fas fa-tags me-2 text-success"></i> <span class="nav-text">Mã khuyến mãi</span></a>
            <a href="/Admin/CongNo"><i class="fas fa-hand-holding-usd me-2 text-warning"></i> <span class="nav-text fw-bold text-warning">Công nợ</span></a>
            <a href="/Admin/BaoTri"><i class="fas fa-tools me-2"></i> <span class="nav-text">Bảo trì & Sự cố</span></a>
            <a href="/Admin/PhanCong"><i class="fas fa-tasks me-2 text-primary"></i> <span class="nav-text">Phân công việc</span></a>
            <a href="/Admin/PhanCong/MyTasks"><i class="fas fa-clipboard-check me-2 text-warning"></i> <span class="nav-text">Việc của tôi</span></a>
            <a href="/Admin/NguoiDung"><i class="fas fa-users me-2"></i> <span class="nav-text">Phân quyền user</span></a>
            <a href="/Admin/Database"><i class="fas fa-database me-2 text-secondary"></i> <span class="nav-text">Sao lưu CSDL</span></a>
            <a href="/Admin/ThongKe"><i class="fas fa-chart-line me-2"></i> <span class="nav-text">Thống kê báo cáo</span></a>
        </div>
        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="mt-auto border-top">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-danger text-decoration-none w-100 text-start" style="padding: 12px 20px;"><i class="fas fa-sign-out-alt me-2"></i> <span class="nav-text">Đăng xuất</span></button>
        </form>
    </div>

    <!-- Nội dung chính -->
    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn btn-light border" id="toggleSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <div>
                <span class="fw-bold me-3">Chào, Quản trị viên</span>
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        document.getElementById('toggleSidebar').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>