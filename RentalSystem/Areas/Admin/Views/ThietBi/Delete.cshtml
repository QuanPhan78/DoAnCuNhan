@model RentalSystem.Models.ThietBi
@{
    ViewData["Title"] = "Xóa Thiết Bị";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <span class="fw-bold"><i class="fas fa-trash me-2 text-danger"></i> Xác Nhận Xóa Thiết Bị Vật Lý</span>
                </div>
                <div class="admin-card-body p-4">
                    <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa thiết bị (Serial) này khỏi hệ thống?</p>
                    <table class="table table-bordered mb-4">
                        <tr>
                            <th class="w-25 bg-light">Mã thiết bị</th>
                            <td>#@Model.MaThietBi</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Số Serial</th>
                            <td><code>@Model.SoSerial</code></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Dòng sản phẩm</th>
                            <td>@Model.SanPham?.TenSanPham</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tình trạng máy</th>
                            <td>@Model.TinhTrangMay</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Trạng thái</th>
                            <td>
                                @if (Model.TrangThai == 0)
                                {
                                    <span class="status-pill"><span class="status-dot dot-success"></span> Sẵn sàng</span>
                                }
                                else if (Model.TrangThai == 1)
                                {
                                    <span class="status-pill"><span class="status-dot dot-navy"></span> Đang cho thuê</span>
                                }
                                else if (Model.TrangThai == 2)
                                {
                                    <span class="status-pill"><span class="status-dot dot-danger"></span> Bảo trì / Hỏng</span>
                                }
                                else if (Model.TrangThai == 3)
                                {
                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Khóa giữ chỗ</span>
                                }
                                else
                                {
                                    <span class="status-pill"><span class="status-dot dot-neutral"></span> Khác (@Model.TrangThai)</span>
                                }
                            </td>
                        </tr>
                    </table>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.MaThietBi" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger fw-bold"><i class="fas fa-trash me-1"></i> Xác Nhận Xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
