@model RentalSystem.Models.ThietBi
@{
    ViewData["Title"] = "Nhập Kho Thiết Bị";
}
<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-light shadow-sm me-3"><i class="fas fa-arrow-left"></i></a>
    <h3 class="fw-bold text-dark mb-0"><i class="fas fa-plus-circle me-2 text-info"></i> Khai báo Serial Mới</h3>
</div>
<div class="row">
    <div class="col-lg-6">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
        }
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thuộc Dòng Sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="MaSanPham" class="form-select" asp-items="ViewBag.MaSanPham" required>
                            <option value="">-- Chọn sản phẩm cha --</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Mã Serial / Service Tag <span class="text-danger">*</span></label>
                        <input asp-for="SoSerial" class="form-control font-monospace" required placeholder="Ví dụ: SN-DELL-12345" />
                        <span asp-validation-for="SoSerial" class="text-danger small"></span>
                        <div class="form-text">Số Serial phải là duy nhất, không trùng lặp trong hệ thống.</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Tình trạng ban đầu</label>
                        <input type="text" class="form-control" value="Sẵn sàng cho thuê (Mặc định)" disabled />
                        <input type="hidden" asp-for="TrangThai" value="0" />
                    </div>
                    <button type="submit" class="btn btn-brand fw-bold text-white px-4 py-2 w-100 shadow-sm"><i class="fas fa-save me-1"></i> Lưu Vào Kho</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
