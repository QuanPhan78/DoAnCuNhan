@model IEnumerable<RentalSystem.Models.KhuyenMai>
@{
    ViewData["Title"] = "Quản lý Mã Khuyến Mãi";
    var usageCounts = ViewBag.UsageCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var now = DateTime.Now;

    int totalPromos = Model?.Count() ?? 0;
    int activePromos = Model?.Count(k => k.KichHoat && k.NgayBatDau <= now && k.NgayKetThuc >= now && k.SoLuong > 0) ?? 0;
    int expiredPromos = Model?.Count(k => now > k.NgayKetThuc || !k.KichHoat || k.SoLuong <= 0) ?? 0;
    int totalUsed = usageCounts.Values.Sum();
}

<div class="page-header">
    <h3 class="page-title">
        <i class="fas fa-tags"></i> Quản lý Mã Khuyến Mãi
    </h3>
    <a asp-action="Create" class="btn btn-navy">
        <i class="fas fa-plus"></i> Thêm mã khuyến mãi
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Thống kê tổng quan phong cách Classic Navy & White -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-ticket-alt"></i></div>
            <div>
                <div class="stat-label">Tổng số mã</div>
                <div class="stat-value">@totalPromos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="stat-label">Đang hoạt động</div>
                <div class="stat-value">@activePromos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <div class="stat-label">Hết hạn / Khóa</div>
                <div class="stat-value">@expiredPromos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
            <div>
                <div class="stat-label">Tổng lượt dùng</div>
                <div class="stat-value">@totalUsed</div>
            </div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <div><i class="fas fa-list me-2 text-secondary"></i>Danh sách mã voucher khuyến mãi</div>
        <span class="badge-soft-neutral">@totalPromos mã</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table text-center">
            <thead>
                <tr>
                    <th style="width: 6%">ID</th>
                    <th style="width: 18%" class="text-start">Mã Voucher</th>
                    <th style="width: 12%">Mức giảm</th>
                    <th style="width: 20%">Hiệu lực áp dụng</th>
                    <th style="width: 14%">Lượt sử dụng</th>
                    <th style="width: 14%">Trạng thái</th>
                    <th style="width: 16%" class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        int used = usageCounts.ContainsKey(item.MaKM) ? usageCounts[item.MaKM] : 0;
                        bool isExpired = now > item.NgayKetThuc;
                        bool isUpcoming = now < item.NgayBatDau;
                        bool isOutOfStock = item.SoLuong <= 0;

                        <tr>
                            <td class="fw-bold text-muted">@item.MaKM</td>
                            <td class="text-start">
                                <span class="badge-soft-navy font-monospace fw-bold">
                                    <i class="fas fa-tag me-1"></i>@item.Code
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                {
                                    <div class="small text-muted text-truncate mt-1" style="max-width: 240px;" title="@item.MoTa">
                                        @item.MoTa
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge-soft-navy fw-bold">
                                    -@item.PhanTramGiam%
                                </span>
                            </td>
                            <td class="small">
                                <div><i class="far fa-calendar-alt text-muted me-1"></i> Từ: <strong>@item.NgayBatDau.ToString("dd/MM/yyyy")</strong></div>
                                <div class="@(isExpired ? "text-danger fw-bold" : "text-muted")"><i class="far fa-calendar-times me-1"></i> Đến: <strong>@item.NgayKetThuc.ToString("dd/MM/yyyy")</strong></div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.SoLuong lượt còn</div>
                                <div class="text-muted small">Đã dùng: @used</div>
                            </td>
                            <td>
                                @if (!item.KichHoat)
                                {
                                    <span class="status-pill"><span class="status-dot dot-neutral"></span> Tạm khóa</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="status-pill"><span class="status-dot dot-danger"></span> Hết hạn</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="status-pill"><span class="status-dot dot-navy"></span> Chưa bắt đầu</span>
                                }
                                else if (isOutOfStock)
                                {
                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Hết lượt</span>
                                }
                                else
                                {
                                    <span class="status-pill"><span class="status-dot dot-success"></span> Đang áp dụng</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <!-- Nút đổi trạng thái đơn sắc -->
                                    <form asp-action="ToggleStatus" asp-route-id="@item.MaKM" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn" title="@(item.KichHoat ? "Tạm ngưng mã" : "Kích hoạt lại mã")">
                                            <i class="fas @(item.KichHoat ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>

                                    <!-- Nút sửa đơn sắc -->
                                    <a asp-action="Edit" asp-route-id="@item.MaKM" class="action-btn" title="Chỉnh sửa thông tin">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Nút xóa đơn sắc -->
                                    <form asp-action="Delete" asp-route-id="@item.MaKM" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã @item.Code? Nếu đã có hợp đồng dùng mã này, hệ thống sẽ tự động chuyển sang tạm dừng.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn action-btn-danger" title="Xóa mã">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-5 text-muted">
                            <i class="fas fa-ticket-alt fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            Chưa có mã khuyến mãi nào được tạo.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
