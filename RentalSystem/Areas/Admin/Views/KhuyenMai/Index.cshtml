@model IEnumerable<RentalSystem.Models.KhuyenMai>
@{
    ViewData["Title"] = "Quản lý Mã Khuyến Mãi";
    var usageCounts = ViewBag.UsageCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var now = DateTime.Now;

    int totalPromos = Model?.Count() ?? 0;
    int activePromos = Model?.Count(k => k.KichHoat && k.NgayBatDau <= now && k.NgayKetThuc >= now && k.SoLuong > 0) ?? 0;
    int expiredPromos = Model?.Count(k => now > k.NgayKetThuc || !k.KichHoat || k.SoLuong <= 0) ?? 0;
    int totalUsed = usageCounts.Values.Sum();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="fas fa-tags me-2 text-success"></i> Quản lý Mã Khuyến Mãi</h2>
        <span class="text-muted small">Cấu hình các voucher giảm giá, tỷ lệ chiết khấu cho khách hàng khi tạo đơn thuê máy.</span>
    </div>
    <a asp-action="Create" class="btn btn-brand fw-bold shadow-sm px-3 py-2">
        <i class="fas fa-plus me-1"></i> Thêm mã khuyến mãi
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary fs-4">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng số mã</div>
                    <div class="fs-4 fw-bold text-dark">@totalPromos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success fs-4">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <div class="text-muted small">Đang hoạt động</div>
                    <div class="fs-4 fw-bold text-success">@activePromos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning fs-4">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div>
                    <div class="text-muted small">Hết hạn / Khóa</div>
                    <div class="fs-4 fw-bold text-warning">@expiredPromos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-3 d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info fs-4">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng lượt đã dùng</div>
                    <div class="fs-4 fw-bold text-info">@totalUsed</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-muted"><i class="fas fa-list me-1"></i> Danh sách mã voucher khuyến mãi</h6>
        <span class="badge bg-light text-dark border">@totalPromos mã</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%">ID</th>
                        <th style="width: 15%" class="text-start">Mã Voucher</th>
                        <th style="width: 12%">Mức giảm</th>
                        <th style="width: 18%">Hiệu lực áp dụng</th>
                        <th style="width: 12%">Lượt sử dụng</th>
                        <th style="width: 14%">Trạng thái</th>
                        <th style="width: 24%" class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            int used = usageCounts.ContainsKey(item.MaKM) ? usageCounts[item.MaKM] : 0;
                            bool isExpired = now > item.NgayKetThuc;
                            bool isUpcoming = now < item.NgayBatDau;
                            bool isOutOfStock = item.SoLuong <= 0;
                            bool isCurrentlyActive = item.KichHoat && !isExpired && !isUpcoming && !isOutOfStock;

                            <tr>
                                <td class="fw-bold text-muted">@item.MaKM</td>
                                <td class="text-start">
                                    <span class="badge bg-light text-dark border border-2 px-2 py-1 fs-6 font-monospace fw-bold">
                                        <i class="fas fa-tag text-success me-1"></i>@item.Code
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                    {
                                        <div class="small text-muted text-truncate mt-1" style="max-width: 250px;" title="@item.MoTa">
                                            @item.MoTa
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold fs-6 px-2 py-1">
                                        -@item.PhanTramGiam%
                                    </span>
                                </td>
                                <td class="small">
                                    <div><i class="far fa-calendar-alt text-muted me-1"></i> Từ: <strong>@item.NgayBatDau.ToString("dd/MM/yyyy")</strong></div>
                                    <div class="@(isExpired ? "text-danger fw-bold" : "text-muted")"><i class="far fa-calendar-times me-1"></i> Đến: <strong>@item.NgayKetThuc.ToString("dd/MM/yyyy")</strong></div>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.SoLuong lượt còn</div>
                                    <div class="text-muted small">Đã dùng: @used</div>
                                </td>
                                <td>
                                    @if (!item.KichHoat)
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i> Tạm khóa</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-hourglass-end me-1"></i> Hết hạn</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="badge bg-info text-dark"><i class="fas fa-clock me-1"></i> Chưa bắt đầu</span>
                                    }
                                    else if (isOutOfStock)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-battery-empty me-1"></i> Hết lượt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Đang áp dụng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <!-- Nút đổi trạng thái -->
                                        <form asp-action="ToggleStatus" asp-route-id="@item.MaKM" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.KichHoat ? "btn-outline-warning" : "btn-outline-success")" 
                                                    title="@(item.KichHoat ? "Tạm ngưng mã" : "Kích hoạt lại mã")">
                                                <i class="fas @(item.KichHoat ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        </form>

                                        <!-- Nút sửa -->
                                        <a asp-action="Edit" asp-route-id="@item.MaKM" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa thông tin">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- Nút xóa -->
                                        <form asp-action="Delete" asp-route-id="@item.MaKM" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã @item.Code? Nếu đã có hợp đồng dùng mã này, hệ thống sẽ tự động chuyển sang tạm dừng.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa mã">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-5 text-muted">
                                <i class="fas fa-ticket-alt fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                Chưa có mã khuyến mãi nào được tạo.<br />
                                Nhấp vào nút <strong>"Thêm mã khuyến mãi"</strong> ở trên để bắt đầu!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
