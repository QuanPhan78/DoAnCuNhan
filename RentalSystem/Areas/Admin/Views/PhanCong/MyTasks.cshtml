@model IEnumerable<RentalSystem.Models.PhanCongCongViec>
@{
    ViewData["Title"] = "Công Việc Của Tôi";
    int? currentTrangThai = ViewBag.CurrentTrangThai as int?;

    int totalTasks = ViewBag.TotalTasks ?? 0;
    int newTasks = ViewBag.NewTasks ?? 0;
    int inProgressTasks = ViewBag.InProgressTasks ?? 0;
    int completedTasks = ViewBag.CompletedTasks ?? 0;
}

<div class="page-header">
    <h3 class="page-title"><i class="fas fa-clipboard-check"></i> Công Việc Của Tôi</h3>
    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
    {
        <a asp-action="Index" class="btn btn-outline-navy">
            <i class="fas fa-tasks me-1"></i> Toàn bộ phân công (Admin)
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Thống kê tổng quan -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-action="MyTasks" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == null ? "border-primary" : "")">
                <div class="stat-icon"><i class="fas fa-list-check"></i></div>
                <div>
                    <div class="stat-label">Tổng công việc</div>
                    <div class="stat-value">@totalTasks</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-action="MyTasks" asp-route-trangThai="0" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == 0 ? "border-primary" : "")">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div>
                    <div class="stat-label">Chưa thực hiện (Mới)</div>
                    <div class="stat-value">@newTasks</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-action="MyTasks" asp-route-trangThai="1" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == 1 ? "border-primary" : "")">
                <div class="stat-icon"><i class="fas fa-spinner"></i></div>
                <div>
                    <div class="stat-label">Đang tiến hành</div>
                    <div class="stat-value">@inProgressTasks</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-action="MyTasks" asp-route-trangThai="2" class="text-decoration-none">
            <div class="stat-card @(currentTrangThai == 2 ? "border-primary" : "")">
                <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                <div>
                    <div class="stat-label">Đã hoàn thành</div>
                    <div class="stat-value">@completedTasks</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Bộ lọc theo trạng thái -->
<div class="d-flex gap-2 mb-3 border-bottom pb-2 flex-wrap">
    <a asp-action="MyTasks" class="btn btn-sm @(currentTrangThai == null ? "btn-navy fw-bold" : "btn-outline-navy")">
        Tất cả (@totalTasks)
    </a>
    <a asp-action="MyTasks" asp-route-trangThai="0" class="btn btn-sm @(currentTrangThai == 0 ? "btn-navy fw-bold" : "btn-outline-navy")">
        <i class="fas fa-clock me-1"></i> Việc mới (@newTasks)
    </a>
    <a asp-action="MyTasks" asp-route-trangThai="1" class="btn btn-sm @(currentTrangThai == 1 ? "btn-navy fw-bold" : "btn-outline-navy")">
        <i class="fas fa-spinner me-1"></i> Đang thực hiện (@inProgressTasks)
    </a>
    <a asp-action="MyTasks" asp-route-trangThai="2" class="btn btn-sm @(currentTrangThai == 2 ? "btn-navy fw-bold" : "btn-outline-navy")">
        <i class="fas fa-check-double me-1"></i> Đã hoàn thành (@completedTasks)
    </a>
</div>

<!-- Danh sách công việc -->
@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var isOverdue = item.TrangThai < 2 && item.HanHoanThanh.HasValue && item.HanHoanThanh.Value < DateTime.Now;
            var borderClass = item.TrangThai switch
            {
                0 => "border-primary",
                1 => "border-warning",
                2 => "border-success",
                _ => "border-secondary"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-3 border-top border-4 @borderClass">
                    <div class="card-body p-4 d-flex flex-column">
                        <!-- Tiêu đề và trạng thái -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge-soft-neutral font-monospace">#@item.MaPhanCong</span>
                            @switch (item.TrangThai)
                            {
                                case 0:
                                    <span class="status-pill"><span class="status-dot dot-navy"></span> Mới</span>
                                    break;
                                case 1:
                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Đang thực hiện</span>
                                    break;
                                case 2:
                                    <span class="status-pill"><span class="status-dot dot-success"></span> Hoàn thành</span>
                                    break;
                                case 3:
                                    <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span>
                                    break;
                            }
                        </div>

                        <!-- Nội dung công việc -->
                        <h5 class="fw-bold text-dark mb-2">@item.TieuDe</h5>
                        <p class="text-muted small mb-3 flex-grow-1" style="white-space: pre-wrap;">@item.NoiDung</p>

                        <!-- Ghi chú tiến độ -->
                        @if (!string.IsNullOrWhiteSpace(item.GhiChuTienDo))
                        {
                            <div class="alert alert-light border small p-2 mb-3">
                                <i class="fas fa-comment-dots text-primary me-1"></i><strong>Tiến độ:</strong> @item.GhiChuTienDo
                            </div>
                        }

                        <!-- Liên kết liên quan -->
                        <div class="mb-3 d-flex gap-2 flex-wrap">
                            @if (item.MaHopDong.HasValue)
                            {
                                <a href="/Admin/HopDong/Details/@item.MaHopDong" class="badge-soft-navy text-decoration-none">
                                    <i class="fas fa-file-contract me-1"></i>HĐ #@item.MaHopDong
                                </a>
                            }
                            @if (item.MaPhieuBaoTri.HasValue)
                            {
                                <a href="/Admin/BaoTri" class="badge-soft-danger text-decoration-none">
                                    <i class="fas fa-tools me-1"></i>PBT #@item.MaPhieuBaoTri
                                </a>
                            }
                        </div>

                        <!-- Thời hạn hoàn thành -->
                        <div class="border-top pt-2 mb-3 small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="far fa-user me-1"></i>Người giao:</span>
                                <span class="fw-bold text-dark">@(item.NguoiGiao?.HoTen ?? "Hệ thống")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="far fa-calendar-alt me-1"></i>Ngày giao:</span>
                                <span>@item.NgayGiao.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            @if (item.HanHoanThanh.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-1 @(isOverdue ? "text-danger fw-bold" : "")">
                                    <span><i class="fas fa-hourglass-half me-1"></i>Hạn chót:</span>
                                    <span>
                                        @item.HanHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")
                                        @if (isOverdue)
                                        {
                                            <span class="status-pill ms-1"><span class="status-dot dot-danger"></span> Quá hạn</span>
                                        }
                                    </span>
                                </div>
                            }
                            @if (item.NgayHoanThanh.HasValue)
                            {
                                <div class="d-flex justify-content-between text-success fw-bold">
                                    <span><i class="fas fa-check-circle me-1"></i>Xong lúc:</span>
                                    <span>@item.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            }
                        </div>

                        <!-- Chuyển trạng thái -->
                        <div class="d-grid gap-2">
                            @if (item.TrangThai == 0)
                            {
                                <form method="post" asp-action="UpdateStatus" class="d-inline">
                                    <input type="hidden" name="id" value="@item.MaPhanCong" />
                                    <input type="hidden" name="status" value="1" />
                                    <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm">
                                        <i class="fas fa-play me-1"></i> Bắt đầu thực hiện
                                    </button>
                                </form>
                            }
                            else if (item.TrangThai == 1)
                            {
                                <div class="btn-group w-100">
                                    <button type="button" class="btn btn-outline-primary" onclick="openUpdateModal(@item.MaPhanCong, @item.TrangThai, '@Html.Raw(JavaScriptEscape(item.GhiChuTienDo ?? ""))')">
                                        <i class="fas fa-edit me-1"></i> Tiến độ
                                    </button>
                                    <form method="post" asp-action="UpdateStatus" class="d-inline flex-grow-1">
                                        <input type="hidden" name="id" value="@item.MaPhanCong" />
                                        <input type="hidden" name="status" value="2" />
                                        <button type="submit" class="btn btn-success w-100 fw-bold">
                                            <i class="fas fa-check me-1"></i> Báo xong
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light border text-primary" onclick="openUpdateModal(@item.MaPhanCong, @item.TrangThai, '@Html.Raw(JavaScriptEscape(item.GhiChuTienDo ?? ""))')">
                                    <i class="fas fa-sync-alt me-1"></i> Cập nhật ghi chú / Trạng thái
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-5 text-center text-muted">
            <i class="fas fa-clipboard-check fs-1 mb-3 text-secondary d-block"></i>
            <h5 class="fw-bold text-dark">Bạn chưa có nhiệm vụ nào trong mục này</h5>
            <p class="small text-muted mb-0">Khi quản lý phân công công việc mới, nhiệm vụ sẽ tự động hiển thị tại đây.</p>
        </div>
    </div>
}

<!-- Modal cập nhật tiến độ -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-navy"><i class="fas fa-sync-alt me-2"></i>Cập nhật tiến độ nhiệm vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="UpdateStatus">
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="modalTaskId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái công việc <span class="text-danger">*</span></label>
                        <select name="status" id="modalStatus" class="form-select" required>
                            <option value="0">0 - Mới (Chờ nhận)</option>
                            <option value="1">1 - Đang thực hiện</option>
                            <option value="2">2 - Đã hoàn thành</option>
                            <option value="3">3 - Đã hủy</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú tiến độ / Báo cáo thực hiện</label>
                        <textarea name="ghiChu" id="modalGhiChu" class="form-control" rows="4" placeholder="VD: Đã test máy ok, bàn giao cho khách lúc 10h, linh kiện RAM đã thay mới..."></textarea>
                        <div class="form-text">Ghi chú này sẽ được lưu để người giao việc theo dõi tiến trình.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-navy fw-bold px-4"><i class="fas fa-save me-1"></i> Lưu cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public static string JavaScriptEscape(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input.Replace("\\", "\\\\")
                    .Replace("'", "\\'")
                    .Replace("\"", "\\\"")
                    .Replace("\r", "")
                    .Replace("\n", "\\n");
    }
}

@section Scripts {
    <script>
        function openUpdateModal(taskId, status, ghiChu) {
            document.getElementById('modalTaskId').value = taskId;
            document.getElementById('modalStatus').value = status;
            document.getElementById('modalGhiChu').value = ghiChu;
            var modal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
            modal.show();
        }
    </script>
}
