@model RentalSystem.Models.SanPham
@{
    ViewData["Title"] = "Xóa Sản Phẩm";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-trash me-2"></i> Xác Nhận Xóa Sản Phẩm</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa dòng sản phẩm này khỏi hệ thống?</p>
                    <table class="table table-bordered mb-4">
                        <tr>
                            <th class="w-25 bg-light">Mã sản phẩm</th>
                            <td>#@Model.MaSanPham</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tên sản phẩm</th>
                            <td>@Model.TenSanPham</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Loại thiết bị</th>
                            <td>@Model.LoaiThietBi?.TenLoai</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Giá thuê / ngày</th>
                            <td>@Model.GiaThueNgay.ToString("N0") VNĐ</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tiền cọc</th>
                            <td>@Model.TienCoc.ToString("N0") VNĐ</td>
                        </tr>
                    </table>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.MaSanPham" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger fw-bold"><i class="fas fa-trash me-1"></i> Xác Nhận Xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
