@Html.AntiForgeryToken()
@model IEnumerable<RentalSystem.Models.HopDong>
@using RentalSystem.Common
@{
    ViewData["Title"] = "Quản lý Công Nợ";
    bool showUpcoming = ViewBag.ActiveTab == "upcoming";
    bool dueSoon = ViewBag.DueSoon == true;
    DateTime today = ViewBag.Today;
    var installments = (List<RentalSystem.Models.KyHanThanhToan>)ViewBag.Installments;
    var restrictions = (Dictionary<int, string>)ViewBag.RestrictedCustomers;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .kpi-card {
        transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
</style>

<!-- Tiêu đề & Nút Xuất Excel -->
<div class="page-header">
    <h3 class="page-title"><i class="fas fa-hand-holding-usd"></i> Quản lý Công Nợ</h3>
    <a asp-action="ExportExcel"
       asp-route-search="@ViewBag.Search"
       asp-route-agingTier="@ViewBag.AgingTier"
       asp-route-tuNgay="@ViewBag.TuNgay"
       asp-route-denNgay="@ViewBag.DenNgay"
       asp-route-dueSoon="@dueSoon"
       class="btn btn-navy">
        <i class="fas fa-file-excel me-1"></i> Xuất Báo Cáo Excel
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Tổng công nợ</div>
        <div class="stat-value">@(((decimal)(ViewBag.TongCongNo ?? 0m)).ToString("N0")) đ</div>
    </div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Tổng nợ quá hạn</div>
        <div class="stat-value">@(((decimal)(ViewBag.TongNoQuaHan ?? 0m)).ToString("N0")) đ</div>
    </div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Tỷ lệ thu hồi</div>
        <div class="stat-value">@(((decimal)(ViewBag.TyLeThuHoi ?? 0m)).ToString("0.0"))%</div>
    </div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Khoản nợ xấu</div>
        <div class="stat-value">@(ViewBag.SoKhoanNoXau ?? 0)</div>
    </div></div>
</div>
<div class="admin-card mb-4">
    <div class="d-flex flex-wrap gap-3 p-3">
        <span>1–30 ngày: <strong>@ViewBag.AgingTier1Count</strong></span>
        <span>31–60 ngày: <strong>@ViewBag.AgingTier2Count</strong></span>
        <span>61–90 ngày: <strong>@ViewBag.AgingTier3Count</strong></span>
        <span>Trên 90 ngày: <strong>@ViewBag.AgingTier4Count</strong></span>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end" id="filterForm">
            <input type="hidden" name="activeTab" value="@(showUpcoming ? "upcoming" : "overdue")" />

            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Mã HĐ, tên KH, SĐT, CCCD..." value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-12 col-md-3">
                @if (showUpcoming)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="dueSoon" name="dueSoon" value="true" checked="@dueSoon" />
                        <label class="form-check-label" for="dueSoon">Đến hạn trong 7 ngày</label>
                    </div>
                }
                else
                {
                    <label for="agingTier" class="form-label small fw-semibold text-muted mb-1">Nhóm tuổi nợ</label>
                    <select name="agingTier" id="agingTier" class="form-select form-select-sm">
                        <option value="">Tất cả nhóm tuổi nợ</option>
                        @for (int tier = 1; tier <= 4; tier++)
                        {
                            <option value="@tier" selected="@(ViewBag.AgingTier == tier)">@DebtCalculationHelper.GetAgingTierName(tier)</option>
                        }
                    </select>
                }
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                <input type="date" name="tuNgay" class="form-control form-control-sm" value="@ViewBag.TuNgay" />
            </div>

            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Đến ngày</label>
                <input type="date" name="denNgay" class="form-control form-control-sm" value="@ViewBag.DenNgay" />
            </div>

            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill fw-semibold">
                    <i class="fas fa-filter me-1"></i> Lọc
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="fas fa-undo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<nav class="nav nav-tabs mb-3" aria-label="Nhóm kỳ thanh toán">
    <a class="nav-link @(!showUpcoming ? "active" : "")" asp-action="Index" asp-route-activeTab="overdue"
       asp-route-search="@ViewBag.Search" asp-route-tuNgay="@ViewBag.TuNgay" asp-route-denNgay="@ViewBag.DenNgay">Quá hạn</a>
    <a class="nav-link @(showUpcoming ? "active" : "")" asp-action="Index" asp-route-activeTab="upcoming"
       asp-route-search="@ViewBag.Search" asp-route-tuNgay="@ViewBag.TuNgay" asp-route-denNgay="@ViewBag.DenNgay">Chưa quá hạn</a>
</nav>

<div class="card border shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-center">
            <thead class="table-light">
                <tr>
                    <th>Mã HĐ</th>
                    <th>Khách hàng</th>
                    <th>Kỳ hạn</th>
                    <th>Ngày đến hạn</th>
                    <th>Còn phải trả</th>
                    <th>Lịch sử nhắc nợ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (installments.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted py-4">Không có kỳ thanh toán phù hợp.</td></tr>
                }
                @foreach (var k in installments)
                {
                    var hd = k.HopDong;
                    int days = DebtCalculationHelper.DaysPastDue(k, today);
                    decimal principal = Math.Max(0m, k.SoTienPhai - k.SoTienDaTra);
                    decimal penalty = k.TienPhat;
                    int reminders = k.LichSuNhacNos?.Count ?? 0;
                    <tr data-installment-id="@k.MaKyHan">
                        <td class="fw-bold">#@hd.MaHopDong</td>
                        <td>
                            <div class="fw-semibold">@(hd.KhachHang?.HoTen ?? "—")</div>
                            <span class="text-muted small">@hd.KhachHang?.SoDienThoai</span>
                            @if (restrictions.TryGetValue(hd.MaKhachHang, out var reason))
                            {
                                <div class="small text-danger"><strong>Đang hạn chế thuê tiếp.</strong> @reason</div>
                            }
                        </td>
                        <td>Kỳ @k.SoKyHan</td>
                        <td>
                            @k.NgayDenHan.ToString("dd/MM/yyyy")
                            @if (days > 0)
                            {
                                <div class="small text-danger fw-bold">Trễ @days ngày</div>
                            }
                        </td>
                        <td class="fw-bold">
                            @((principal + penalty).ToString("N0")) đ
                            @if (penalty > 0)
                            {
                                <div class="small text-danger">Gồm @penalty.ToString("N0") đ tiền phạt</div>
                            }
                        </td>
                        <td>
                            <span id="badge-nhacno-@k.MaKyHan" class="badge @(reminders > 0 ? "bg-info text-dark" : "bg-light text-muted border")">
                                Đã nhắc @reminders lần
                            </span>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="guiNhacNo(@k.MaKyHan, this)">Nhắc nợ</button>
                            <a href="/Admin/HopDong/Details/@hd.MaHopDong?returnUrl=/Admin/CongNo" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<details class="card border shadow-sm mb-4">
    <summary class="card-header fw-semibold">Tổng hợp theo hợp đồng</summary>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-light">
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Khách hàng</th>
                        <th>Tổng Tiền</th>
                        <th>Đã Thu (gồm cọc)</th>
                        <th>Còn Nợ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-muted py-4">Không tìm thấy hợp đồng nào phù hợp với bộ lọc.</td>
                        </tr>
                    }
                    @foreach (var hd in Model)
                    {
                        var phiDenBu = hd.PhieuBaoTris?.Sum(b => b.PhiDenBu) ?? 0m;
                        var tongPhaiThu = hd.TongTien + phiDenBu;
                        var daThu = (hd.YeuCauThanhToanLanDau ? 0m : hd.TienDaCoc) + (hd.PhieuThus?.Where(pt => !pt.DaHuy && (pt.LoaiPhieu == 0 || pt.LoaiPhieu == 2)).Sum(pt => pt.SoTien) ?? hd.KyHanThanhToans?.Sum(k => k.SoTienDaTra) ?? 0m);
                        var conNo = tongPhaiThu - daThu;
                        <tr>
                            <td class="fw-bold">#@hd.MaHopDong</td>
                            <td>
                                <div class="fw-semibold">@(hd.KhachHang?.HoTen ?? "N/A")</div>
                                <span class="text-muted small">@hd.KhachHang?.SoDienThoai</span>
                                @if (restrictions.TryGetValue(hd.MaKhachHang, out var reason))
                                {
                                    <div class="small text-danger"><strong>Đang hạn chế thuê tiếp.</strong> @reason</div>
                                }
                            </td>
                            <td>
                                @tongPhaiThu.ToString("N0") đ
                                @if (phiDenBu > 0)
                                {
                                    <br /><small class="text-danger fw-bold">(+@phiDenBu.ToString("N0")đ đền bù)</small>
                                }
                            </td>
                            <td class="text-success fw-bold">@daThu.ToString("N0") đ</td>
                            <td class="text-danger fw-bold fs-6">@Math.Max(0, conNo).ToString("N0") đ</td>
                            <td>
                                <a href="/Admin/HopDong/Details/@hd.MaHopDong?returnUrl=/Admin/CongNo" class="btn btn-sm btn-dark">
                                    <i class="fas fa-eye me-1"></i>Chi tiết / Thu tiền
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</details>

<!-- Toast Thông Báo Khi Nhắc Nợ -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="nhacNoToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function showToast(message, type = 'success') {
        const toastEl = document.getElementById('nhacNoToast');
        const messageEl = document.getElementById('toastMessage');
        if (toastEl && messageEl) {
            toastEl.className = 'toast align-items-center text-white border-0 bg-' + type;
            messageEl.textContent = message;
            if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            } else {
                alert(message);
            }
        } else {
            alert(message);
        }
    }

    function guiNhacNo(maKyHan, btn) {
        if (!confirm('Bạn có chắc chắn muốn gửi thông báo nhắc nợ và mã VietQR cho khách hàng này?')) {
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Đang gửi...';

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        fetch('/Admin/CongNo/GuiNhacNo?maKyHan=' + maKyHan, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Lỗi phản hồi máy chủ: ' + response.status);
            }
            return response.json();
        })
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;

            if (data.success) {
                const badges = document.querySelectorAll('#badge-nhacno-' + maKyHan);
                badges.forEach(badge => {
                    badge.className = 'badge bg-info text-dark';
                    badge.innerHTML = '<i class="fas fa-bell me-1"></i>Đã nhắc ' + data.lanNhac + ' lần';
                });
                showToast(data.message || 'Đã gửi thông báo nhắc nợ thành công!', 'success');
            } else {
                showToast(data.message || 'Không thể gửi nhắc nợ.', 'danger');
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
            console.error('Error in guiNhacNo:', err);
            showToast('Lỗi khi gửi thông báo: ' + err.message, 'danger');
        });
    }

</script>
}