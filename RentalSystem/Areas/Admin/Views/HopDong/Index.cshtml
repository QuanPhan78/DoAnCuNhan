@model IEnumerable<RentalSystem.Models.HopDong>
@{
    ViewData["Title"] = "Quản lý Đơn Thuê";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-file-contract text-brand me-2"></i> Danh Sách Hợp Đồng</h2>
        <small class="text-muted">Quản lý vòng đời hợp đồng, bàn giao, thanh toán và xử lý ngoại lệ</small>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="QuetDonQuaHanGiuCho" method="post" onsubmit="return confirm('Bạn có chắc muốn quét và hủy tất cả đơn quá hạn giữ chỗ 24h chưa ký?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning fw-bold shadow-sm" title="Quét giải phóng các đơn quá 24h chưa ký">
                <i class="fas fa-broom me-1"></i> Quét Quá Hạn Giữ Chỗ
            </button>
        </form>
        <a asp-action="Create" class="btn btn-brand fw-bold shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Tạo Hợp Đồng Thủ Công
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
    </div>
}

@{
    string currentFilter = ViewBag.CurrentFilter as string ?? "";
    int overdueCount = ViewBag.OverdueCount != null ? (int)ViewBag.OverdueCount : 0;
    int pendingCancelCount = ViewBag.PendingCancelCount != null ? (int)ViewBag.PendingCancelCount : 0;
    int pendingExtCount = ViewBag.PendingExtensionCount != null ? (int)ViewBag.PendingExtensionCount : 0;
    int pendingProofCount = ViewBag.PendingProofCount != null ? (int)ViewBag.PendingProofCount : 0;
}

<ul class="nav nav-pills mb-3 gap-2 flex-wrap">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(currentFilter) ? "active bg-dark" : "border text-dark")" asp-action="Index">
            Tất cả
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "overdue" ? "active bg-danger" : "border text-danger")" asp-action="Index" asp-route-filter="overdue">
            <i class="fas fa-exclamation-circle me-1"></i> Quá hạn trả máy
            @if (overdueCount > 0) { <span class="badge bg-white text-danger ms-1">@overdueCount</span> }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "pending_extension" ? "active bg-warning text-dark" : "border text-dark")" asp-action="Index" asp-route-filter="pending_extension">
            <i class="fas fa-calendar-plus me-1"></i> Chờ duyệt gia hạn
            @if (pendingExtCount > 0) { <span class="badge bg-danger ms-1">@pendingExtCount</span> }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "pending_cancel" ? "active bg-danger" : "border text-dark")" asp-action="Index" asp-route-filter="pending_cancel">
            <i class="fas fa-ban me-1"></i> Yêu cầu hủy đơn
            @if (pendingCancelCount > 0) { <span class="badge bg-danger ms-1">@pendingCancelCount</span> }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "pending_proof" ? "active bg-info text-dark" : "border text-dark")" asp-action="Index" asp-route-filter="pending_proof">
            <i class="fas fa-receipt me-1"></i> Chờ duyệt biên lai
            @if (pendingProofCount > 0) { <span class="badge bg-danger ms-1">@pendingProofCount</span> }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "renting" ? "active bg-brand" : "border text-dark")" asp-action="Index" asp-route-filter="renting">
            Đang thuê
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "pending" ? "active bg-warning text-dark" : "border text-dark")" asp-action="Index" asp-route-filter="pending">
            Chờ duyệt
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "returned_pending_settlement" || currentFilter == "status_4" ? "active bg-warning text-dark" : "border text-dark")" asp-action="Index" asp-route-filter="returned_pending_settlement">
            <i class="fas fa-undo me-1"></i> Đã trả máy (Chờ quyết toán)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "completed" ? "active bg-success" : "border text-dark")" asp-action="Index" asp-route-filter="completed">
            Hoàn tất
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "cancelled" ? "active bg-secondary" : "border text-dark")" asp-action="Index" asp-route-filter="cancelled">
            Đã hủy
        </a>
    </li>
</ul>

<div class="card shadow border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead>
                    <tr class="table-light">
                        <th style="width: 8%">Mã Đơn</th>
                        <th style="width: 22%" class="text-start">Khách Hàng</th>
                        <th style="width: 20%">Thời gian thuê</th>
                        <th style="width: 15%">Tổng Tiền</th>
                        <th style="width: 12%">Thanh toán</th>
                        <th style="width: 13%">Trạng thái</th>
                        <th style="width: 10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!Model.Any()) {
                        <tr><td colspan="7" class="text-center py-4 text-muted">Không tìm thấy hợp đồng nào phù hợp với bộ lọc.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        var overduePaymentList = ViewBag.Overdue as List<int>;
                        var overdueRentalList = ViewBag.OverdueHopDong as List<int>;
                        bool isPaymentOverdue = overduePaymentList != null && overduePaymentList.Contains(item.MaHopDong);
                        bool isRentalOverdue = overdueRentalList != null && overdueRentalList.Contains(item.MaHopDong);
                        
                        <tr class="@(isRentalOverdue ? "table-danger" : (isPaymentOverdue ? "table-warning" : ""))">
                            <td class="fw-bold text-muted">
                                #@item.MaHopDong
                                @if (item.HanChotKy.HasValue && item.TrangThai == 0 && string.IsNullOrEmpty(item.ChuKyKhachHang))
                                {
                                    <div class="small text-danger" title="Hạn chót ký giữ chỗ">
                                        <i class="fas fa-hourglass-half"></i> @item.HanChotKy.Value.ToString("dd/MM HH:mm")
                                    </div>
                                }
                            </td>
                            <td class="text-start">
                                <span class="fw-bold d-block">@(item.KhachHang?.HoTen ?? "Khách Vãng Lai")</span>
                                <small class="text-muted"><i class="fas fa-phone-alt me-1"></i> @item.KhachHang?.SoDienThoai</small>
                            </td>
                            <td class="small">
                                <div class="text-success fw-bold">Nhận: @item.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                <div class="@(isRentalOverdue ? "text-danger fw-bold" : "text-muted")">
                                    Trả: &nbsp;&nbsp;@item.NgayKetThuc.ToString("dd/MM/yyyy")
                                </div>
                                @if (isRentalOverdue)
                                {
                                    <span class="badge bg-danger mt-1"><i class="fas fa-exclamation-triangle"></i> QUÁ HẠN TRẢ MÁY</span>
                                }
                            </td>
                            <td class="text-danger fw-bold fs-6">
                                @item.TongTien.ToString("N0") đ
                                <div class="small text-muted fw-normal">Cọc: @item.TienDaCoc.ToString("N0") đ</div>
                            </td>
                            <td>
                                @if (isPaymentOverdue) { <span class="badge bg-danger"><i class="fas fa-exclamation-triangle"></i> Nợ kỳ hạn</span> }
                                else if (item.TrangThaiThanhToan == 0) { <span class="badge bg-secondary">Chưa TT</span> }
                                else if (item.TrangThaiThanhToan == 1) { <span class="badge bg-info text-dark">Đã cọc</span> }
                                else if (item.TrangThaiThanhToan == 2) { <span class="badge bg-warning text-dark">Còn nợ</span> }
                                else if (item.TrangThaiThanhToan == 3) { <span class="badge bg-success">Đã TT đủ</span> }
                            </td>
                            <td>
                                @if (item.TrangThai == 0)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-clock"></i> Chờ duyệt</span>
                                    @if (item.YeuCauHuy)
                                    {
                                        <div class="mt-1"><span class="badge bg-danger"><i class="fas fa-ban"></i> Xin hủy đơn</span></div>
                                    }
                                }
                                else if (item.TrangThai == 1)
                                {
                                    <span class="badge bg-brand px-2 py-1"><i class="fas fa-truck"></i> Đang thuê</span>
                                    @if (item.YeuCauGiaHan)
                                    {
                                        <div class="mt-1"><span class="badge bg-warning text-dark"><i class="fas fa-calendar-plus"></i> Xin gia hạn (+@item.SoNgayGiaHan d)</span></div>
                                    }
                                }
                                else if (item.TrangThai == 4)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fas fa-undo"></i> Đã trả máy (Chờ quyết toán)</span>
                                }
                                else if (item.TrangThai == 2) { <span class="badge bg-success px-2 py-1"><i class="fas fa-check"></i> Hoàn tất</span> }
                                else if (item.TrangThai == 3) { <span class="badge bg-danger px-2 py-1"><i class="fas fa-times"></i> Đã hủy</span> }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaHopDong" class="btn btn-sm btn-outline-info fw-bold"><i class="fas fa-eye"></i> Xem</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
