@section Scripts {

<script>
(() => {
 const form = document.getElementById('early-settlement-form');
 if (form) {
  let version=0;
  const submit=document.getElementById('early-settlement-submit');
  const out=document.getElementById('early-settlement-amounts');
  const token=form.elements.settlementToken;
  const money=n=>new Intl.NumberFormat('vi-VN').format(n)+' đ';
  const refresh=async()=>{
   const request=++version; submit.disabled=true; token.value=''; out.textContent='Đang tính quyết toán…';
   try {
    const query=new URLSearchParams({id:form.elements.id.value,kind:'1',returnDate:form.elements.ngayTraThucTe.value,earlyFee:form.elements.phiPhatTraSom.value});
    const response=await fetch('/Admin/HopDong/SettlementPreview?'+query);
    if(!response.ok)throw Error();
    const q=await response.json(); if(request!==version)return;
    if(q.error){out.textContent=q.error;return;}
    out.textContent='Cọc thực thu: '+money(q.depositReceived)+'; cọc đã hoàn: '+money(q.depositRefunded)+
      '; tiền thuê thực tế và phí: '+money(q.rentObligation)+'; nợ thuê: '+money(q.rentDue)+'; bồi thường: '+money(q.damagesDue)+
      '; cọc cấn trừ: '+money(q.depositToRent+q.depositToDamages)+'; hoàn cọc: '+money(q.refundDeposit)+
      '; hoàn tiền thuê: '+money(q.refundRent)+'; hoàn tiền thừa: '+money(q.refundExcess)+'; tổng hoàn: '+money(q.totalRefund)+
      '; cần thu thêm: '+money(q.additionalDue);
    token.value=q.token; submit.disabled=false;
   }catch{if(request===version)out.textContent='Không tải được quyết toán. Vui lòng thử lại.';}
  };
  form.querySelectorAll('input[type=date],input[name=phiPhatTraSom]').forEach(e=>e.addEventListener('change',refresh));
  document.getElementById('modalTraMayTruocHan').addEventListener('show.bs.modal',refresh);
  form.addEventListener('submit',e=>{if(!token.value || !confirm('Xác nhận trả máy và quyết toán theo số tiền vừa xem?'))e.preventDefault();});
 }
 document.querySelectorAll('form[action$="UpdateStatus"],#early-settlement-form').forEach(f=>f.addEventListener('submit',e=>{
  if(e.defaultPrevented)return;
  if(e.submitter?.name){const v=document.createElement('input');v.type='hidden';v.name=e.submitter.name;v.value=e.submitter.value;f.appendChild(v);}
  f.querySelectorAll('button[type=submit]').forEach(b=>b.disabled=true);
 }));
})();
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const paymentForms = document.querySelectorAll(".form-confirm-payment");
        paymentForms.forEach(form => {
            form.addEventListener("submit", function (e) {
                const submitBtn = form.querySelector("button[type='submit']");
                if (submitBtn) {
                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return false;
                    }
                    submitBtn.disabled = true;
                    const originalHtml = submitBtn.innerHTML;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang xử lý...';
                    setTimeout(function () {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalHtml;
                    }, 8000);
                }
            });
        });
    });
</script>
}

<!-- Modal Ký đối chiếu hợp đồng (Dành cho Nhân Viên Kinh Doanh / Admin) -->
<div class="modal fade" id="modalAdminSign" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-navy text-white" style="background-color: var(--navy-primary); color: #fff;">
                <h5 class="modal-title fw-bold"><i class="fas fa-pen-nib me-2"></i> Ký đối chiếu hợp đồng #@Model.MaHopDong</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdminSign" method="post" id="adminSignForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHopDong" />
                <input type="hidden" name="signatureData" id="adminSignatureData" />
                <div class="modal-body p-4 text-center">
                    <p class="text-muted small mb-3">
                        Ký trong khung để xác nhận đối chiếu hồ sơ.
                    </p>
                    <div class="border rounded bg-light d-inline-block p-1 mb-2">
                        <canvas id="admin-signature-pad" width="460" height="200" class="bg-white rounded" style="touch-action: none; cursor: crosshair;"></canvas>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="adminClearBtn">
                            <i class="fas fa-eraser me-1"></i> Xóa chữ ký
                        </button>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-navy fw-bold" id="adminSubmitBtn">
                        <i class="fas fa-check-circle me-1"></i> Lưu chữ ký
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var canvas = document.getElementById('admin-signature-pad');
        if (canvas) {
            var signaturePad = new SignaturePad(canvas, {
                backgroundColor: 'rgb(255, 255, 255)',
                penColor: 'rgb(0, 0, 0)'
            });

            var clearBtn = document.getElementById('adminClearBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    signaturePad.clear();
                });
            }

            var form = document.getElementById('adminSignForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (signaturePad.isEmpty()) {
                        e.preventDefault();
                        alert('Vui lòng ký tên vào khung trước khi xác nhận!');
                    } else {
                        document.getElementById('adminSignatureData').value = signaturePad.toDataURL('image/png');
                    }
                });
            }

            // Xử lý resize canvas khi modal hiển thị
            var modalEl = document.getElementById('modalAdminSign');
            if (modalEl) {
                modalEl.addEventListener('shown.bs.modal', function () {
                    var ratio = Math.max(window.devicePixelRatio || 1, 1);
                    canvas.width = 460;
                    canvas.height = 200;
                    signaturePad.clear();
                });
            }
        }
    });
</script>
