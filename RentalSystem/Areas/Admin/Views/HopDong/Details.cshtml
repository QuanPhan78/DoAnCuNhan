                        <input type="date" name="ngayTraThucTe" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" min="@Model.NgayBatDau.ToString("yyyy-MM-dd")" max="@Model.NgayKetThuc.ToString("yyyy-MM-dd")" required />
