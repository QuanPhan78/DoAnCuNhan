                                                <div class="mt-1"><span class="status-pill"><span class="status-dot dot-danger"></span> Lỗi do KH</span></div>
                                            }
                                            else if (p.LoaiTrachNhiem == 0)
                                            {
                                                <div class="mt-1"><span class="status-pill"><span class="status-dot dot-navy"></span> Lỗi cửa hàng/NSX</span></div>
                                            }
                                            else if (p.LoaiTrachNhiem == 2)
                                            {
                                                <div class="mt-1"><span class="status-pill"><span class="status-dot dot-neutral"></span> Bất khả kháng</span></div>
                                            }
                                        </td>
                                        <td>
                                            @if (p.ChiPhiSuaChua.HasValue && p.ChiPhiSuaChua.Value > 0)
                                            {
                                                <div class="small text-muted">Chi phí: @p.ChiPhiSuaChua.Value.ToString("N0") đ</div>
                                            }
                                            @if (p.PhiDenBu > 0)
                                            {
                                                <div class="fw-bold text-danger">Đền bù: @p.PhiDenBu.ToString("N0") đ</div>
                                                @if (p.DaThuPhi)
                                                {
                                                    <span class="status-pill"><span class="status-dot dot-success"></span> Đã thu</span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill"><span class="status-dot dot-danger"></span> Chưa thu</span>
                                                }
