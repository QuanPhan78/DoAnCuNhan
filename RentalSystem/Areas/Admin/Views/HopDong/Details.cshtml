                                            <div class="fw-bold">@(p.ThietBi?.SanPham?.TenSanPham ?? "Thiết bị")</div>
                                            <small class="badge-soft-neutral font-monospace">@(p.ThietBi?.SoSerial ?? "Chưa rõ serial")</small>
                                        </td>
                                        <td>@p.NgayBaoLoi.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-start small" style="max-width: 250px;">
                                            <div class="text-truncate" title="@p.MoTaLoi">@p.MoTaLoi</div>
                                            @if (!string.IsNullOrEmpty(p.NguyenNhan))
