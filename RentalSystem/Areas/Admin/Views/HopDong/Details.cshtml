            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã Phiếu</th>
                                <th>Thiết Bị / Serial</th>
                                <th>Ngày Báo Lỗi</th>
                                <th>Mô Tả Lỗi</th>
                                <th>KTV Phụ Trách</th>
                                <th>Trạng Thái</th>
                                <th>Chi Phí / Đền Bù</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (phieuBaoTriList == null || !phieuBaoTriList.Any())
                            {
                                <tr><td colspan="8" class="text-muted py-3">Chưa có sự cố hoặc phiếu bảo trì nào phát sinh cho hợp đồng này.</td></tr>
