            </div>
        </div>

        <!-- Phiếu chi và quyết toán cọc -->
        @{
            var phieuChiList = ViewBag.PhieuChis as IEnumerable<RentalSystem.Models.PhieuChi>;
        }
        <div class="card border mb-4" id="settlement-disbursements">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-money-check-alt me-2 text-danger"></i>Phiếu chi</h5>

            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã PC</th>
                                <th>Ngày chi</th>
                                <th>Số tiền chi</th>
                                <th>Loại chi</th>
                                <th>Hình thức</th>
                                <th>Nhân viên chi</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (phieuChiList == null || !phieuChiList.Any())
                            {
                                <tr><td colspan="7" class="text-muted py-3">Chưa có phiếu chi nào cho hợp đồng này.</td></tr>
                            }
                            else
                            {
                                foreach (var pc in phieuChiList)
                                {
                                    <tr>
                                        <td class="fw-bold">#@pc.MaPhieuChi</td>
                                        <td>@pc.NgayChi.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-danger fw-bold">@pc.SoTien.ToString("N0") đ</td>
                                        <td>
                                            @if (pc.LoaiChi == 0)
                                            {
                                                <span class="status-pill"><span class="status-dot dot-warning"></span> Hoàn cọc</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill"><span class="status-dot dot-neutral"></span> Khác</span>
                                            }
                                        </td>
                                        <td>@(pc.HinhThucChi == 1 ? "Chuyển khoản" : "Tiền mặt")</td>
                                        <td>@(pc.NhanVienChi?.HoTen ?? "Kế toán")</td>
                                        <td class="small text-muted">@pc.GhiChu</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</details>

<details class="card border mb-4">
    <summary class="card-header bg-light fw-semibold">Gia hạn &amp; bảo trì</summary>
    <div class="card-body pb-0">
        <!-- Lịch sử gia hạn hợp đồng -->
        @if ((dsYeuCauGiaHanAdmin != null && dsYeuCauGiaHanAdmin.Any()) || Model.YeuCauGiaHan || Model.TrangThaiGiaHan.HasValue)
        {
            <div class="card border mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar-plus me-2 text-info"></i>Lịch sử gia hạn</h5>
                    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                    {
                        <a href="/Admin/HopDong/YeuCauGiaHan" class="btn btn-sm btn-outline-info">
                            <i class="fas fa-list me-1"></i> Tất cả yêu cầu
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle text-center mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Mã YC</th>
                                    <th>Ngày yêu cầu</th>
                                    <th>Số ngày gia hạn</th>
                                    <th>Lý do</th>
                                    <th>Chi phí phát sinh</th>
                                    <th>Trạng thái</th>
                                    <th>Người duyệt</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (dsYeuCauGiaHanAdmin != null && dsYeuCauGiaHanAdmin.Any())
                                {
                                    foreach (var yc in dsYeuCauGiaHanAdmin)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@yc.MaYeuCau</td>
                                            <td>@yc.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="badge-soft-navy font-monospace">+@yc.SoNgayGiaHan ngày</span></td>
                                            <td class="text-start small">@(string.IsNullOrEmpty(yc.LyDo) ? "Không có" : yc.LyDo)</td>
                                            <td>
                                                @if (yc.ChiPhiPhatSinh > 0)
                                                {
                                                    <span class="text-danger fw-bold">+@yc.ChiPhiPhatSinh.ToString("N0") đ</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (yc.TrangThai == 0)
                                                {
                                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt</span>
                                                }
                                                else if (yc.TrangThai == 1)
                                                {
                                                    <span class="status-pill"><span class="status-dot dot-success"></span> Đã duyệt</span>
                                                }
                                                else if (yc.TrangThai == 2)
                                                {
                                                    <span class="status-pill"><span class="status-dot dot-danger"></span> Từ chối</span>
                                                }
                                            </td>
                                            <td>@(yc.NguoiDuyet?.HoTen ?? (yc.TrangThai != 0 ? "Quản trị viên" : "—"))</td>
                                            <td>
                                                <small class="text-muted">@(string.IsNullOrEmpty(yc.GhiChuAdmin) ? "—" : yc.GhiChuAdmin)</small>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td class="fw-bold">#HĐ-@Model.MaHopDong</td>
                                        <td>@Model.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge-soft-navy font-monospace">+@(Model.SoNgayGiaHan ?? 0) ngày</span></td>
                                        <td class="text-start small">@(string.IsNullOrEmpty(Model.LyDoGiaHan) ? "Không có" : Model.LyDoGiaHan)</td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td>
                                            @if (Model.TrangThaiGiaHan == 0 || Model.YeuCauGiaHan)
                                            {
                                                <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt</span>
