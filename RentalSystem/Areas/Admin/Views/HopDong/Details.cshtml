                                                <small class="text-muted d-block">Nguyên nhân: @p.NguyenNhan</small>
                                            }
                                        </td>
                                        <td>@(p.KyThuatVien?.HoTen ?? "Chưa phân công")</td>
                                        <td>
                                            @if (p.TrangThai == 0) { <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ tiếp nhận</span> }
                                            else if (p.TrangThai == 1) { <span class="status-pill"><span class="status-dot dot-navy"></span> Đang sửa chữa</span> }
                                            else if (p.TrangThai == 2) { <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ linh kiện</span> }
                                            else if (p.TrangThai == 3) { <span class="status-pill"><span class="status-dot dot-success"></span> Đã hoàn thành</span> }
                                            else if (p.TrangThai == 4) { <span class="status-pill"><span class="status-dot dot-danger"></span> Hỏng thanh lý</span> }
                                            else if (p.TrangThai == 5) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span> }

                                            @if (p.LoaiTrachNhiem == 1)
