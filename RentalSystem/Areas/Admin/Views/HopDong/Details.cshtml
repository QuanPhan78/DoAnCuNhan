@model RentalSystem.Models.HopDong
@using System.Globalization
@using RentalSystem.Common
@using RentalSystem.Services
@{
    ViewData["Title"] = "Hợp đồng #" + Model.MaHopDong;
    var chiTiets = ViewBag.ChiTiets as IEnumerable<RentalSystem.Models.ChiTietHopDong>;
    var (_, calcTotalCollected, calcRemainingDebt) = DebtCalculationHelper.CalculateContractDebt(Model);
    decimal damagesSafe = Model.PhieuBaoTris?.Sum(b => b.PhiDenBu) ?? 0m;
    decimal tienCocDisplay = Model.TienCocBaoDamMay > 0 ? Model.TienCocBaoDamMay : Model.TienDaCoc;
    bool canManage = User.IsInRole("Admin") || User.IsInRole("KinhDoanh");
    var missingHandover = new List<string>();
    if (string.IsNullOrWhiteSpace(Model.ChuKyKhachHang)) missingHandover.Add("chữ ký khách hàng");
    if (string.IsNullOrWhiteSpace(Model.AnhCCCD_Truoc)) missingHandover.Add("ảnh mặt trước CCCD");
    if (string.IsNullOrWhiteSpace(Model.ChuKyNhanVien)) missingHandover.Add("chữ ký đối chiếu");
    bool hasCustomerDocuments = !string.IsNullOrWhiteSpace(Model.ChuKyKhachHang) && !string.IsNullOrWhiteSpace(Model.AnhCCCD_Truoc);
    var kyHans = ViewBag.KyHans as IEnumerable<RentalSystem.Models.KyHanThanhToan>;
    var phieuThus = ViewBag.PhieuThus as IEnumerable<RentalSystem.Models.PhieuThu>;
    bool pendingFirstPayment = FirstContractPayment.IsPendingHandover(Model);
    var firstInstallment = kyHans?.FirstOrDefault(k => k.SoKyHan == 1 && k.TrangThai != 3);
    var firstBalance = FirstContractPayment.Balance(Model, phieuThus, firstInstallment);
    bool firstPaymentReady = !pendingFirstPayment || (firstInstallment != null && firstBalance.Total == 0);
    var settlement = ViewBag.Settlement as SettlementPreview;
}

<div class="page-header">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <a href="@(ViewBag.ReturnUrl ?? (User.IsInRole("KyThuat") ? "/Admin/PhanCong/MyTasks" : "/Admin/HopDong"))" class="action-btn me-2" title="Quay lại"><i class="fas fa-arrow-left"></i></a>
        <h3 class="page-title mb-0"><i class="fas fa-file-contract"></i> Hợp đồng #@Model.MaHopDong</h3>
        @if (Model.TrangThai == 0 && Model.YeuCauHuy) { <span class="status-pill ms-2"><span class="status-dot dot-danger"></span> Yêu cầu hủy</span> }
        else if (Model.TrangThai == 0) { <span class="status-pill ms-2"><span class="status-dot dot-warning"></span> Chờ duyệt</span> }
        else if (Model.TrangThai == 1) { <span class="status-pill ms-2"><span class="status-dot dot-navy"></span> Đang cho thuê</span> }
        else if (Model.TrangThai == 4) { <span class="status-pill ms-2"><span class="status-dot dot-warning"></span> Đã trả máy (Chờ quyết toán)</span> }
        else if (Model.TrangThai == 2) { <span class="status-pill ms-2"><span class="status-dot dot-success"></span> Hoàn thành</span> }
        else if (Model.TrangThai == 3) { <span class="status-pill ms-2"><span class="status-dot dot-neutral"></span> Đã hủy</span> }
    </div>
    <div>
        <a href="/Document/InHopDong/@Model.MaHopDong" target="_blank" class="btn btn-outline-navy">
            <i class="fas fa-print me-1"></i> In hợp đồng
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning border">@TempData["Warning"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border">@TempData["Success"]</div>
}

@{
    var dsYeuCauGiaHanAdmin = (ViewBag.YeuCauGiaHans as IEnumerable<RentalSystem.Models.YeuCauGiaHan>) ?? Model.DanhSachYeuCauGiaHan;
    var pendingYcAdmin = dsYeuCauGiaHanAdmin?.FirstOrDefault(y => y.TrangThai == 0);
    bool coYcGiaHanChoDuyet = (Model.YeuCauGiaHan || pendingYcAdmin != null) && Model.TrangThai == 1;
}
@if (coYcGiaHanChoDuyet)
{
    int soNgayYc = pendingYcAdmin?.SoNgayGiaHan ?? Model.SoNgayGiaHan ?? 0;
    string lyDoYc = pendingYcAdmin?.LyDo ?? Model.LyDoGiaHan ?? "Không có";
    <div class="alert alert-warning border shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="alert-heading mb-1"><i class="fas fa-calendar-plus me-2"></i> Yêu cầu gia hạn</h5>
                <p class="mb-0">
                    <strong>Thời gian thêm:</strong> <span class="badge-soft-navy font-monospace">+@soNgayYc ngày</span> |
                    <strong>Lý do:</strong> @lyDoYc
                    @if (pendingYcAdmin != null)
                    {
                        <span class="text-muted ms-2">(Gửi lúc: @pendingYcAdmin.NgayYeuCau.ToString("dd/MM/yyyy HH:mm"))</span>
                    }
                </p>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <div class="d-flex gap-2">
                    <form asp-action="DuyetGiaHan" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" name="id" value="@Model.MaHopDong" />
                        <input type="hidden" name="chapNhan" value="true" />
                        <button type="submit" class="btn btn-success fw-bold" onclick="return confirm('Duyệt gia hạn hợp đồng?');">
                            <i class="fas fa-check me-1"></i> Đồng ý Gia Hạn
                        </button>
                    </form>
                    <form asp-action="DuyetGiaHan" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" name="id" value="@Model.MaHopDong" />
                        <input type="hidden" name="chapNhan" value="false" />
                        <button type="submit" class="btn btn-outline-danger fw-bold" onclick="return confirm('Từ chối yêu cầu gia hạn của khách hàng?');">
                            <i class="fas fa-times me-1"></i> Từ chối
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
}

@if (Model.YeuCauHuy && Model.TrangThai == 0)
{
    <div class="alert alert-danger border shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="alert-heading mb-1"><i class="fas fa-ban me-2"></i> Yêu cầu hủy đơn</h5>
                <p class="mb-0">
                    <strong>Thời gian gửi:</strong> @Model.NgayYeuCauHuy?.ToString("dd/MM/yyyy HH:mm") | 
                    <strong>Lý do hủy:</strong> @(string.IsNullOrEmpty(Model.LyDoHuy) ? "Không có" : Model.LyDoHuy)
                </p>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
            {
                <div>
                    <form asp-action="UpdateStatus" method="post" style="display:inline">
                <input type="hidden" name="settlementToken" value="@settlement?.Token" />
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <input type="hidden" name="id" value="@Model.MaHopDong" />
                        <input type="hidden" name="status" value="3" />
                        <button type="submit" class="btn btn-danger fw-bold" onclick="return confirm('Duyệt hủy đơn và giải phóng thiết bị giữ chỗ?');">
                            <i class="fas fa-check me-1"></i> Chấp nhận Hủy Đơn
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
}

@if (canManage && (Model.TrangThai is 1 or 4 || (Model.TrangThai == 0 && !Model.YeuCauHuy)))
{
    <section class="card border mb-4" aria-labelledby="contract-next-action">
        <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h5 id="contract-next-action" class="mb-1">Việc tiếp theo</h5>
                @if (Model.TrangThai == 0)
                {
                    @if (missingHandover.Count > 0)
                    {
                        <p class="mb-0">Chưa thể giao máy. Còn thiếu @string.Join(", ", missingHandover).</p>
                    }
                    else if (!firstPaymentReady)
                    {
                        <p class="mb-0">Chờ xác nhận đủ khoản thanh toán lần đầu.</p>
                    }
                    else
                    {
                        <p class="mb-0">Hồ sơ đã đủ. Xác nhận khi đã giao máy cho khách.</p>
                    }
                }
                else if (Model.TrangThai == 1)
                {
                    <p class="mb-0">Xác nhận khi khách trả máy.</p>
                }
                else
                {
                    <p class="mb-0">Kiểm tra công nợ và tiền cọc trước khi quyết toán.</p>
                }
            </div>
            <form asp-action="UpdateStatus" method="post" class="d-flex flex-wrap gap-2 align-items-start">
                <input type="hidden" name="settlementToken" value="@settlement?.Token" />
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHopDong" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                @if (Model.TrangThai == 0)
                {
                    @if (hasCustomerDocuments && string.IsNullOrWhiteSpace(Model.ChuKyNhanVien))
                    {
                        <button type="button" class="btn btn-navy" data-bs-toggle="modal" data-bs-target="#modalAdminSign">Ký đối chiếu</button>
                    }
                    else
                    {
                        <button type="submit" name="status" value="1" class="btn btn-navy" disabled="@(missingHandover.Count > 0 || !firstPaymentReady || (pendingFirstPayment && Model.YeuCauHuy))"
                                onclick="return confirm('Xác nhận đã giao máy cho khách?');">Giao máy</button>
                    }
                    @if (!Model.YeuCauHuy)
                    {
                        <button type="submit" name="status" value="3" class="btn btn-outline-danger"
                                onclick="return confirm('Hủy hợp đồng và giải phóng thiết bị giữ chỗ?');">Hủy đơn</button>
                    }
                }
                else if (Model.TrangThai == 1)
                {
                    <button type="submit" name="status" value="4" class="btn btn-navy"
                            onclick="return confirm('Xác nhận đã nhận lại máy và chuyển sang chờ quyết toán?');">Nhận lại máy</button>
                    <details>
                        <summary class="btn btn-outline-secondary">Thao tác khác</summary>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal"
                                    data-bs-target="#modalTraMayTruocHan">Trả máy trước hạn</button>

                        </div>
                    </details>
                }
                else
                {
                    <button type="submit" name="status" value="2" class="btn btn-navy"
                            onclick="return confirm('Xác nhận quyết toán công nợ và tiền cọc?');">Quyết toán</button>
                }
            </form>
        </div>
    </section>
}

@if (settlement != null && (settlement.Completed || Model.TrangThai == 0 || Model.TrangThai == 4))
{
    <partial name="_SettlementPreview" model="settlement" />
}

@if (pendingFirstPayment && firstInstallment != null)
{
    <section class="card border mb-4" aria-labelledby="first-payment">
        <div class="card-body">
            <h5 id="first-payment">Thanh toán lần đầu</h5>
            <div class="d-flex flex-wrap gap-3 mb-3">
                <span>Cọc còn thiếu <strong>@firstBalance.Deposit.ToString("N0") đ</strong></span>
                <span>Tiền thuê kỳ đầu còn thiếu <strong>@firstBalance.Rent.ToString("N0") đ</strong></span>
                <span>Tổng còn thiếu <strong>@firstBalance.Total.ToString("N0") đ</strong></span>
            </div>
            @if (firstBalance.Total == 0)
            {
                <span class="text-success fw-semibold">Đã nhận đủ khoản đầu</span>
            }
            else if (canManage && !Model.YeuCauHuy)
            {
                <p class="mb-2">Kiểm tra tiền đã vào tài khoản với nội dung <strong>@FirstContractPayment.TransferReference(Model.MaHopDong)</strong>.</p>
                <form asp-action="XacNhanThanhToanLanDau" method="post" class="row g-2 align-items-end"
                      onsubmit="return confirm('Xác nhận đã đối chiếu số tiền và mã giao dịch với ngân hàng?');">
                    <input type="hidden" name="id" value="@Model.MaHopDong" />
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="col-sm-4">
                        <label for="first-payment-amount" class="form-label">Số tiền thực nhận (đ)</label>
                        <input id="first-payment-amount" name="soTien" type="number" min="1" step="1" class="form-control" required />
                    </div>
                    <div class="col-sm-4">
                        <label for="first-payment-reference" class="form-label">Mã giao dịch ngân hàng</label>
                        <input id="first-payment-reference" name="maGiaoDich" maxlength="100" class="form-control" required />
                    </div>
                    <div class="col-auto"><button class="btn btn-navy" type="submit">Xác nhận chuyển khoản</button></div>
                </form>
            }
        </div>
    </section>
}

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card border h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0">Khách hàng</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>@(Model.KhachHang?.HoTen ?? "Chưa có tên")</strong></p>
                <p class="mb-2"><strong>Điện thoại:</strong> @(Model.KhachHang?.SoDienThoai ?? "Chưa cập nhật")</p>
                <p class="mb-2"><strong>Email:</strong> @(Model.KhachHang?.Email ?? "Chưa cập nhật")</p>
                @if (!User.IsInRole("KyThuat")) { <p class="mb-2"><strong>CCCD:</strong> @(Model.KhachHang?.CCCD ?? "Chưa cập nhật")</p> }
                <p class="mb-2"><strong>Địa chỉ:</strong> @(Model.KhachHang?.DiaChi ?? "Chưa cập nhật")</p>
                <p class="mb-2"><strong>Ngày nhận máy:</strong> @Model.NgayBatDau.ToString("dd/MM/yyyy")</p>
                <p class="mb-2"><strong>Ngày trả máy:</strong> @Model.NgayKetThuc.ToString("dd/MM/yyyy")</p>
                <p class="mb-2"><strong>Số ngày thuê:</strong> @((int)Math.Max(1, (Model.NgayKetThuc.Date - Model.NgayBatDau.Date).TotalDays)) ngày</p>
                <p class="mb-2"><strong>Ngày ký:</strong> @(Model.NgayKy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa ký")</p>
                <p class="mb-0"><strong>Nhân viên phụ trách:</strong> @(Model.NhanVien?.HoTen ?? "Hệ thống tự động")</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0">Tóm tắt thanh toán</h5>
            </div>
            <div class="card-body">
                <p class="mb-2 text-danger fw-bold"><strong>Tiền thuê:</strong> @Model.TongTien.ToString("N0") đ</p>
                <p class="mb-2 text-primary fw-bold"><strong>Cọc bảo đảm:</strong> @tienCocDisplay.ToString("N0") đ</p>
                <p class="mb-2 text-warning fw-bold"><strong>Phí bồi thường:</strong> @damagesSafe.ToString("N0") đ</p>
                <p class="mb-2 text-success fw-bold"><strong>Đã thu tiền thuê và bồi thường:</strong> @calcTotalCollected.ToString("N0") đ</p>
                <p class="mb-2 text-danger fw-bold"><strong>Còn nợ tiền thuê và bồi thường:</strong> @(Math.Max(0m, calcRemainingDebt).ToString("N0")) đ</p>
                <p class="mb-2"><strong>Số kỳ thanh toán:</strong> <span class="badge-soft-neutral font-monospace">@Model.SoKyHan kỳ</span></p>
                <p class="mb-2"><strong>Thanh toán:</strong>
                    <span class="status-pill"><span class="status-dot dot-@ContractPaymentStatus.BadgeTone(Model.TrangThaiThanhToan)"></span> @ContractPaymentStatus.Label(Model.TrangThaiThanhToan)</span>
                </p>
                @if (Model.TienTraThua > 0)
                {
                    <p class="mb-2 text-primary fw-bold"><strong>Tiền trả thừa cần hoàn:</strong> @Model.TienTraThua.ToString("N0") đ</p>
                }
                <p class="mb-2"><strong>Hoàn cọc:</strong>
                    @if (Model.TrangThaiHoanCoc == 1)
                    {
                        <span class="status-pill"><span class="status-dot dot-success"></span> Đã hoàn (@(Model.TienCocThucHoan?.ToString("N0") ?? "0") đ)</span>
                        <small class="text-muted d-block">Ngày: @Model.NgayHoanCoc?.ToString("dd/MM/yyyy HH:mm")</small>
                    }
                    else if (Model.TrangThaiHoanCoc == 2)
                    {
                        <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã cấn trừ hết</span>
                    }
                    else
                    {
                        <span class="status-pill"><span class="status-dot dot-neutral"></span> Chưa hoàn cọc</span>
                    }
                </p>
                @if ((User.IsInRole("Admin") || User.IsInRole("KinhDoanh")) && !pendingFirstPayment && Model.TrangThai != 2 && Model.TrangThai != 3)
                {
                    <button class="btn btn-sm btn-outline-dark mt-1" data-bs-toggle="modal" data-bs-target="#modalThuThemTienThue">
                        <i class="fas fa-plus me-1"></i> Thu thêm tiền thuê
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
{
<!-- Thu thêm tiền thuê -->
<div class="modal fade" id="modalThuThemTienThue" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ThemTienCoc" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <input type="hidden" name="maHopDong" value="@Model.MaHopDong" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Thu thêm tiền thuê</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền thu (đ) <span class="text-danger">*</span></label>
                        <input type="number" name="soTienCoc" class="form-control" min="1" step="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức thanh toán</label>
                        <select name="hinhThuc" class="form-select">
                            <option value="0">Tiền mặt</option>
                            <option value="1">Chuyển khoản</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú</label>
                        <input type="text" name="ghiChu" class="form-control" />
                    </div>
                    <div class="alert alert-light border small">
                        Khoản thu được trừ vào tiền thuê còn nợ.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-dark">Xác nhận thu</button>
                </div>
            </form>
        </div>
    </div>
</div>
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Lịch thanh toán</h5>
                @if ((User.IsInRole("Admin") || User.IsInRole("KinhDoanh")) && !pendingFirstPayment && kyHans != null && kyHans.Any(k => k.TrangThai != 1 && k.TrangThai != 3))
                {
                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalTatToanSom">
                        <i class="fas fa-check-double me-1"></i> Trả hết tiền thuê
                    </button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Kỳ</th>
                                <th>Hạn trả</th>
                                <th>Tiền kỳ hạn</th>
                                <th>Đã thu / Còn thiếu</th>
                                <th>Trạng Thái</th>
                                <th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (kyHans == null || !kyHans.Any()) {
                                <tr><td colspan="6" class="text-muted py-3">Chưa có kỳ thanh toán.</td></tr>
                            }
                            else
                            {
                                @foreach(var k in kyHans) {
                                    var conLai = DebtCalculationHelper.GetInstallmentBalance(k);
                                    var penalty = k.TienPhat;
                                    var hasFraction = conLai != decimal.Truncate(conLai);
                                    var amountFormat = hasFraction ? "N2" : "N0";
                                    bool isOverdue = (k.TrangThai == 2 || (k.TrangThai == 0 && k.NgayDenHan.Date < DateTime.Now.Date)) && (Model.TrangThai == 1 || Model.TrangThai == 0 || Model.TrangThai == 4);
                                    <tr>
                                        <td class="fw-bold">@k.SoKyHan</td>
                                        <td>
                                            @k.NgayDenHan.ToString("dd/MM/yyyy")
                                            @if(isOverdue) { <span class="status-pill ms-1"><span class="status-dot dot-danger"></span> Trễ</span> }
                                        </td>
                                        <td class="text-dark fw-bold">@k.SoTienPhai.ToString("N0") đ</td>
                                        <td>
                                            <span class="text-success small">Đã: @k.SoTienDaTra.ToString("N0") đ</span><br/>
                                            @if (conLai > 0) { <span class="text-danger small fw-bold">Còn: @conLai.ToString(amountFormat) đ</span> }
                                        </td>
                                        <td>
                                            @if (k.TrangThai == 3) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span> }
                                            else if (k.TrangThai == 1) { <span class="status-pill"><span class="status-dot dot-success"></span> Đã trả</span> }
                                            else if (k.TrangThai == 0 && k.SoTienDaTra > 0) {
                                                <span class="status-pill">
                                                    <span class="status-dot dot-warning"></span> Trả một phần
                                                </span>
                                                @if (k.NgayHenTraTiepTheo.HasValue)
                                                {
                                                    <div class="mt-1">
                                                        <span class="status-pill"><span class="status-dot dot-navy"></span> Hẹn: @k.NgayHenTraTiepTheo.Value.ToString("dd/MM/yyyy")</span>
                                                        @if (!string.IsNullOrEmpty(k.GhiChuTraThieu))
                                                        {
                                                            <small class="text-muted d-block font-italic">@k.GhiChuTraThieu</small>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else if (isOverdue) {
                                                <span class="status-pill"><span class="status-dot dot-danger"></span> Quá hạn</span>
                                                @if (penalty > 0)
                                                {
                                                    <small class="text-danger d-block fw-bold">Gồm phí trễ hạn @penalty.ToString("N0") đ</small>
                                                }
                                            }
                                            else { <span class="status-pill"><span class="status-dot dot-warning"></span> Chưa trả</span> }

                                            @if (k.TrangThaiXacNhan == 1)
                                            {
                                                <div class="mt-1">
                                                    <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt biên lai</span>
                                                    <small class="text-muted d-block font-monospace">Mã: @k.MaGiaoDichChuyenKhoan</small>
                                                    @if (!string.IsNullOrEmpty(k.HinhAnhBienLai))
                                                    {
                                                        <a href="@k.HinhAnhBienLai" target="_blank" class="small text-primary fw-bold"><i class="fas fa-image"></i> Xem ảnh</a>
                                                    }
                                                </div>
                                            }
                                            else if (k.TrangThaiXacNhan == 2)
                                            {
                                                <div class="mt-1"><span class="status-pill"><span class="status-dot dot-success"></span> Đã đối soát</span></div>
                                            }
                                        </td>
                                        <td>
                                            @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                                            {
                                                @if (k.TrangThaiXacNhan == 1)
                                                {
                                                    <div class="d-flex gap-1 justify-content-center mb-1">
                                                        <form asp-action="DuyetBienLai" method="post" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                            <input type="hidden" name="maKyHan" value="@k.MaKyHan" />
                                                            <input type="hidden" name="chapNhan" value="true" />
                                                            <button type="submit" class="btn btn-sm btn-success py-0 px-2" title="Xác nhận đã nhận tiền">
                                                                <i class="fas fa-check"></i> Duyệt
                                                            </button>
                                                        </form>
                                                        <form asp-action="DuyetBienLai" method="post" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                            <input type="hidden" name="maKyHan" value="@k.MaKyHan" />
                                                            <input type="hidden" name="chapNhan" value="false" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Từ chối biên lai">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }

                                                @if (!pendingFirstPayment && k.TrangThai is 0 or 2 && Model.TrangThai is 0 or 1 or 4) {
                                                    <button type="button" class="btn btn-sm btn-outline-dark"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#payForm_@k.MaKyHan"
                                                            aria-expanded="false">
                                                        Thu tiền
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalDieuChinh_@k.MaKyHan"
                                                            title="Gia hạn / Điều chỉnh ngày đến hạn">
                                                        <i class="fas fa-calendar-alt"></i>
                                                    </button>
                                                } else {
                                                    <span class="text-success small fw-bold">@k.NgayThanhToan?.ToString("dd/MM/yyyy")</span><br/>
                                                    <span class="text-muted small">@k.GhiChu</span>
                                                }
                                            }
                                            else
                                            {
                                                @if (k.TrangThai == 1)
                                                {
                                                    <span class="text-success small fw-bold">@k.NgayThanhToan?.ToString("dd/MM/yyyy")</span><br/>
                                                }
                                                <span class="text-muted small">@(string.IsNullOrEmpty(k.GhiChu) ? "—" : k.GhiChu)</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (canManage && !pendingFirstPayment && k.TrangThai is 0 or 2 && Model.TrangThai is 0 or 1 or 4) {
                                        <!-- Modal Đổi hạn trả -->
                                        <div class="modal fade" id="modalDieuChinh_@k.MaKyHan" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content text-start">
                                                    <form asp-action="DieuChinhKyHan" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                        <input type="hidden" name="maKyHan" value="@k.MaKyHan" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold"><i class="fas fa-calendar-alt me-2"></i> Đổi hạn trả #@k.SoKyHan</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Ngày đến hạn hiện tại</label>
                                                                <input type="text" class="form-control" value="@k.NgayDenHan.ToString("dd/MM/yyyy")" disabled />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Ngày đến hạn mới <span class="text-danger">*</span></label>
                                                                <input type="date" name="ngayDenHanMoi" class="form-control" value="@k.NgayDenHan.ToString("yyyy-MM-dd")" required />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Lý do điều chỉnh / gia hạn</label>
                                                                <input type="text" name="lyDo" class="form-control" placeholder="Gia hạn theo thỏa thuận với khách hàng..." />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-dark">Lưu</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <tr class="table-light">
                                            <td colspan="6" class="p-0">
                                                <div class="collapse" id="payForm_@k.MaKyHan">
                                                    <div class="p-3">
                                                        <form asp-action="ConfirmPayment" method="post" class="row g-2 align-items-end form-confirm-payment">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                            <input type="hidden" name="maKyHan" value="@k.MaKyHan" />
                                                            <div class="col-md-2">
                                                                <label class="form-label fw-bold small mb-1">Số tiền thu (đ)</label>
                                                                <input type="number" name="soTienThucThu" class="form-control form-control-sm" value="@(conLai.ToString("0.##", CultureInfo.InvariantCulture))"
                                                                       min="@(hasFraction ? "0.01" : "1")" step="@(hasFraction ? "0.01" : "1")" required />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label fw-bold small mb-1">Hình thức</label>
                                                                <select name="hinhThuc" class="form-select form-select-sm">
                                                                    <option value="0">Tiền mặt</option>
                                                                    <option value="1">Chuyển khoản</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label small mb-1">Mã GD ngân hàng</label>
                                                                <input type="text" name="maGiaoDichNganHang" class="form-control form-control-sm" placeholder="Mã giao dịch..." />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label small mb-1">Hẹn trả tiếp</label>
                                                                <input type="date" name="ngayHenTraTiepTheo" class="form-control form-control-sm" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label small mb-1">Ghi chú trả thiếu</label>
                                                                <input type="text" name="ghiChuTraThieu" class="form-control form-control-sm" placeholder="Cam kết trả thiếu..." />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <button type="submit" class="btn btn-dark btn-sm w-100">Xác nhận thu</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Ảnh CCCD và chữ ký -->
<details class="card border mb-4" open="@(missingHandover.Count > 0 && Model.TrangThai == 0)">
    <summary class="card-header bg-light fw-semibold">Hồ sơ ký</summary>
    <div class="card-body">
        <div class="row g-4">
            @if (!User.IsInRole("KyThuat"))
            {
            <div class="col-md-3">
                <p class="text-muted small fw-bold mb-2">CCCD Mặt trước</p>
                @{
                    string? anhTruoc = Model.AnhCCCD_Truoc;
                }
                @if (!string.IsNullOrEmpty(anhTruoc))
                {
                    <a href="@anhTruoc" target="_blank" title="Nhấn để xem đầy đủ">
                        <img src="@anhTruoc" alt="Mặt trước CCCD"
                             class="img-fluid border rounded"
                             style="max-height:160px; object-fit:contain; background:#f8f8f8;" />
                    </a>
                }
                else { <span class="text-muted fst-italic">Chưa tải lên</span> }
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-bold mb-2">CCCD Mặt sau</p>
                @if (!string.IsNullOrEmpty(Model.AnhCCCD_Sau))
                {
                    <a href="@Model.AnhCCCD_Sau" target="_blank" title="Nhấn để xem đầy đủ">
                        <img src="@Model.AnhCCCD_Sau" alt="Mặt sau CCCD"
                             class="img-fluid border rounded"
                             style="max-height:160px; object-fit:contain; background:#f8f8f8;" />
                    </a>
                }
                else { <span class="text-muted fst-italic">Chưa tải lên</span> }
            </div>
            }
            <div class="col-md-3">
                <p class="text-muted small fw-bold mb-2">Chữ ký Khách hàng</p>
                @if (!string.IsNullOrEmpty(Model.ChuKyKhachHang))
                {
                    <img src="@Model.ChuKyKhachHang" alt="Chữ ký KH"
                         class="img-fluid border rounded bg-white"
                         style="max-height:120px; object-fit:contain;" />
                }
                else { <span class="text-muted fst-italic">Chưa ký</span> }
            </div>
            <div class="col-md-3">
                <p class="text-muted small fw-bold mb-2">Chữ ký Nhân viên</p>
                @if (!string.IsNullOrEmpty(Model.ChuKyNhanVien))
                {
                    <img src="@Model.ChuKyNhanVien" alt="Chữ ký NV"
                         class="img-fluid border rounded bg-white"
                         style="max-height:120px; object-fit:contain;" />
                    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-navy btn-sm" data-bs-toggle="modal" data-bs-target="#modalAdminSign">
                                <i class="fas fa-edit me-1"></i> Ký lại
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="mb-2"><span class="text-muted fst-italic">Chưa ký đối chiếu</span></div>
                    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                    {
                        <button type="button" class="btn btn-navy btn-sm" data-bs-toggle="modal" data-bs-target="#modalAdminSign">
                            <i class="fas fa-pen-nib me-1"></i> Ký đối chiếu
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</details>

<details class="card border mb-4" open>
    <summary class="card-header bg-light fw-semibold">Thiết bị &amp; bàn giao</summary>
    <div class="card-body pb-0">
<div class="card border mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Thiết bị theo serial</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle text-center mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Dòng Máy</th>
                        <th>Số Serial (S/N)</th>
                        <th>Tình trạng</th>
                    </tr>
                </thead>
                <tbody>
                    @if(chiTiets != null && chiTiets.Any()) {
                        foreach (var item in chiTiets) {
                            <tr>
                                <td class="fw-bold">@item.ThietBi?.SanPham?.TenSanPham</td>
                                <td><span class="badge-soft-neutral font-monospace">@item.ThietBi?.SoSerial</span></td>
                                <td>
                                    @if(Model.TrangThai == 0) { <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt</span> }
                                    else if(Model.TrangThai == 1) { <span class="status-pill"><span class="status-dot dot-navy"></span> Đang cho thuê</span> }
                                    else if(Model.TrangThai == 2) { <span class="status-pill"><span class="status-dot dot-success"></span> Đã hoàn tất</span> }
                                    else if(Model.TrangThai == 4) { <span class="status-pill"><span class="status-dot dot-warning"></span> Đã trả máy (Chờ quyết toán)</span> }
                                    else if(Model.TrangThai == 3) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span> }
                                </td>
                            </tr>
                        }
                    } else {
                        <tr>
                            <td colspan="3" class="text-muted py-3">Không có dữ liệu thiết bị</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

        <!-- Biên bản bàn giao -->
        @{
            var bienBanList = ViewBag.BienBanBanGiaos as IEnumerable<RentalSystem.Models.BienBanBanGiao>;
        }
        <div class="card border mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-clipboard-check me-2 text-brand"></i>Biên bản giao nhận</h5>
                <button type="button" class="btn btn-sm btn-dark" data-bs-toggle="modal" data-bs-target="#modalLapBienBan">
                    <i class="fas fa-plus me-1"></i> Lập biên bản
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã BB</th>
                                <th>Thời gian</th>
                                <th>Loại biên bản</th>
                                <th>Nhân viên</th>
                                <th>Phụ kiện kèm theo</th>
                                <th>Tình trạng vật lý</th>
                                <th>In / Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (bienBanList == null || !bienBanList.Any())
                            {
                                <tr><td colspan="7" class="text-muted py-3">Chưa có biên bản bàn giao nào.</td></tr>
                            }
                            else
                            {
                                foreach (var bb in bienBanList)
                                {
                                    <tr>
                                        <td class="fw-bold">#@bb.MaBienBan</td>
                                        <td>@bb.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (bb.LoaiBienBan == 0)
                                            {
                                                <span class="status-pill"><span class="status-dot dot-navy"></span> Bàn giao (Xuất kho)</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill"><span class="status-dot dot-success"></span> Thu hồi (Nhập kho)</span>
                                            }
                                        </td>
                                        <td>@(bb.NhanVienLap?.HoTen ?? "Hệ thống")</td>
                                        <td class="small text-muted">@(string.IsNullOrEmpty(bb.PhuKienKemTheo) ? "Đầy đủ sạc/cáp" : bb.PhuKienKemTheo)</td>
                                        <td class="small">@(string.IsNullOrEmpty(bb.TinhTrangNgoaiQuan) ? "Bình thường" : bb.TinhTrangNgoaiQuan)</td>
                                        <td>
                                            <a href="/Document/InBienBanBanGiao/@bb.MaBienBan" target="_blank" class="btn btn-sm btn-outline-dark">
                                                <i class="fas fa-print me-1"></i> In biên bản
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</details>

<details class="card border mb-4">
    <summary class="card-header bg-light fw-semibold">Lịch sử giao dịch</summary>
    <div class="card-body pb-0">
        <div class="card border mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Phiếu thu</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã PT</th>
                                <th>Ngày thu</th>
                                <th>Số tiền</th>
                                <th>Loại phiếu</th>
                                <th>Hình thức</th>
                                <th>Thu ngân</th>
                                <th>Ghi chú / Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (phieuThus == null || !phieuThus.Any()) {
                                <tr><td colspan="8" class="text-muted py-3">Chưa có giao dịch nào được ghi nhận.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in phieuThus) {
                                    <tr>
                                        <td class="fw-bold text-muted">#@p.MaPhieuThu</td>
                                        <td>@p.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (p.DaHuy)
                                            {
                                                <span class="text-decoration-line-through text-muted">@p.SoTien.ToString("N0") đ</span>
                                                <span class="status-pill ms-1"><span class="status-dot dot-neutral"></span> Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold">@p.SoTien.ToString("N0") đ</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.LoaiPhieu == 1) { <span class="status-pill"><span class="status-dot dot-navy"></span> Thu cọc</span> }
                                            else if (p.LoaiPhieu == 0) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Thu kỳ hạn</span> }
                                            else if (p.LoaiPhieu == FirstContractPayment.ExcessReceipt) { <span class="status-pill">Tiền chuyển thừa</span> }
                                            else if (p.LoaiPhieu == 2) { <span class="status-pill"><span class="status-dot dot-warning"></span> Thu phí BT</span> }
                                            else { <span class="status-pill"><span class="status-dot dot-neutral"></span> Khác</span> }
                                        </td>
                                        <td>
                                            @if (p.HinhThucThanhToan == 0) { <span class="status-pill"><span class="status-dot dot-neutral"></span> Tiền mặt</span> }
                                            else if (p.HinhThucThanhToan == 1) {
                                                <span class="status-pill"><span class="status-dot dot-navy"></span> Chuyển khoản</span>
                                                @if (!string.IsNullOrEmpty(p.MaGiaoDichNganHang)) {
                                                    <small class="text-muted d-block font-monospace">GD: @p.MaGiaoDichNganHang</small>
                                                }
                                            }
                                            else if (p.HinhThucThanhToan == 2) { <span class="status-pill"><span class="status-dot dot-navy"></span> VNPay Online</span> }
                                            else { <span class="status-pill"><span class="status-dot dot-neutral"></span> Khác</span> }
                                        </td>
                                        <td>
                                            <span class="small">@(p.NhanVienThu?.HoTen ?? (p.MaNhanVienThu != null ? $"NV #{p.MaNhanVienThu}" : "Hệ thống"))</span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">@p.GhiChu</span>
                                            @if (p.DaHuy)
                                            {
                                                <div class="text-danger small fw-bold">
                                                    <i class="fas fa-ban me-1"></i>Hủy: @p.LyDoHuy (@p.NgayHuy?.ToString("dd/MM/yyyy HH:mm"))
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Document/InPhieuThu/@p.MaPhieuThu" target="_blank" class="btn btn-sm btn-outline-dark" title="In phiếu thu">
                                                <i class="fas fa-print me-1"></i> In
                                            </a>
                                            @if ((User.IsInRole("Admin") || User.IsInRole("KinhDoanh")) && !p.DaHuy && settlement?.Completed != true &&
                                                (!Model.YeuCauThanhToanLanDau ||
                                                    (pendingFirstPayment ? p.GhiChu == FirstContractPayment.ReceiptNote :
                                                        p.GhiChu != FirstContractPayment.ReceiptNote && p.GhiChu != "Thu tiền thuê trả trước khi tạo đơn")))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#modalHuyPhieu_@p.MaPhieuThu" title="Hủy phiếu thu">
                                                    <i class="fas fa-trash-alt me-1"></i> Hủy
                                                </button>

                                                <!-- Modal Hủy phiếu thu -->
                                                <div class="modal fade" id="modalHuyPhieu_@p.MaPhieuThu" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content text-start">
                                                            <form asp-action="HuyPhieuThu" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                                                <input type="hidden" name="maPhieuThu" value="@p.MaPhieuThu" />
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold text-danger"><i class="fas fa-ban me-2"></i> Hủy phiếu thu #@p.MaPhieuThu</h5>
