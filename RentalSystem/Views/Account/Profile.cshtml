@model RentalSystem.Models.NguoiDung
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="mb-0 fw-bold text-brand"><i class="fas fa-user-circle me-2"></i> Hồ Sơ Cá Nhân</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success shadow-sm mb-4"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger shadow-sm mb-4"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaNguoiDung" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ và tên..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Địa chỉ Email</label>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số CCCD / CMND</label>
                                <input asp-for="CCCD" class="form-control" placeholder="Nhập số CCCD..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Vai trò</label>
                                <input type="text" class="form-control bg-light" value="@Model.VaiTro?.TenVaiTro" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Địa chỉ liên hệ</label>
                            <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ..." />
                        </div>

                        <hr class="my-4" />
                        <h5 class="fw-bold mb-3 text-secondary"><i class="fas fa-key me-2"></i>Đổi Mật Khẩu</h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu hiện tại</label>
                            <input type="password" name="currentPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại nếu muốn đổi mật khẩu..." autocomplete="current-password" />
                            <small class="text-muted">Bắt buộc phải nhập mật khẩu hiện tại khi thực hiện thay đổi mật khẩu.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Mật khẩu mới</label>
                            <input type="password" name="MatKhau" class="form-control" placeholder="Nhập mật khẩu mới (để trống nếu không đổi)..." autocomplete="new-password" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/" class="btn btn-light">Quay lại</a>
                            <button type="submit" class="btn btn-brand fw-bold px-4 text-dark"><i class="fas fa-save me-1"></i> Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
