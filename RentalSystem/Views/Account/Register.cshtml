@{
    ViewData["Title"] = "Đăng ký tài khoản";
    var submitted = Context.Request.HasFormContentType ? Context.Request.Form : null;
}
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-header bg-white text-center py-4 border-bottom">
                <h4 class="mb-0 fw-bold" style="color: var(--navy-primary);"><i class="fas fa-user-plus me-2"></i> ĐĂNG KÝ TÀI KHOẢN</h4>
            </div>
            <div class="card-body p-5">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error</div>
                }
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label for="hoTen" class="form-label fw-bold">Họ và tên <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                            <input type="text" id="hoTen" name="hoTen" class="form-control" value="@(submitted?["hoTen"].ToString())" autocomplete="name" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="soDienThoai" class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-phone text-muted"></i></span>
                            <input type="tel" id="soDienThoai" name="soDienThoai" class="form-control" value="@(submitted?["soDienThoai"].ToString())" autocomplete="tel" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="email" class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                            <input type="email" id="email" name="email" class="form-control" value="@(submitted?["email"].ToString())" autocomplete="email" required />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="cccd" class="form-label fw-bold">Số CCCD <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-id-card text-muted"></i></span>
                            <input type="text" id="cccd" name="cccd" class="form-control" value="@(submitted?["cccd"].ToString().Trim())" inputmode="numeric" pattern="\s*[0-9]{12}\s*" title="12 chữ số" required />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="matKhau" class="form-label fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                <input type="password" id="matKhau" name="matKhau" class="form-control" autocomplete="new-password" required minlength="6" />
                            </div>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label for="nhapLaiMatKhau" class="form-label fw-bold">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-check-circle text-muted"></i></span>
                                <input type="password" id="nhapLaiMatKhau" name="nhapLaiMatKhau" class="form-control" autocomplete="new-password" required minlength="6" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-navy w-100 fw-bold py-2 shadow-sm">
                        <i class="fas fa-user-check me-1"></i> Đăng Ký
                    </button>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light border-0">
                <div class="small">Đã có tài khoản? <a asp-action="Login" class="text-decoration-none fw-bold text-brand">Đăng nhập</a></div>
            </div>
        </div>
    </div>
</div>
