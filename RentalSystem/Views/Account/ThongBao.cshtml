@model IEnumerable<RentalSystem.Models.ThongBao>
@{
    ViewData["Title"] = "Trung Tâm Thông Báo";
    int unreadCount = ViewBag.UnreadCount ?? Model.Count(t => !t.DaDoc);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
                        <!-- Header Section -->
            <div class="page-header">
                <h3 class="page-title"><i class="fas fa-bell"></i> Trung Tâm Thông Báo</h3>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(unreadCount > 0 ? "badge-soft-danger" : "badge-soft-neutral") rounded-pill px-3 py-2 fs-6">
                        @unreadCount chưa đọc
                    </span>
                    @if (unreadCount > 0)
                    {
                        <form asp-action="DanhDauDaDoc" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-dark btn-sm fw-bold">
                                <i class="fas fa-check-double me-1"></i>Đánh dấu tất cả đã đọc
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Notification List -->
            @if (Model == null || !Model.Any())
            {
                <div class="card border text-center p-5 shadow-sm">
                    <div class="my-4">
                        <i class="fas fa-bell-slash text-muted" style="font-size: 3.5rem;"></i>
                        <h5 class="fw-bold text-secondary mt-3">Chưa có thông báo nào</h5>
                        <p class="text-muted small">Mọi biến động trạng thái đơn hàng, đối soát và bảo trì sẽ được gửi vào đây.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="list-group shadow-sm border rounded">
                    @foreach (var tb in Model)
                    {
                        string iconClass = tb.LoaiThongBao switch
                        {
                            "HopDong" => "fas fa-file-contract text-primary",
                            "ThanhToan" => "fas fa-money-bill-wave text-success",
                            "BaoTri" => "fas fa-tools text-danger",
                            "GiaHan" => "fas fa-calendar-plus text-info",
                            "PhanCong" => "fas fa-tasks text-warning",
                            "NhacNo" => "fas fa-exclamation-triangle text-danger",
                            "QuyetToan" => "fas fa-receipt text-secondary",
                            _ => "fas fa-bell text-secondary"
                        };

                        string itemBg = !tb.DaDoc ? "bg-light border-start border-4 border-primary" : "";

                        <div class="list-group-item list-group-item-action p-3 @itemBg">
                            <div class="d-flex align-items-start gap-3">
                                <div class="fs-3 pt-1">
                                    <i class="@iconClass"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap">
                                        <h6 class="mb-0 fw-bold @(!tb.DaDoc ? "text-dark" : "text-secondary")">
                                            @tb.TieuDe
                                            @if (!tb.DaDoc)
                                            {
                                                <span class="badge badge-soft-danger ms-2" style="font-size: 0.65rem;">MỚI</span>
                                            }
                                        </h6>
                                        <small class="text-muted">
                                            <i class="far fa-clock me-1"></i>@tb.NgayTao.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                    <p class="mb-2 text-secondary small">@tb.NoiDung</p>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(tb.LienKet))
                                        {
                                            <a href="@tb.LienKet" class="btn btn-sm btn-outline-primary py-0 px-2 fw-bold" style="font-size: 0.8rem;">
                                                <i class="fas fa-external-link-alt me-1"></i>Chi tiết
                                            </a>
                                        }
                                        @if (!tb.DaDoc)
                                        {
                                            <form asp-action="DanhDauDaDoc" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@tb.MaThongBao" />
                                                <button type="submit" class="btn btn-sm btn-link text-decoration-none text-muted py-0 px-1" style="font-size: 0.8rem;" title="Đánh dấu đã đọc">
                                                    <i class="fas fa-check me-1"></i>Đã đọc
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
