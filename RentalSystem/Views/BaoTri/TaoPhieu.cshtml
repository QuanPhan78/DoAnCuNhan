@{ ViewData["Title"] = "Báo Lỗi / Yêu Cầu Bảo Trì"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header text-danger fw-bold fw-bold">
                    <i class="fas fa-exclamation-triangle"></i> Báo Sự Cố / Yêu Cầu Bảo Trì
                </div>
                <div class="card-body">
                    <form asp-action="TaoPhieu" method="post">
                        <input type="hidden" name="maHopDong" value="@ViewBag.HopDong.MaHopDong" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hợp đồng liên quan</label>
                            <input type="text" class="form-control" value="#@ViewBag.HopDong.MaHopDong - Ký ngày @ViewBag.HopDong.NgayBatDau.ToString("dd/MM/yyyy")" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn thiết bị bị lỗi</label>
                            <select name="maThietBi" class="form-select" required>
                                <option value="">-- Chọn thiết bị --</option>
                                @foreach (var ct in ViewBag.ThietBis)
                                {
                                    <option value="@ct.ThietBi.MaThietBi">@ct.ThietBi.SanPham.TenSanPham (Serial: @ct.ThietBi.SoSerial)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả tình trạng lỗi chi tiết</label>
                            <textarea name="moTaLoi" class="form-control" rows="5" required placeholder="Máy bị vô nước, không lên nguồn, màn hình bị sọc..."></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Cart/MyContracts" class="btn btn-light">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger fw-bold"><i class="fas fa-paper-plane"></i> Gửi Yêu Cầu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
