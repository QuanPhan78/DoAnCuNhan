@{
    ViewData["Title"] = "Trang Chủ - Cho Thuê Thiết Bị Văn Phòng";
}

<!-- Hero Carousel -->
<div id="homeCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="false">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active" style="background-color: #333;"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1" style="background-color: #333;"></button>
        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2" style="background-color: #333;"></button>
    </div>
    <div class="carousel-inner">
        <!-- Slide 1 -->
        <div class="carousel-item active" style="background-color: #f4f6f9;">
            <img src="/images/sanpham/may-tinh.png" class="d-block w-100" style="height: 500px; object-fit: contain; padding: 20px;" alt="Office">
            <div class="carousel-caption d-none d-md-block" style="bottom: 10%;">
                <h1 class="display-4 fw-bolder text-dark text-uppercase" style="text-shadow: 1px 1px 5px rgba(255,255,255,0.8);">Cho Thuê Máy Tính Bàn</h1>
                <p class="fs-5 fw-bold mb-4 text-dark">Cấu hình mạnh mẽ - Giao máy tận nơi - Hỗ trợ kỹ thuật 24/7</p>
                <a href="/SanPham" class="btn btn-dark btn-lg fw-bold px-5 rounded-pill shadow">XEM THIẾT BỊ NGAY</a>
            </div>
        </div>
        <!-- Slide 2 -->
        <div class="carousel-item" style="background-color: #f4f6f9;">
            <img src="/images/sanpham/may-lanh.png" class="d-block w-100" style="height: 500px; object-fit: contain; padding: 20px;" alt="Air Conditioner">
            <div class="carousel-caption d-none d-md-block" style="bottom: 10%;">
                <h1 class="display-4 fw-bolder text-dark text-uppercase" style="text-shadow: 1px 1px 5px rgba(255,255,255,0.8);">Máy Lạnh Văn Phòng</h1>
                <p class="fs-5 fw-bold mb-4 text-dark">Giải nhiệt không gian - Lắp đặt nhanh chóng trong ngày</p>
                <a href="/SanPham" class="btn btn-dark btn-lg fw-bold px-5 rounded-pill shadow">TÌM HIỂU THÊM</a>
            </div>
        </div>
        <!-- Slide 3 -->
        <div class="carousel-item" style="background-color: #f4f6f9;">
            <img src="/images/sanpham/may-in.png" class="d-block w-100" style="height: 500px; object-fit: contain; padding: 20px;" alt="Printer">
            <div class="carousel-caption d-none d-md-block" style="bottom: 10%;">
                <h1 class="display-4 fw-bolder text-dark text-uppercase" style="text-shadow: 1px 1px 5px rgba(255,255,255,0.8);">Máy In Tốc Độ Cao</h1>
                <p class="fs-5 fw-bold mb-4 text-dark">In ấn chuyên nghiệp - Không lo chi phí mực in bảo trì</p>
                <a href="/SanPham" class="btn btn-dark btn-lg fw-bold px-5 rounded-pill shadow">ĐẶT THUÊ NGAY</a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(100%);"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(100%);"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Features Section -->
<div class="container mb-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 py-4 hover-lift">
                <div class="card-body">
                    <div class="display-4 text-dark mb-3"><i class="fas fa-shipping-fast"></i></div>
                    <h4 class="fw-bold">Giao Lắp Tận Nơi</h4>
                    <p class="text-muted">Miễn phí vận chuyển và lắp đặt trong khu vực nội thành. Hỗ trợ nhanh chóng trong 2 giờ.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 py-4 hover-lift">
                <div class="card-body">
                    <div class="display-4 text-dark mb-3"><i class="fas fa-tools"></i></div>
                    <h4 class="fw-bold">Bảo Trì Trọn Gói</h4>
                    <p class="text-muted">Đổi máy ngay lập tức nếu có sự cố. Quý khách không phải chịu bất kỳ chi phí sửa chữa nào.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 py-4 hover-lift">
                <div class="card-body">
                    <div class="display-4 text-dark mb-3"><i class="fas fa-file-signature"></i></div>
                    <h4 class="fw-bold">Thủ Tục Đơn Giản</h4>
                    <p class="text-muted">Không thế chấp phức tạp. Ký hợp đồng online nhanh gọn, có xuất hóa đơn VAT cho doanh nghiệp.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
