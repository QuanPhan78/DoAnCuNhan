@model RentalSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="card-body">
                    <div class="display-1 text-danger mb-3">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h2 class="fw-bold mb-3 text-danger">Đã xảy ra lỗi hệ thống!</h2>
                    <p class="text-muted mb-4">
                        Hệ thống đã ghi nhận sự cố và đang tiến hành kiểm tra khắc phục. 
                        Vui lòng thử lại sau hoặc liên hệ bộ phận hỗ trợ kỹ thuật nếu vấn đề tiếp tục diễn ra.
                    </p>
                    @if (Model != null && Model.ShowRequestId)
                    {
                        <p class="small text-muted mb-4">
                            <strong>Mã định danh yêu cầu (Request ID):</strong> <code>@Model.RequestId</code>
                        </p>
                    }
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/" class="btn btn-brand px-4 py-2 fw-bold text-dark">
                            <i class="fas fa-home me-1"></i> Về Trang Chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
