@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using RentalSystem.Helpers
@using RentalSystem.Models

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --brand-color: #1b98e0;
            --brand-text: #000000; /* Phối với chữ đen theo yêu cầu */
        }
        /* Minimalist UI Overrides */
        .bg-brand { background-color: var(--brand-color) !important; color: var(--brand-text) !important; }
        .text-brand { color: var(--brand-color) !important; }
        .btn-brand { background-color: var(--brand-color) !important; color: var(--brand-text) !important; font-weight: 600; border: none; }
        .btn-brand:hover { background-color: #1580bd !important; color: #000 !important; opacity: 0.9; }
        .border-brand { border-color: var(--brand-color) !important; }
        .card-header { background-color: transparent !important; border-bottom: 2px solid #f1f3f5; font-weight: bold; }
        .card { border: 1px solid #e9ecef; box-shadow: none !important; }
        .table thead th { background-color: transparent !important; border-bottom: 2px solid #dee2e6; color: #333; }
        .badge { color: #000 !important; font-weight: 600; } /* Text on badges should be readable */
        
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar-brand { font-weight: 800; letter-spacing: 1px; }
        .nav-link { font-weight: 500; transition: color 0.3s; }
        .nav-link:hover { color: #0056b3 !important; }
        footer { background-color: #2c3e50; color: #ecf0f1; }
        footer a { color: #bdc3c7; text-decoration: none; transition: color 0.3s; }
        footer a:hover { color: #fff; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container">
                <a class="navbar-brand text-brand fs-3" href="/"><i class="fas fa-laptop-house me-2"></i>ABC RENTAL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fs-5">
                        <li class="nav-item"><a href="/" class="nav-link text-dark"><i class="fas fa-home"></i> Trang chủ</a></li>
                        <li class="nav-item"><a href="/SanPham" class="nav-link text-dark"><i class="fas fa-boxes"></i> Sản phẩm</a></li>
                        <li class="nav-item"><a href="#" class="nav-link text-dark"><i class="fas fa-info-circle"></i> Giới thiệu</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @{
                            var cart = HttpContextAccessor.HttpContext?.Session.Get<List<CartItem>>("GioHang");
                            int cartCount = cart != null ? cart.Sum(x => x.SoLuong) : 0;
                        }
                        <li class="nav-item me-3">
                            <a href="/Cart" class="btn btn-outline-dark position-relative rounded-pill px-3 fw-bold">
                                <i class="fas fa-shopping-cart"></i> Giỏ Hàng
                                @if (cartCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow">
                                        @cartCount
                                    </span>
                                }
                            </a>
                        </li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle fs-4 text-brand align-middle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                                    {
                                        <li><a class="dropdown-item py-2 fw-bold text-brand" href="/Admin/Home"><i class="fas fa-tachometer-alt me-2 text-brand"></i>Trang Quản Trị</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item py-2 text-dark fw-bold" href="/Cart/MyContracts"><i class="fas fa-file-contract me-2 text-info"></i>Hợp đồng của tôi</a></li>
                                    <li><a class="dropdown-item py-2 text-dark fw-bold" href="/BaoTri/MyTickets"><i class="fas fa-tools me-2 text-danger"></i>Lịch sử sự cố</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-bold"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a href="/Account/Login" class="btn btn-brand rounded-pill px-4 fw-bold shadow-sm"><i class="fas fa-sign-in-alt me-1"></i> Đăng nhập</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container my-5 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="py-5 mt-auto text-white">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h4 class="fw-bold mb-3 text-white"><i class="fas fa-laptop-house text-info me-2"></i>ABC RENTAL</h4>
                    <p class="text-white-50">Đơn vị tiên phong trong lĩnh vực cho thuê thiết bị văn phòng chuyên nghiệp tại Việt Nam. Tối ưu chi phí, nâng tầm doanh nghiệp.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Dịch vụ</h5>
                    <ul class="list-unstyled lh-lg">
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Máy Tính Bàn</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Máy Lạnh</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Máy In</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Chính sách</h5>
                    <ul class="list-unstyled lh-lg">
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Bảo mật thông tin</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Điều khoản thuê</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Chính sách bảo hành</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Liên hệ</h5>
                    <ul class="list-unstyled lh-lg text-white-50">
                        <li><i class="fas fa-map-marker-alt me-2 text-info"></i> 123 Đường ABC, Quận X, TP.HCM</li>
                        <li><i class="fas fa-phone-alt me-2 text-info"></i> Hotline: 1900 1234</li>
                        <li><i class="fas fa-envelope me-2 text-info"></i> support@abcrental.vn</li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-4 text-center text-white-50">
                <small>&copy; 2026 ABC Rental. Hệ thống Cho Thuê Thiết Bị Văn Phòng Môn Đồ Án Cử Nhân.</small>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
