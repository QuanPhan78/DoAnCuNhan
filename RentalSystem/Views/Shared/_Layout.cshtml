@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using RentalSystem.Helpers
@using RentalSystem.Models

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/classic-navy.css" asp-append-version="true" />
    <style>
        .client-navbar {
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-subtle);
        }
        .client-brand {
            color: var(--navy-primary) !important;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-decoration: none;
            display: flex;
            align-items: center;
            font-size: 1.35rem;
        }
        .client-nav-link {
            font-weight: 600;
            color: var(--text-secondary) !important;
            transition: color 0.15s ease;
            font-size: 0.95rem;
        }
        .client-nav-link:hover {
            color: var(--navy-royal) !important;
        }
        .client-footer {
            background-color: var(--navy-primary);
            color: #cbd5e1;
            margin-top: auto;
        }
        .client-footer h5, .client-footer h4 {
            color: #ffffff;
        }
        .client-footer a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .client-footer a:hover {
            color: #ffffff;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg client-navbar py-3">
            <div class="container">
                <a class="client-brand" href="/">
                    <i class="fas fa-laptop-code me-2 text-primary"></i>ABC RENTAL
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-2">
                        <li class="nav-item"><a href="/" class="nav-link client-nav-link"><i class="fas fa-home me-1"></i> Trang chủ</a></li>
                        <li class="nav-item"><a href="/SanPham" class="nav-link client-nav-link"><i class="fas fa-boxes me-1"></i> Sản phẩm</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        @{
                            var cart = HttpContextAccessor.HttpContext?.Session.Get<List<CartItem>>("GioHang");
                            int cartCount = cart != null ? cart.Sum(x => x.SoLuong) : 0;
                        }
                        <li class="nav-item me-2">
                            <a href="/Cart" class="btn btn-outline-navy position-relative rounded-pill px-3 py-1">
                                <i class="fas fa-shopping-cart me-1"></i> Giỏ Hàng
                                @if (cartCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm">
                                        @cartCount
                                    </span>
                                }
                            </a>
                        </li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-1">
                                <a href="/Account/ThongBao" class="action-btn" title="Thông báo hệ thống">
                                    <i class="fas fa-bell"></i>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-bold d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle fs-5 me-1 text-primary"></i> @(!string.IsNullOrWhiteSpace(User.Identity?.Name) ? User.Identity.Name : "Tài khoản")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2">
                                    @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh") || User.IsInRole("KyThuat"))
                                    {
                                        @if (User.IsInRole("Admin") || User.IsInRole("KinhDoanh"))
                                        {
                                            <li><a class="dropdown-item py-2 fw-bold text-primary" href="/Admin/Home"><i class="fas fa-tachometer-alt me-2"></i>Trang Quản Trị</a></li>
                                        }
                                        <li><a class="dropdown-item py-2 text-dark fw-bold" href="/Admin/PhanCong/MyTasks"><i class="fas fa-tasks me-2 text-primary"></i>Công việc của tôi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    @if (User.IsInRole("KhachHang") || (!User.IsInRole("Admin") && !User.IsInRole("KinhDoanh") && !User.IsInRole("KyThuat")))
                                    {
                                        <li><a class="dropdown-item py-2 text-dark" href="/Cart/MyContracts"><i class="fas fa-file-contract me-2 text-secondary"></i>Hợp đồng của tôi</a></li>
                                        <li><a class="dropdown-item py-2 text-dark" href="/Account/MyDebt"><i class="fas fa-file-invoice-dollar me-2 text-secondary"></i>Sổ công nợ</a></li>
                                        <li><a class="dropdown-item py-2 text-dark" href="/BaoTri/MyTickets"><i class="fas fa-tools me-2 text-secondary"></i>Lịch sử sự cố</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item py-2 text-dark" href="/Account/ThongBao"><i class="fas fa-bell me-2 text-secondary"></i>Thông báo của tôi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-bold"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a href="/Account/Login" class="btn btn-navy rounded-pill px-4 shadow-sm">
                                    <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="client-footer py-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h4 class="fw-bold mb-3"><i class="fas fa-laptop-code text-info me-2"></i>ABC RENTAL</h4>
                    <p class="small text-white-50">Dịch vụ cho thuê thiết bị văn phòng chuyên nghiệp tại Việt Nam. Nhanh chóng, minh bạch và tối ưu chi phí vận hành cho doanh nghiệp.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Dịch vụ</h5>
                    <ul class="list-unstyled lh-lg small">
                        <li><a href="/SanPham"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Máy Tính Bàn</a></li>
                        <li><a href="/SanPham"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Laptop Doanh Nghiệp</a></li>
                        <li><a href="/SanPham"><i class="fas fa-angle-right me-2 text-info"></i>Thuê Thiết Bị Mạng & Máy In</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Chính sách</h5>
                    <ul class="list-unstyled lh-lg small">
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Bảo mật thông tin khách hàng</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Điều khoản hợp đồng thuê máy</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-2 text-info"></i>Quy trình bảo dưỡng & đổi máy lỗi</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">Liên hệ</h5>
                    <ul class="list-unstyled lh-lg small text-white-50">
                        <li><i class="fas fa-map-marker-alt me-2 text-info"></i> Tòa nhà ABC, Khu Công Nghệ Cao, TP.HCM</li>
                        <li><i class="fas fa-phone-alt me-2 text-info"></i> Hotline: 1900 1234</li>
                        <li><i class="fas fa-envelope me-2 text-info"></i> support@abcrental.vn</li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-center text-white-50 small">
                &copy; 2026 ABC Rental. Đồ Án Cử Nhân Chuyên Ngành CNTT.
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
