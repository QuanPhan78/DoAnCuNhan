@model IEnumerable<RentalSystem.Models.HopDong>
@{
    ViewData["Title"] = "Hợp đồng của tôi";
}

<div class="container my-4">
    <div class="page-header">
        <h3 class="page-title"><i class="fas fa-file-contract"></i> Hợp đồng của tôi</h3>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
    }

    <div class="admin-card">
        <div class="admin-card-body p-0">
            <div class="table-responsive">
                <table class="admin-table text-center">
                    <thead>
                        <tr>
                            <th>Mã HĐ</th>
                            <th>Ngày Nhận</th>
                            <th>Ngày Trả</th>
                            <th>Tổng Tiền</th>
                            <th>Tiền Cọc</th>
                            <th>Số Kỳ</th>
                            <th>Trạng Thái</th>
                            <th>Chữ ký</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center py-4">Bạn chưa có đơn thuê nào.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            bool chuaKy = string.IsNullOrEmpty(item.ChuKyKhachHang);
                            bool coTheChinhSua = chuaKy && item.TrangThai == 0;
                            <tr>
                                <td class="fw-bold">#@item.MaHopDong</td>
                                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                <td class="text-danger">@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold text-brand">@item.TongTien.ToString("N0") đ</td>
                                <td class="fw-bold text-warning">@item.TienDaCoc.ToString("N0") đ</td>
                                <td><span class="badge-soft-neutral font-monospace">@item.SoKyHan kỳ</span></td>
                                <td>
                                    @if (item.TrangThai == 0)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-warning"></span> Chờ duyệt</span>
                                        @if (item.YeuCauHuy)
                                        {
                                            <div class="mt-1"><span class="status-pill"><span class="status-dot dot-danger"></span> Đang chờ hủy</span></div>
                                        }
                                    }
                                    else if (item.TrangThai == 1)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-navy"></span> Đang cho thuê</span>
                                        @if (item.YeuCauGiaHan)
                                        {
                                            <div class="mt-1"><span class="status-pill"><span class="status-dot dot-warning"></span> Xin gia hạn</span></div>
                                        }
                                    }
                                    else if (item.TrangThai == 4)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-warning"></span> Đã trả máy (Chờ quyết toán)</span>
                                    }
                                    else if (item.TrangThai == 2)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-success"></span> Hoàn tất</span>
                                        @if (item.TrangThaiHoanCoc == 1)
                                        {
                                            <div class="mt-1"><span class="status-pill"><span class="status-dot dot-navy"></span> Đã hoàn cọc</span></div>
                                        }
                                    }
                                    else if (item.TrangThai == 3)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-neutral"></span> Đã hủy</span>
                                    }
                                </td>
                                <td>
                                    @if (chuaKy)
                                    {
                                        <span class="status-pill"><span class="status-dot dot-neutral"></span> Chưa ký</span>
                                        @if (item.HanChotKy.HasValue && item.TrangThai == 0)
                                        {
                                            <div class="small text-danger mt-1" title="Hạn chót ký để giữ chỗ">
                                                <i class="fas fa-hourglass-half"></i> Hạn: @item.HanChotKy.Value.ToString("dd/MM HH:mm")
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="status-pill"><span class="status-dot dot-success"></span> Đã ký</span>
                                    }
                                </td>
                                <td>
                                    @if (chuaKy)
                                    {
                                        <a asp-action="SignContract" asp-route-id="@item.MaHopDong" class="btn btn-sm btn-navy fw-bold mb-1">
                                            <i class="fas fa-pen-nib"></i> Ký HĐ
                                        </a>
                                    }
                                    @if (coTheChinhSua)
                                    {
                                        <a asp-action="EditContract" asp-route-id="@item.MaHopDong" class="btn btn-sm btn-outline-dark fw-bold mb-1">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger fw-bold mb-1"
                                                data-bs-toggle="modal" data-bs-target="#modalXoa_@item.MaHopDong">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    }
                                    @if (item.TrangThai == 1)
                                    {
                                        <a asp-controller="BaoTri" asp-action="TaoPhieu" asp-route-hopDongId="@item.MaHopDong" class="btn btn-sm btn-danger fw-bold shadow-sm mb-1">
                                            <i class="fas fa-exclamation-triangle"></i> Báo Lỗi
                                        </a>
                                    }
                                    <a asp-action="ContractDetail" asp-route-id="@item.MaHopDong" class="btn btn-sm btn-outline-dark fw-bold mb-1">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    bool chuaKy = string.IsNullOrEmpty(item.ChuKyKhachHang);
    bool coTheChinhSua = chuaKy && item.TrangThai == 0;
    @if (coTheChinhSua)
    {
        <!-- Modal Xác nhận Xóa cho HĐ #@item.MaHopDong -->
                                        <div class="modal fade" id="modalXoa_@item.MaHopDong" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold text-danger">Xác nhận Xóa Đơn Hàng</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Bạn có chắc muốn <strong>xóa đơn hàng #@item.MaHopDong</strong> không?</p>
                                                        <p class="text-muted small">Thao tác này không thể hoàn tác. Toàn bộ thiết bị đang giữ chỗ sẽ được trả về kho.</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy bỏ</button>
                                                        <form asp-action="DeleteContract" method="post" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.MaHopDong" />
                                                            <button type="submit" class="btn btn-danger fw-bold">Xác nhận Xóa</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    
    }
}
