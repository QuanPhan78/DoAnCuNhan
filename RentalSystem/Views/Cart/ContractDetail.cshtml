@model RentalSystem.Models.HopDong
@{
    ViewData["Title"] = "Chi tiết Hợp đồng #" + Model.MaHopDong;
    var chiTiets = ViewBag.ChiTiets as IEnumerable<RentalSystem.Models.ChiTietHopDong>;
    var kyHans = (ViewBag.KyHans as IEnumerable<RentalSystem.Models.KyHanThanhToan>) ?? Model.KyHanThanhToans;
    var phieuThus = ViewBag.PhieuThus as IEnumerable<RentalSystem.Models.PhieuThu>;
    int soNgay = (int)(Model.NgayKetThuc.Date - Model.NgayBatDau.Date).TotalDays;
    if (soNgay <= 0) soNgay = 1;
}

<div class="container my-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm mb-3"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
    }

    @if ((Model.YeuCauGiaHan || (Model.DanhSachYeuCauGiaHan != null && Model.DanhSachYeuCauGiaHan.Any(y => y.TrangThai == 0))) && Model.TrangThai == 1)
    {
        var pendingYc = Model.DanhSachYeuCauGiaHan?.FirstOrDefault(y => y.TrangThai == 0);
        int extraDays = pendingYc?.SoNgayGiaHan ?? Model.SoNgayGiaHan ?? 0;
        string reason = pendingYc?.LyDo ?? Model.LyDoGiaHan ?? "Không có";
        <div class="alert alert-warning border-0 shadow-sm mb-3">
            <i class="fas fa-calendar-plus me-2"></i><strong>Yêu cầu gia hạn đang được xử lý:</strong> Bạn đã yêu cầu gia hạn thêm <strong>@extraDays ngày</strong> (Lý do: @reason). Vui lòng đợi quản trị viên phê duyệt.
        </div>
    }

    @if (Model.YeuCauHuy && Model.TrangThai == 0)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3">
            <i class="fas fa-ban me-2"></i><strong>Yêu cầu hủy đơn đang chờ duyệt:</strong> Bạn đã gửi yêu cầu hủy đơn hàng (Lý do: @Model.LyDoHuy). Quản trị viên sẽ sớm xử lý và giải phóng đơn hàng cho bạn.
        </div>
    }

    @if (Model.TrangThaiHoanCoc == 1)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">
            <i class="fas fa-check-circle me-2"></i><strong>Tiền cọc đã được hoàn tất quyết toán:</strong> Đã hoàn trả <strong>@(Model.TienCocThucHoan?.ToString("N0") ?? "0") đ</strong> vào ngày @Model.NgayHoanCoc?.ToString("dd/MM/yyyy HH:mm").
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="MyContracts" class="btn btn-light border"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h3 class="fw-bold mb-0">Chi tiết Hợp đồng <span class="text-brand">#@Model.MaHopDong</span></h3>
                <small class="text-muted">Tạo lúc @Model.NgayBatDau.ToString("dd/MM/yyyy")</small>
            </div>
        </div>
        <a href="/Document/InHopDong/@Model.MaHopDong" target="_blank" class="btn btn-outline-dark fw-bold">
            <i class="fas fa-print me-1"></i> In / Tải PDF
        </a>
    </div>

    @* Trạng thái tổng quan *@
    <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #1b98e0 !important;">
        <div class="card-body py-3 px-4 d-flex flex-wrap gap-4 align-items-center">
            <div>
                <small class="text-muted d-block">Trạng thái đơn</small>
                @if (Model.TrangThai == 0) { <span class="badge bg-warning text-dark fs-6"><i class="fas fa-clock me-1"></i>Chờ duyệt</span> }
                else if (Model.TrangThai == 1) { <span class="badge bg-brand fs-6"><i class="fas fa-truck me-1"></i>Đang cho thuê</span> }
                else if (Model.TrangThai == 2) { <span class="badge bg-success fs-6"><i class="fas fa-check me-1"></i>Hoàn tất</span> }
                else if (Model.TrangThai == 3) { <span class="badge bg-danger fs-6"><i class="fas fa-times me-1"></i>Đã hủy</span> }
            </div>
            <div>
                <small class="text-muted d-block">Chữ ký</small>
                @if (string.IsNullOrEmpty(Model.ChuKyKhachHang)) {
                    <span class="badge bg-secondary fs-6">Chưa ký</span>
                } else {
                    <span class="badge bg-success fs-6"><i class="fas fa-signature me-1"></i>Đã ký @(Model.NgayKy?.ToString("dd/MM/yyyy") ?? "")</span>
                }
            </div>
            <div>
                <small class="text-muted d-block">Thanh toán</small>
                @if (Model.TrangThaiThanhToan == 0) { <span class="badge bg-secondary fs-6"><i class="fas fa-hourglass-start me-1"></i>Chưa thanh toán</span> }
                else if (Model.TrangThaiThanhToan == 1) { <span class="badge bg-info text-dark fs-6"><i class="fas fa-check-square me-1"></i>Đã đặt cọc</span> }
                else if (Model.TrangThaiThanhToan == 2) { <span class="badge bg-warning text-dark fs-6"><i class="fas fa-exclamation-triangle me-1"></i>Còn nợ</span> }
                else if (Model.TrangThaiThanhToan == 3) { <span class="badge bg-success fs-6"><i class="fas fa-check-circle me-1"></i>Đã tất toán đủ</span> }
                else { <span class="badge bg-success fs-6"><i class="fas fa-check-circle me-1"></i>Đã thanh toán</span> }
                @if (Model.TienTraThua > 0)
                {
                    <span class="badge bg-light text-success border border-success ms-1"><i class="fas fa-coins me-1"></i>Dư: @Model.TienTraThua.ToString("N0") đ</span>
                }
            </div>
            <div class="ms-auto text-end">
                <small class="text-muted d-block">Tổng tiền thuê</small>
                <span class="fw-bold text-danger fs-5">@Model.TongTien.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    @* Thông tin chính *@
    <div class="row g-4 mb-4">
        @* Thông tin khách hàng *@
        <div class="col-md-6">
            <div class="card border h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-user me-2 text-brand"></i>Thông tin Khách hàng</h6>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm mb-0">
                        <tr><td class="text-muted" style="width:130px">Họ tên</td><td class="fw-bold">@(Model.KhachHang?.HoTen ?? "—")</td></tr>
                        <tr><td class="text-muted">Điện thoại</td><td>@(Model.KhachHang?.SoDienThoai ?? "—")</td></tr>
                        <tr><td class="text-muted">Email</td><td>@(Model.KhachHang?.Email ?? "—")</td></tr>
                        <tr><td class="text-muted">CCCD</td><td>@(Model.KhachHang?.CCCD ?? "—")</td></tr>
                        <tr><td class="text-muted">Địa chỉ</td><td>@(Model.KhachHang?.DiaChi ?? "—")</td></tr>
                        <tr class="border-top"><td class="text-muted">Nhân viên</td><td>@(Model.NhanVien?.HoTen ?? "Hệ thống")</td></tr>
                    </table>
                </div>
            </div>
        </div>

        @* Tài chính & thời gian *@
        <div class="col-md-6">
            <div class="card border h-100">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-money-bill-wave me-2 text-brand"></i>Thời gian & Tài chính</h6>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm mb-0">
                        <tr><td class="text-muted" style="width:140px">Ngày nhận máy</td><td class="fw-bold">@Model.NgayBatDau.ToString("dd/MM/yyyy")</td></tr>
                        <tr><td class="text-muted">Ngày trả máy</td><td class="fw-bold text-danger">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</td></tr>
                        <tr><td class="text-muted">Thời gian thuê</td><td>@soNgay ngày</td></tr>
                        <tr class="border-top"><td class="text-muted">Tổng tiền thuê</td><td class="fw-bold text-danger">@Model.TongTien.ToString("N0") đ</td></tr>
                        <tr><td class="text-muted">Tiền đã đặt cọc</td><td class="fw-bold text-success">@Model.TienDaCoc.ToString("N0") đ</td></tr>
                        <tr class="border-top"><td class="text-muted">Số kỳ trả góp</td><td><span class="badge bg-dark">@Model.SoKyHan kỳ</span></td></tr>
                        <tr><td class="text-muted">Ghi chú</td><td class="text-muted small">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có" : Model.GhiChu)</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* Danh sách thiết bị *@
    <div class="card border mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0 fw-bold"><i class="fas fa-laptop me-2 text-brand"></i>Danh sách Thiết bị thuê</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Dòng máy</th>
                            <th>Số Serial</th>
                            <th class="text-end">Giá/ngày</th>
                            <th class="text-end">Tiền cọc yêu cầu</th>
                            <th class="text-end">Thành tiền (@soNgay ngày)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (chiTiets != null && chiTiets.Any())
                        {
                            decimal tongCoc = 0;
                            foreach (var item in chiTiets)
                            {
                                decimal coc = item.ThietBi?.SanPham?.TienCoc ?? 0;
                                tongCoc += coc;
                                <tr>
                                    <td class="fw-bold">@item.ThietBi?.SanPham?.TenSanPham</td>
                                    <td><span class="badge bg-secondary">@item.ThietBi?.SoSerial</span></td>
                                    <td class="text-end">@((item.ThietBi?.SanPham?.GiaThueNgay ?? 0).ToString("N0")) đ</td>
                                    <td class="text-end text-warning fw-bold">@coc.ToString("N0") đ</td>
                                    <td class="text-end fw-bold text-brand">@item.GiaChotThu.ToString("N0") đ</td>
                                </tr>
                            }
                            <tr class="bg-light fw-bold">
                                <td colspan="3" class="text-end">Tổng cọc yêu cầu:</td>
                                <td class="text-end text-warning">@tongCoc.ToString("N0") đ</td>
                                <td class="text-end text-brand">@Model.TongTien.ToString("N0") đ</td>
                            </tr>
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Không có dữ liệu thiết bị</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Kỳ hạn thanh toán *@
    @if (kyHans != null && kyHans.Any())
    {
        <div class="card border mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold"><i class="fas fa-calendar-check me-2 text-brand"></i>Lịch Kỳ hạn Thanh toán</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Kỳ</th>
                                <th>Ngày đến hạn</th>
                                <th>Phải trả</th>
                                <th>Đã trả</th>
                                <th>Còn lại</th>
                                <th>Trạng thái</th>
                                <th>Biên lai / Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in kyHans)
                            {
                                bool isOverdue = k.TrangThai == 0 && k.NgayDenHan.Date < DateTime.Now.Date && (Model.TrangThai == 1 || Model.TrangThai == 0);
                                decimal conLai = k.SoTienPhai - k.SoTienDaTra;
                                <tr class="@(isOverdue ? "table-danger" : "")">
                                    <td class="fw-bold">@k.SoKyHan</td>
                                    <td>
                                        @k.NgayDenHan.ToString("dd/MM/yyyy")
                                        @if (isOverdue) { <span class="badge bg-danger ms-1">Trễ</span> }
                                    </td>
                                    <td class="fw-bold">@k.SoTienPhai.ToString("N0") đ</td>
                                    <td class="text-success fw-bold">@k.SoTienDaTra.ToString("N0") đ</td>
                                    <td class="@(conLai > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @(conLai > 0 ? conLai.ToString("N0") + " đ" : "—")
                                    </td>
                                    <td>
                                        @if (k.TrangThai == 1 || k.SoTienDaTra >= k.SoTienPhai) { <span class="badge bg-success">Đã trả</span> }
                                        else if (k.TrangThai == 0 && k.SoTienDaTra > 0) {
                                            <span class="badge bg-warning text-dark" style="background-color: #fd7e14 !important; color: white !important;">
                                                Trả thiếu (@k.SoTienDaTra.ToString("N0") / @k.SoTienPhai.ToString("N0") đ)
                                            </span>
                                            @if (k.NgayHenTraTiepTheo.HasValue)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-info text-dark"><i class="fas fa-calendar-check me-1"></i>Hẹn trả: @k.NgayHenTraTiepTheo.Value.ToString("dd/MM/yyyy")</span>
                                                    @if (!string.IsNullOrEmpty(k.GhiChuTraThieu))
                                                    {
                                                        <small class="text-muted d-block font-italic">@k.GhiChuTraThieu</small>
                                                    }
                                                </div>
                                            }
                                        }
                                        else if (isOverdue) {
                                            <span class="badge bg-danger">Quá hạn</span>
                                            @if (k.PhiPhatTreHan > 0)
                                            {
                                                <small class="text-danger d-block fw-bold">(Phạt trễ hạn: +@k.PhiPhatTreHan.ToString("N0") đ)</small>
                                            }
                                        }
                                        else { <span class="badge bg-warning text-dark">Chưa trả</span> }
                                    </td>
                                    <td>
                                        @if (k.TrangThai != 1)
                                        {
                                            @if (k.TrangThaiXacNhan == 1)
                                            {
                                                <div>
                                                    <span class="badge bg-info text-dark"><i class="fas fa-clock me-1"></i>Chờ đối soát</span>
                                                    <div class="small text-muted font-monospace mt-1">@k.MaGiaoDichChuyenKhoan</div>
                                                    @if (!string.IsNullOrEmpty(k.HinhAnhBienLai))
                                                    {
                                                        <a href="@k.HinhAnhBienLai" target="_blank" class="small text-brand d-block"><i class="fas fa-image"></i> Xem biên lai</a>
                                                    }
                                                </div>
                                            }
                                            else if (k.TrangThaiXacNhan == 2)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã duyệt</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-brand" data-bs-toggle="modal" data-bs-target="#modalGuiBienLai_@k.MaKyHan">
                                                    <i class="fas fa-upload me-1"></i> Gửi biên lai
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-bold">Hoàn tất</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Hướng dẫn chuyển khoản và thanh toán VNPay *@
    @{
        var phieuBaoTris = ViewBag.PhieuBaoTris as List<RentalSystem.Models.PhieuBaoTri> ?? Model.PhieuBaoTris?.ToList() ?? new List<RentalSystem.Models.PhieuBaoTri>();
        decimal totalDamages = phieuBaoTris.Sum(b => b.PhiDenBu);
        decimal paidDamages = phieuThus?.Where(p => !p.DaHuy && p.LoaiPhieu == 2).Sum(p => p.SoTien) ?? 0m;
        decimal unpaidDamages = Math.Max(0m, totalDamages - paidDamages);

        var nextUnpaidKy = kyHans?.FirstOrDefault(k => k.TrangThai == 0 || k.TrangThai == 2);
        decimal unpaidRent = 0m;
        if (nextUnpaidKy != null)
        {
            unpaidRent = Math.Max(0m, nextUnpaidKy.SoTienPhai - nextUnpaidKy.SoTienDaTra + nextUnpaidKy.PhiPhatTreHan);
        }
        else if (kyHans != null && kyHans.Any())
        {
            unpaidRent = Math.Max(0m, kyHans.Where(k => k.TrangThai != 1 && k.TrangThai != 3).Sum(k => k.SoTienPhai - k.SoTienDaTra + k.PhiPhatTreHan));
        }
        else if (Model.TienDaCoc > 0 && Model.TrangThaiThanhToan == 0)
        {
            unpaidRent = Model.TienDaCoc;
        }
        else
        {
            decimal totalPaidRent = phieuThus?.Where(p => !p.DaHuy && (p.LoaiPhieu == 0 || p.LoaiPhieu == 1)).Sum(p => p.SoTien) ?? 0m;
            unpaidRent = Math.Max(0m, Model.TongTien - totalPaidRent);
        }

        bool hasUnpaidInstallments = kyHans != null && kyHans.Any(k => k.TrangThai == 0 || k.TrangThai == 2);
        decimal vietQrAmount = unpaidRent + unpaidDamages;
        long vietQrAmountLong = (long)vietQrAmount;
        string vietQrMessage = $"HD{Model.MaHopDong}";
        bool shouldShowVietQr = hasUnpaidInstallments || unpaidDamages > 0 || vietQrAmountLong > 0;
    }
    @if (shouldShowVietQr)
    {
        <div class="card border border-primary shadow-sm mb-4" id="bankTransferInstructions">
            <div class="card-header bg-light text-primary fw-bold d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-university me-2 text-brand"></i>Thông tin chuyển khoản VietQR &amp; Cổng thanh toán VNPay</h6>
                <a href="/Payment/CreatePaymentUrl?maHopDong=@Model.MaHopDong" class="btn btn-sm btn-primary fw-bold">
                    <i class="fas fa-credit-card me-1"></i> Thanh toán qua VNPay
                </a>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        <img src="https://img.vietqr.io/image/MB-0783406516-compact.png?amount=@(vietQrAmountLong)&addInfo=@(vietQrMessage)&accountName=PHAN%20MINH%20QUAN" 
                             alt="QR Code Chuyển khoản VietQR" class="img-fluid border rounded p-2 bg-white shadow-sm" style="max-height: 180px;" 
                             onerror="this.onerror=null; this.src='https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@(vietQrMessage)';" />
                        <small class="d-block text-muted mt-1"><i class="fas fa-qrcode me-1"></i>Quét mã QR MBBank (VietQR)</small>
                        <div class="mt-2">
                            <a href="/Payment/CreatePaymentUrl?maHopDong=@Model.MaHopDong" class="btn btn-outline-primary btn-sm w-100 fw-bold">
                                <i class="fas fa-bolt me-1"></i> Thanh toán qua VNPay
                            </a>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="alert alert-info py-2 mb-3">
                            <i class="fas fa-info-circle me-1"></i> Quý khách quét mã VietQR để chuyển khoản (Admin duyệt thủ công) hoặc bấm <strong>Thanh toán qua VNPay</strong> để thanh toán tự động gạch nợ tức thì:
                        </div>
                        <table class="table table-borderless table-sm mb-0">
                            <tr>
                                <td class="text-muted" style="width: 220px;">Ngân hàng / Bank Name:</td>
                                <td class="fw-bold text-dark">MBBank (MB)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Số tài khoản / Account Number:</td>
                                <td class="fw-bold text-brand fs-5">0783406516</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Chủ tài khoản / Account Name:</td>
                                <td class="fw-bold text-dark text-uppercase">PHAN MINH QUAN</td>
                            </tr>
                            @if (unpaidDamages > 0)
                            {
                                <tr>
                                    <td class="text-muted">Tiền thuê / Kỳ hạn:</td>
                                    <td class="fw-bold text-dark">@unpaidRent.ToString("N0") VNĐ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phí bồi thường hư hại:</td>
                                    <td class="fw-bold text-warning">@unpaidDamages.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted">Số tiền thanh toán / Amount:</td>
                                <td class="fw-bold text-danger fs-6">@vietQrAmountLong.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Nội dung / Transfer Content:</td>
                                <td>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-1 font-monospace">HD@(Model.MaHopDong)</span>
                                    <small class="text-muted ms-2">(Cú pháp chuẩn: HD[MaHopDong])</small>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Lịch sử thanh toán *@
    <div class="card border mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0 fw-bold"><i class="fas fa-receipt me-2 text-brand"></i>Lịch sử thanh toán / Giao dịch (Phiếu thu)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle text-center mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Mã PT</th>
                            <th>Ngày thu</th>
                            <th>Số tiền</th>
                            <th>Loại phiếu</th>
                            <th>Hình thức</th>
                            <th>Thu ngân</th>
                            <th>Ghi chú / Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (phieuThus == null || !phieuThus.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-3">Chưa có giao dịch nào được ghi nhận.</td></tr>
                        }
                        else
                        {
                            foreach (var p in phieuThus)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@p.MaPhieuThu</td>
                                    <td>@p.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (p.DaHuy)
                                        {
                                            <span class="text-decoration-line-through text-muted">@p.SoTien.ToString("N0") đ</span>
                                            <span class="badge bg-danger ms-1">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold">@p.SoTien.ToString("N0") đ</span>
                                        }
                                    </td>
                                    <td>
                                        @if (p.LoaiPhieu == 1) { <span class="badge bg-dark">Thu cọc</span> }
                                        else if (p.LoaiPhieu == 0) { <span class="badge bg-secondary">Thu kỳ hạn</span> }
                                        else if (p.LoaiPhieu == 2) { <span class="badge bg-warning text-dark">Thu phí BT</span> }
                                        else { <span class="badge bg-light text-dark border">Khác</span> }
                                    </td>
                                    <td>
                                        @if (p.HinhThucThanhToan == 0) { <span class="badge bg-dark">Tiền mặt</span> }
                                        else if (p.HinhThucThanhToan == 1) {
                                            <span class="badge bg-secondary">Chuyển khoản</span>
                                            @if (!string.IsNullOrEmpty(p.MaGiaoDichNganHang)) {
                                                <small class="text-muted d-block font-monospace">GD: @p.MaGiaoDichNganHang</small>
                                            }
                                        }
                                        else if (p.HinhThucThanhToan == 2) { <span class="badge bg-primary">VNPay Online</span> }
                                        else { <span class="badge bg-light text-dark border">Khác</span> }
                                    </td>
                                    <td>
                                        <span class="small">@(p.NhanVienThu?.HoTen ?? (p.MaNhanVienThu != null ? $"NV #{p.MaNhanVienThu}" : "Hệ thống"))</span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(p.GhiChu) ? "—" : p.GhiChu)</span>
                                        @if (p.DaHuy)
                                        {
                                            <div class="text-danger small fw-bold">
                                                <i class="fas fa-ban me-1"></i>Hủy: @p.LyDoHuy
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Document/InPhieuThu/@p.MaPhieuThu" target="_blank" class="btn btn-sm btn-outline-dark" title="In phiếu thu">
                                            <i class="fas fa-print me-1"></i> In phiếu
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Ảnh CCCD và chữ ký hợp đồng *@
    @{
        string? anhTruoc = !string.IsNullOrEmpty(Model.AnhCCCD_Truoc) ? Model.AnhCCCD_Truoc : Model.AnhCMND;
    }
    <div class="card border mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0 fw-bold"><i class="fas fa-id-card me-2 text-brand"></i>Hình ảnh CCCD &amp; Chữ ký Hợp đồng Hai Bên</h6>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <p class="text-muted small fw-bold mb-2"><i class="fas fa-id-card me-1"></i>CCCD Mặt trước</p>
                    @if (!string.IsNullOrEmpty(anhTruoc))
                    {
                        <a href="@anhTruoc" target="_blank" title="Nhấn để xem ảnh đầy đủ">
                            <img src="@anhTruoc" alt="Mặt trước CCCD"
                                 class="img-fluid border rounded"
                                 style="max-height:160px; object-fit:contain; background:#f8f8f8;" />
                        </a>
                    }
                    else { <span class="text-muted fst-italic">Chưa tải lên</span> }
                </div>
                <div class="col-md-3">
                    <p class="text-muted small fw-bold mb-2"><i class="fas fa-id-card me-1"></i>CCCD Mặt sau</p>
                    @if (!string.IsNullOrEmpty(Model.AnhCCCD_Sau))
                    {
                        <a href="@Model.AnhCCCD_Sau" target="_blank" title="Nhấn để xem ảnh đầy đủ">
                            <img src="@Model.AnhCCCD_Sau" alt="Mặt sau CCCD"
                                 class="img-fluid border rounded"
                                 style="max-height:160px; object-fit:contain; background:#f8f8f8;" />
                        </a>
                    }
                    else { <span class="text-muted fst-italic">Chưa tải lên</span> }
                </div>
                <div class="col-md-3">
                    <p class="text-muted small fw-bold mb-2"><i class="fas fa-signature me-1"></i>Chữ ký của bạn</p>
                    @if (!string.IsNullOrEmpty(Model.ChuKyKhachHang))
                    {
                        <img src="@Model.ChuKyKhachHang" alt="Chữ ký khách hàng"
                             class="img-fluid border rounded bg-white"
                             style="max-height:120px; object-fit:contain;" />
                        <div class="small text-muted mt-1">Đã ký: @Model.NgayKy?.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    else { <span class="badge bg-secondary">Chưa ký tên</span> }
                </div>
                <div class="col-md-3">
                    <p class="text-muted small fw-bold mb-2"><i class="fas fa-stamp me-1"></i>Đại diện Công ty (Bên cho thuê)</p>
                    @if (!string.IsNullOrEmpty(Model.ChuKyNhanVien))
                    {
                        <img src="@Model.ChuKyNhanVien" alt="Chữ ký đại diện công ty"
                             class="img-fluid border rounded bg-white"
                             style="max-height:120px; object-fit:contain;" />
                        <div class="small fw-bold text-dark mt-1">@(Model.NhanVien?.HoTen ?? "Đại diện công ty")</div>
                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã phê duyệt</span>
                    }
                    else
                    {
                        <div class="py-3">
                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Đang chờ công ty ký duyệt</span>
                            <small class="text-muted d-block mt-1">Chữ ký đại diện sẽ xuất hiện sau khi nhân viên thẩm định</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Biên bản bàn giao thiết bị *@
    @if (Model.BienBanBanGiaos != null && Model.BienBanBanGiaos.Any())
    {
        <div class="card border mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold"><i class="fas fa-clipboard-check me-2 text-brand"></i>Biên bản Bàn giao &amp; Thu hồi Thiết bị</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã BB</th>
                                <th>Thời gian</th>
                                <th>Loại</th>
                                <th>Phụ kiện kèm theo</th>
                                <th>Tình trạng ngoại quan</th>
                                <th>Văn bản</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bb in Model.BienBanBanGiaos)
                            {
                                <tr>
                                    <td class="fw-bold">#@bb.MaBienBan</td>
                                    <td>@bb.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (bb.LoaiBienBan == 0)
                                        {
                                            <span class="badge bg-primary">Giao máy (Bắt đầu thuê)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Thu hồi máy (Kết thúc)</span>
                                        }
                                    </td>
                                    <td class="small">@(string.IsNullOrEmpty(bb.PhuKienKemTheo) ? "Đầy đủ" : bb.PhuKienKemTheo)</td>
                                    <td class="small">@(string.IsNullOrEmpty(bb.TinhTrangNgoaiQuan) ? "Bình thường" : bb.TinhTrangNgoaiQuan)</td>
                                    <td>
                                        <a href="/Document/InBienBanBanGiao/@bb.MaBienBan" target="_blank" class="btn btn-sm btn-outline-dark">
                                            <i class="fas fa-print me-1"></i> Xem / In BB
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Phiếu hoàn tiền cọc *@
    @if (Model.PhieuChis != null && Model.PhieuChis.Any())
    {
        <div class="card border mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold"><i class="fas fa-money-check-alt me-2 text-success"></i>Lịch sử Quyết toán &amp; Hoàn cọc (Phiếu chi)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã Phiếu</th>
                                <th>Thời gian</th>
                                <th>Số tiền hoàn</th>
                                <th>Hình thức</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pc in Model.PhieuChis)
                            {
                                <tr>
                                    <td class="fw-bold">#@pc.MaPhieuChi</td>
                                    <td>@pc.NgayChi.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-success fw-bold">@pc.SoTien.ToString("N0") đ</td>
                                    <td>@(pc.HinhThucChi == 1 ? "Chuyển khoản" : "Tiền mặt")</td>
                                    <td class="small text-muted">@pc.GhiChu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Lịch sử yêu cầu gia hạn hợp đồng *@
    @{
        var dsGiaHan = (ViewBag.YeuCauGiaHans as IEnumerable<RentalSystem.Models.YeuCauGiaHan>) ?? Model.DanhSachYeuCauGiaHan;
    }
    @if ((dsGiaHan != null && dsGiaHan.Any()) || Model.YeuCauGiaHan || Model.TrangThaiGiaHan.HasValue)
    {
        <div class="card border mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-calendar-plus me-2 text-info"></i>Lịch sử &amp; Trạng thái Yêu cầu Gia hạn Hợp đồng</h6>
                @if (dsGiaHan != null && dsGiaHan.Any())
                {
                    <span class="badge bg-secondary">@dsGiaHan.Count() yêu cầu</span>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã YC</th>
                                <th>Thời gian gửi</th>
                                <th>Số ngày gia hạn</th>
                                <th>Lý do</th>
                                <th>Chi phí phát sinh</th>
                                <th>Trạng thái</th>
                                <th>Thông tin phản hồi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (dsGiaHan != null && dsGiaHan.Any())
                            {
                                foreach (var yc in dsGiaHan)
                                {
                                    <tr>
                                        <td class="fw-bold">#@yc.MaYeuCau</td>
                                        <td>@yc.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge bg-primary fs-6">+@yc.SoNgayGiaHan ngày</span></td>
                                        <td class="text-start small">@(string.IsNullOrEmpty(yc.LyDo) ? "Không có" : yc.LyDo)</td>
                                        <td>
                                            @if (yc.ChiPhiPhatSinh > 0)
                                            {
                                                <span class="text-danger fw-bold">+@yc.ChiPhiPhatSinh.ToString("N0") đ</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (yc.TrangThai == 0)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Chờ duyệt</span>
                                            }
                                            else if (yc.TrangThai == 1)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã chấp nhận</span>
                                            }
                                            else if (yc.TrangThai == 2)
                                            {
                                                <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Từ chối</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Khác</span>
                                            }
                                        </td>
                                        <td class="small text-muted text-start">
                                            @if (yc.TrangThai != 0)
                                            {
                                                <div><strong>Duyệt lúc:</strong> @yc.NgayDuyet?.ToString("dd/MM/yyyy HH:mm")</div>
                                                @if (yc.NguoiDuyet != null)
                                                {
                                                    <div><strong>Người duyệt:</strong> @yc.NguoiDuyet.HoTen</div>
                                                }
                                                @if (!string.IsNullOrEmpty(yc.GhiChuAdmin))
                                                {
                                                    <div><strong>Ghi chú:</strong> @yc.GhiChuAdmin</div>
                                                }
                                            }
                                            else
                                            {
                                                <span>Đang chờ Admin xử lý</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else if (Model.YeuCauGiaHan || Model.TrangThaiGiaHan.HasValue)
                            {
                                <tr>
                                    <td class="fw-bold">#HĐ-@Model.MaHopDong</td>
                                    <td>@Model.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-primary fs-6">+@(Model.SoNgayGiaHan ?? 0) ngày</span></td>
                                    <td class="text-start small">@(string.IsNullOrEmpty(Model.LyDoGiaHan) ? "Không có" : Model.LyDoGiaHan)</td>
                                    <td><span class="text-muted small">—</span></td>
                                    <td>
                                        @if (Model.TrangThaiGiaHan == 0 || Model.YeuCauGiaHan)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Chờ duyệt</span>
                                        }
                                        else if (Model.TrangThaiGiaHan == 1)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã chấp nhận</span>
                                        }
                                        else if (Model.TrangThaiGiaHan == 2)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Từ chối</span>
                                        }
                                    </td>
                                    <td class="small text-muted text-start">
                                        @if (Model.TrangThaiGiaHan == 0 || Model.YeuCauGiaHan)
                                        {
                                            <span>Đang chờ Admin xử lý</span>
                                        }
                                        else
                                        {
                                            <span>Đã được phản hồi</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Các thao tác *@
    @{
        bool chuaKy = string.IsNullOrEmpty(Model.ChuKyKhachHang);
        bool coTheChinhSua = chuaKy && Model.TrangThai == 0;
    }
    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (chuaKy)
        {
            <a asp-action="SignContract" asp-route-id="@Model.MaHopDong" class="btn btn-brand fw-bold shadow-sm">
                <i class="fas fa-pen-nib me-1"></i> Ký Hợp đồng ngay
            </a>
        }
        @if (coTheChinhSua)
        {
            <a asp-action="EditContract" asp-route-id="@Model.MaHopDong" class="btn btn-outline-dark fw-bold">
                <i class="fas fa-edit me-1"></i> Sửa ngày thuê
            </a>
        }
        @if (Model.TrangThai == 0 && !Model.YeuCauHuy)
        {
            <button type="button" class="btn btn-outline-danger fw-bold" data-bs-toggle="modal" data-bs-target="#modalYeuCauHuy">
                <i class="fas fa-ban me-1"></i> Yêu cầu hủy đơn
            </button>
        }
        @{
            bool hasPendingExtension = Model.YeuCauGiaHan || (Model.DanhSachYeuCauGiaHan != null && Model.DanhSachYeuCauGiaHan.Any(y => y.TrangThai == 0));
        }
        @if (Model.TrangThai == 1 && !hasPendingExtension)
        {
            <button type="button" class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalYeuCauGiaHan">
                <i class="fas fa-calendar-plus me-1"></i> Yêu cầu gia hạn hợp đồng
            </button>
        }
        @if (Model.TrangThai == 1)
        {
            <a asp-controller="BaoTri" asp-action="TaoPhieu" asp-route-hopDongId="@Model.MaHopDong"
               class="btn btn-outline-danger fw-bold">
                <i class="fas fa-exclamation-triangle me-1"></i> Báo lỗi thiết bị
            </a>
        }
        @if (Model.TrangThai != 3 && Model.TrangThaiThanhToan != 3)
        {
            <button type="button" class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalUploadMinhChung">
                <i class="fas fa-file-upload me-1"></i> Tải minh chứng thanh toán
            </button>
            <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#modalTatToanSomKhach">
                <i class="fas fa-check-double me-1"></i> Tất toán sớm hợp đồng
            </button>
        }
    </div>
</div>

@* Modal gửi biên lai *@
@if (kyHans != null)
{
    @foreach (var k in kyHans.Where(k => k.TrangThai != 1))
    {
        <div class="modal fade" id="modalGuiBienLai_@k.MaKyHan" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="GuiBienLai" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maKyHan" value="@k.MaKyHan" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold"><i class="fas fa-receipt me-2 text-brand"></i>Gửi Biên Lai Thanh Toán Kỳ #@k.SoKyHan</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2"><strong>Số tiền thanh toán:</strong> <span class="text-danger fw-bold">@((k.SoTienPhai - k.SoTienDaTra).ToString("N0")) đ</span></p>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Mã giao dịch ngân hàng <span class="text-danger">*</span></label>
                                <input type="text" name="maGiaoDich" class="form-control" placeholder="VD: FT24100689..." required />
                                <small class="text-muted">Nhập mã giao dịch trên sao kê hoặc thông báo chuyển tiền</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Ảnh chụp màn hình biên lai <span class="text-danger">*</span></label>
                                <input type="file" name="hinhAnhBienLai" class="form-control" accept="image/jpeg, image/png, image/webp" required />
                                <small class="text-muted">Định dạng JPG, PNG hoặc WEBP (tối đa 5MB)</small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-brand fw-bold">Gửi Xác Nhận</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@* Modal yêu cầu gia hạn *@
<div class="modal fade" id="modalYeuCauGiaHan" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="YeuCauGiaHan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHopDong" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success"><i class="fas fa-calendar-plus me-2"></i>Yêu Cầu Gia Hạn Hợp Đồng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số ngày muốn gia hạn thêm <span class="text-danger">*</span></label>
                        <input type="number" name="soNgayGiaHan" class="form-control" min="1" max="180" value="7" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do gia hạn <span class="text-danger">*</span></label>
                        <textarea name="lyDo" class="form-control" rows="3" placeholder="VD: Dự án kéo dài thêm, cần sử dụng máy thêm..." required></textarea>
                    </div>
                    <div class="alert alert-light border small">
                        Hệ thống sẽ kiểm tra tính khả dụng của thiết bị. Khi được duyệt, ngày trả máy và tổng chi phí sẽ tự động được cập nhật.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-bold">Gửi Yêu Cầu Gia Hạn</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal yêu cầu hủy đơn *@
<div class="modal fade" id="modalYeuCauHuy" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="YeuCauHuy" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHopDong" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="fas fa-ban me-2"></i>Yêu Cầu Hủy Đơn Hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <textarea name="lyDo" class="form-control" rows="3" placeholder="VD: Thay đổi kế hoạch công tác..." required></textarea>
                    </div>
                    <p class="text-muted small">
                        Yêu cầu hủy sẽ được gửi đến nhân viên phụ trách để duyệt. Thiết bị sẽ được giải phóng khỏi trạng thái giữ chỗ.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger fw-bold">Gửi Yêu Cầu Hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal tải minh chứng thanh toán *@
<div class="modal fade" id="modalUploadMinhChung" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UploadMinhChungThanhToan" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maHopDong" value="@Model.MaHopDong" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="fas fa-file-upload me-2"></i>Tải Minh Chứng Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small">
                        Tải lên ảnh chụp ủy nhiệm chi, hóa đơn hoặc màn hình chuyển khoản ngân hàng thành công để hệ thống đối soát gạch nợ.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kỳ hạn thanh toán</label>
                        <select name="maKyHan" class="form-select">
                            <option value="">-- Toàn bộ hợp đồng / Cọc --</option>
                            @if (kyHans != null)
                            {
                                foreach (var k in kyHans.Where(k => k.TrangThai != 1))
                                {
                                    <option value="@k.MaKyHan">Kỳ @k.SoKyHan - Đến hạn: @k.NgayDenHan.ToString("dd/MM/yyyy") (Còn nợ: @((k.SoTienPhai - k.SoTienDaTra).ToString("N0")) đ)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">File ảnh minh chứng <span class="text-danger">*</span></label>
                        <input type="file" name="fileMinhChung" class="form-control" accept="image/jpeg, image/png, image/webp, application/pdf" required />
                        <small class="text-muted">Định dạng JPG, PNG, WEBP, PDF (tối đa 10MB)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-bold">Gửi Minh Chứng</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal tất toán sớm *@
<div class="modal fade" id="modalTatToanSomKhach" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="TatToanSom" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maHopDong" value="@Model.MaHopDong" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary"><i class="fas fa-check-double me-2"></i>Tất Toán Sớm Hợp Đồng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small">
                        Bạn có thể chọn thanh toán toàn bộ các kỳ hạn còn lại để tất toán dứt điểm hợp đồng ngay bây giờ.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình thức thanh toán</label>
                        <select name="hinhThuc" class="form-select">
                            <option value="1">Chuyển khoản ngân hàng</option>
                            <option value="0">Tiền mặt tại quầy</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã giao dịch ngân hàng (nếu chuyển khoản)</label>
                        <input type="text" name="maGiaoDichNganHang" class="form-control" placeholder="VD: FT24100689..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú</label>
                        <input type="text" name="ghiChu" class="form-control" placeholder="Khách hàng tất toán sớm..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-bold">Xác Nhận Tất Toán</button>
                </div>
            </form>
        </div>
    </div>
</div>
