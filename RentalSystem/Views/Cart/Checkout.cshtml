@model IEnumerable<RentalSystem.Models.CartItem>
@{
    ViewData["Title"] = "Thanh toán & Chốt ngày thuê";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
        }

        <div class="card shadow border-0">
            <div class="card-header text-warning fw-bold text-dark fw-bold py-3">
                <h4 class="mb-0"><i class="fas fa-calendar-check me-2"></i> Thông tin Nhận Máy</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Checkout" method="post" id="checkoutForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ExpectedTotal" id="expectedTotal" />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày nhận máy <span class="text-danger">*</span></label>
                            <input type="date" name="NgayBatDau" id="NgayBatDau" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày trả máy <span class="text-danger">*</span></label>
                            <input type="date" name="NgayKetThuc" id="NgayKetThuc" class="form-control" value="@DateTime.Now.AddDays(2).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Địa chỉ nhận máy tận nơi <span class="text-danger">*</span></label>
                        <textarea name="DiaChi" class="form-control" rows="2" required placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                    </div>

                    <div class="card bg-white border shadow-sm mb-4">
                        <div class="card-body">
                            <label class="form-label fw-bold"><i class="fas fa-ticket-alt text-warning me-1"></i> Mã khuyến mãi (Promo Code)</label>
                            <div class="input-group">
                                <input type="text" id="promoCodeInput" name="PromoCode" class="form-control text-uppercase font-monospace" placeholder="Nhập mã giảm giá..." />
                                <button type="button" class="btn btn-outline-primary fw-bold" id="btnApplyPromo">Áp dụng</button>
                            </div>
                            <div id="promoFeedback" class="small mt-2"></div>
                        </div>
                    </div>

                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Hóa đơn Tạm tính</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tổng tiền 1 ngày:</span>
                                <span class="fw-bold" id="pricePerDay">—</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Số ngày thuê:</span>
                                <span class="fw-bold text-brand fs-5" id="rentalDays">—</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 d-none" id="discountRow">
                                <span class="text-success"><i class="fas fa-tag me-1"></i> Giảm giá (<span id="discountPercentLabel">0</span>%):</span>
                                <span class="fw-bold text-success" id="discountAmountLabel">-0 đ</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <h5 class="fw-bold mb-0">TỔNG CỘNG:</h5>
                                <h3 class="text-danger fw-bolder mb-0" id="finalTotal">—</h3>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="submitRental" class="btn btn-brand btn-lg w-100 fw-bold shadow-sm">
                        <i class="fas fa-paper-plane me-2"></i> GỬI YÊU CẦU THUÊ MÁY
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("checkoutForm");
        const start = document.getElementById("NgayBatDau");
        const end = document.getElementById("NgayKetThuc");
        const promo = document.getElementById("promoCodeInput");
        const feedback = document.getElementById("promoFeedback");
        const submit = document.getElementById("submitRental");
        const expectedTotal = document.getElementById("expectedTotal");
        const discountRow = document.getElementById("discountRow");
        const money = new Intl.NumberFormat("vi-VN", { maximumFractionDigits: 2 });
        let pending;

        function clearQuote() {
            pending?.abort();
            expectedTotal.value = "";
            submit.disabled = true;
            document.getElementById("finalTotal").textContent = "—";
            document.getElementById("pricePerDay").textContent = "—";
            document.getElementById("rentalDays").textContent = "—";
            discountRow.classList.add("d-none");
        }

        async function refreshQuote() {
            clearQuote();
            feedback.textContent = "";
            end.min = start.value;
            if (!start.value || !end.value || end.value < start.value) {
                feedback.textContent = "Kiểm tra ngày nhận và ngày trả.";
                return;
            }

            const request = new AbortController();
            pending = request;
            const fields = new FormData(form);
            try {
                const response = await fetch('@Url.Action("Quote", "Cart")', {
                    method: "POST",
                    body: fields,
                    signal: request.signal
                });
                const quote = await response.json();
                if (request.signal.aborted) return;
                if (!response.ok) {
                    feedback.textContent = quote.message || "Không thể kiểm tra đơn thuê.";
                    return;
                }

                document.getElementById("pricePerDay").textContent = money.format(quote.subtotal / quote.rentalDays) + " đ";
                document.getElementById("rentalDays").textContent = quote.rentalDays + " ngày";
                document.getElementById("finalTotal").textContent = money.format(quote.totalAmount) + " đ";
                if (quote.promoCode) {
                    discountRow.classList.remove("d-none");
                    document.getElementById("discountPercentLabel").textContent = quote.discountPercent;
                    document.getElementById("discountAmountLabel").textContent = "-" + money.format(quote.discountAmount) + " đ";
                    feedback.textContent = "Đã áp dụng mã " + quote.promoCode + ".";
                }
                expectedTotal.value = String(quote.totalAmount);
                submit.disabled = false;
            } catch {
                if (!request.signal.aborted) feedback.textContent = "Không thể tải giá thuê. Vui lòng thử lại.";
            }
        }

        document.getElementById("btnApplyPromo").addEventListener("click", refreshQuote);
        start.addEventListener("change", refreshQuote);
        end.addEventListener("change", refreshQuote);
        promo.addEventListener("input", () => {
            clearQuote();
            if (promo.value.trim()) {
                feedback.textContent = "Bấm Áp dụng để kiểm tra mã.";
            } else {
                refreshQuote();
            }
        });
        promo.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();
                refreshQuote();
            }
        });
        form.addEventListener("submit", event => {
            if (!expectedTotal.value) event.preventDefault();
            else submit.disabled = true;
        });
        refreshQuote();
    });
</script>
