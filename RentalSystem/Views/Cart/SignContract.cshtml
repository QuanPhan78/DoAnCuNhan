@model RentalSystem.Models.HopDong
@{
    ViewData["Title"] = "Ký Hợp Đồng";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold"><i class="fas fa-signature text-brand me-2"></i> Xác nhận & Ký Hợp Đồng</h2>
            <a asp-action="MyContracts" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
        }

        <div class="card shadow border-0 mb-4">
            <div class="card-header text-warning fw-bold text-dark fw-bold">
                <i class="fas fa-info-circle me-2"></i> Thông tin hợp đồng #@Model.MaHopDong
            </div>
            <div class="card-body">
                <p><strong>Ngày nhận:</strong> @Model.NgayBatDau.ToString("dd/MM/yyyy")</p>
                <p><strong>Ngày trả:</strong> @Model.NgayKetThuc.ToString("dd/MM/yyyy")</p>
                <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TongTien.ToString("N0") đ</span></p>
                <p><strong>Yêu cầu đặt cọc:</strong> <span class="text-warning fw-bold">@(((decimal?)ViewBag.TienCocYeuCau ?? 0).ToString("N0")) đ</span> <small class="text-muted">(Thanh toán khi nhận máy)</small></p>
                <p><strong>Tiền đã cọc:</strong> <span class="text-success fw-bold">@Model.TienDaCoc.ToString("N0") đ</span></p>
            </div>
        </div>

        <form asp-action="SignContract" method="post" enctype="multipart/form-data" id="signForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaHopDong" />
            
            @{
                int initialRentalDays = (int)Math.Max(1, Math.Round((Model.NgayKetThuc.Date - Model.NgayBatDau.Date).TotalDays));
                int initialMaxInstallments = Math.Max(1, (int)Math.Floor(initialRentalDays / 7.0));
            }
            <div class="card shadow-sm border-0 mb-4" id="installmentContainer" style="@(initialMaxInstallments <= 1 ? "display:none;" : "")">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-brand"><i class="fas fa-hand-holding-usd me-2"></i> Lựa chọn Thanh toán</h5>
                </div>
                <div class="card-body">
                    <label class="form-label fw-bold">Số kỳ trả góp (Tùy chọn)</label>
                    <select name="soKyHan" id="soKyHan" class="form-select border-dark shadow-none w-50">
                        <option value="1" selected="@(Model.SoKyHan <= 1 ? "selected" : null)">Trả 1 lần (Toàn bộ)</option>
                        <option value="2" selected="@(Model.SoKyHan == 2 && initialMaxInstallments >= 2 ? "selected" : null)" disabled="@(initialMaxInstallments < 2 ? "disabled" : null)" hidden="@(initialMaxInstallments < 2 ? "hidden" : null)" style="@(initialMaxInstallments < 2 ? "display:none;" : null)">Trả góp 2 đợt</option>
                        <option value="3" selected="@(Model.SoKyHan == 3 && initialMaxInstallments >= 3 ? "selected" : null)" disabled="@(initialMaxInstallments < 3 ? "disabled" : null)" hidden="@(initialMaxInstallments < 3 ? "hidden" : null)" style="@(initialMaxInstallments < 3 ? "display:none;" : null)">Trả góp 3 đợt</option>
                        <option value="4" selected="@(Model.SoKyHan == 4 && initialMaxInstallments >= 4 ? "selected" : null)" disabled="@(initialMaxInstallments < 4 ? "disabled" : null)" hidden="@(initialMaxInstallments < 4 ? "hidden" : null)" style="@(initialMaxInstallments < 4 ? "display:none;" : null)">Trả góp 4 đợt</option>
                        <option value="6" selected="@(Model.SoKyHan == 6 && initialMaxInstallments >= 6 ? "selected" : null)" disabled="@(initialMaxInstallments < 6 ? "disabled" : null)" hidden="@(initialMaxInstallments < 6 ? "hidden" : null)" style="@(initialMaxInstallments < 6 ? "display:none;" : null)">Trả góp 6 đợt</option>
                    </select>
                    <small class="text-muted d-block mt-2"><i class="fas fa-info-circle"></i> Tiền thuê sẽ được chia đều cho số kỳ hạn bạn chọn. Thanh toán định kỳ mỗi tháng/tuần tùy theo độ dài hợp đồng.</small>
                </div>
            </div>
            
            <div class="alert alert-primary shadow-sm mt-3">
                <i class="fas fa-file-contract me-2"></i> Vui lòng 
                <a href="/Document/InHopDong/@Model.MaHopDong" target="_blank" class="fw-bold text-decoration-underline text-brand">ĐỌC KỸ CÁC ĐIỀU KHOẢN TRONG HỢP ĐỒNG TẠI ĐÂY</a> 
                trước khi thực hiện ký tên xác nhận bên dưới.
            </div>

            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light text-primary fw-bold">
                    <i class="fas fa-id-card me-2"></i> Bước 1: Tải lên Ảnh CCCD / CMND Hai Mặt (Bắt buộc)
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Vui lòng tải lên ảnh chụp 2 mặt Căn cước công dân rõ nét (không bị chói sáng, mờ hay mất góc) để hoàn tất thủ tục pháp lý thuê máy. Dung lượng tối đa mỗi ảnh là 5MB.</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 text-center bg-light h-100">
                                <label class="form-label fw-bold d-block text-dark mb-2">
                                    <i class="fas fa-address-card me-1 text-brand"></i> Mặt TRƯỚC CCCD <span class="text-danger">*</span>
                                </label>
                                <input type="file" name="cmndTruocFile" id="cmndTruocFile" class="form-control mb-2" accept="image/jpeg, image/png, image/webp" required onchange="previewImg(this, 'previewTruoc')" />
                                <div class="text-center">
                                    <img id="previewTruoc" src="#" alt="Xem trước mặt trước" class="img-fluid rounded border d-none" style="max-height: 140px; object-fit: contain;" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 text-center bg-light h-100">
                                <label class="form-label fw-bold d-block text-dark mb-2">
                                    <i class="fas fa-address-card me-1 text-brand"></i> Mặt SAU CCCD <span class="text-danger">*</span>
                                </label>
                                <input type="file" name="cmndSauFile" id="cmndSauFile" class="form-control mb-2" accept="image/jpeg, image/png, image/webp" required onchange="previewImg(this, 'previewSau')" />
                                <div class="text-center">
                                    <img id="previewSau" src="#" alt="Xem trước mặt sau" class="img-fluid rounded border d-none" style="max-height: 140px; object-fit: contain;" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0 mb-4">
                <div class="card-header text-success fw-bold fw-bold">
                    <i class="fas fa-pen-nib me-2"></i> Bước 2: Ký tên xác nhận
                </div>
                <div class="card-body text-center">
                    <p class="text-muted">Dùng chuột hoặc ngón tay (trên điện thoại) để ký vào khung bên dưới.</p>
                    <div class="border rounded bg-light d-inline-block p-1">
                        <canvas id="signature-pad" width="600" height="250" class="bg-white rounded"></canvas>
                    </div>
                    <div class="mt-3">
                        <button type="button" class="btn btn-light" id="clearBtn"><i class="fas fa-eraser me-1"></i> Xóa chữ ký làm lại</button>
                    </div>
                    <input type="hidden" name="signatureData" id="signatureData" />
                </div>
                <div class="card-footer text-center bg-white border-0 py-4">
                    <button type="submit" class="btn btn-brand btn-lg fw-bold shadow px-5" id="submitBtn"><i class="fas fa-check-circle me-2"></i> HOÀN TẤT KÝ HỢP ĐỒNG</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
    <script>
        function previewImg(input, previewId) {
            var preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                var file = input.files[0];
                if (file.size > 5 * 1024 * 1024) {
                    alert('File quá lớn! Vui lòng chọn ảnh dung lượng dưới 5MB.');
                    input.value = '';
                    preview.classList.add('d-none');
                    return;
                }
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                preview.classList.add('d-none');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Giới hạn số kỳ trả góp theo thời gian thuê: tối đa 1 kỳ cho mỗi 7 ngày thuê
            var startDate = new Date('@Model.NgayBatDau.ToString("yyyy-MM-dd")');
            var endDate = new Date('@Model.NgayKetThuc.ToString("yyyy-MM-dd")');
            var diffMs = endDate.getTime() - startDate.getTime();
            var days = Math.round(diffMs / (1000 * 60 * 60 * 24));
            if (days <= 0) days = 1;

            var maxInstallments = Math.max(1, Math.floor(days / 7));

            var installmentContainer = document.getElementById('installmentContainer');
            var soKyHanInput = document.getElementById('soKyHan') || document.querySelector('[name="soKyHan"]');

            if (soKyHanInput) {
                soKyHanInput.max = maxInstallments;
                soKyHanInput.setAttribute('max', maxInstallments);
                if (soKyHanInput.tagName === 'SELECT') {
                    Array.from(soKyHanInput.options).forEach(function (opt) {
                        if (parseInt(opt.value) > maxInstallments) {
                            opt.disabled = true;
                            opt.hidden = true;
                            opt.style.display = 'none';
                        } else {
                            opt.disabled = false;
                            opt.hidden = false;
                            opt.style.display = '';
                        }
                    });
                }
                var currentVal = parseInt(soKyHanInput.value) || 1;
                if (currentVal > maxInstallments || currentVal < 1) {
                    soKyHanInput.value = '1';
                }
            }

            if (maxInstallments <= 1) {
                if (installmentContainer) installmentContainer.style.display = 'none';
                if (soKyHanInput) soKyHanInput.value = '1';
            } else {
                if (installmentContainer) installmentContainer.style.display = '';
            }

            var canvas = document.getElementById('signature-pad');
            var signaturePad = new SignaturePad(canvas, {
                backgroundColor: 'rgba(255, 255, 255, 0)',
                penColor: 'rgb(0, 0, 0)'
            });

            document.getElementById('clearBtn').addEventListener('click', function () {
                signaturePad.clear();
            });

            document.getElementById('signForm').addEventListener('submit', function (e) {
                if (signaturePad.isEmpty()) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Thiếu chữ ký',
                        text: 'Vui lòng ký tên vào khung chữ ký trước khi hoàn tất!'
                    });
                } else {
                    document.getElementById('signatureData').value = signaturePad.toDataURL();
                }
            });
        });
    </script>
}
