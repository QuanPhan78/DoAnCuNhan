@model IEnumerable<RentalSystem.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal total = Model != null ? Model.Sum(x => x.ThanhTien) : 0;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="mb-4 fw-bold"><i class="fas fa-shopping-cart text-warning me-2"></i> Giỏ hàng thuê máy</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm p-4 text-center">
        <h4>Giỏ hàng của bạn đang trống!</h4>
        <p class="mb-3">Hãy chọn các thiết bị ưng ý để tiến hành đặt thuê nhé.</p>
        <a href="/SanPham" class="btn btn-brand fw-bold px-4"><i class="fas fa-search me-1"></i> Tìm thiết bị ngay</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Giá/Ngày</th>
                                    <th>Số lượng</th>
                                    <th>Tạm tính/Ngày</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-start ps-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "https://via.placeholder.com/50" : item.HinhAnh)" class="rounded" width="50" height="50" style="object-fit: contain; background: #f8f9fa;" />
                                                <div class="ms-3 fw-bold text-dark">@item.TenSanPham</div>
                                            </div>
                                        </td>
                                        <td class="text-danger fw-bold">@item.GiaThueNgay.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center align-items-center">
                                                <input type="hidden" name="id" value="@item.MaSanPham" />
                                                <input type="number" name="qty" value="@item.SoLuong" class="form-control text-center bg-brand text-white fw-bold rounded-pill border-0 shadow-sm" style="width: 70px; -moz-appearance: textfield; appearance: textfield;" min="1" max="99" onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td class="text-danger fw-bolder">@item.ThanhTien.ToString("N0") đ</td>
                                        <td>
                                            <a asp-action="Remove" asp-route-id="@item.MaSanPham" class="btn btn-sm btn-outline-danger shadow-sm">
                                                <i class="fas fa-trash-alt"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow border-0 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng số lượng:</span>
                        <span class="fw-bold">@Model.Sum(x => x.SoLuong) thiết bị</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">Tổng tiền 1 ngày:</span>
                        <span class="fs-5 text-danger fw-bolder">@total.ToString("N0") đ</span>
                    </div>
                    <div class="alert alert-warning border-warning">
                        <small><i class="fas fa-info-circle me-1"></i> Số ngày thuê thực tế sẽ được chọn ở bước thanh toán tiếp theo.</small>
                    </div>
                    
                    <a asp-action="Checkout" class="btn btn-brand btn-lg w-100 fw-bold shadow-sm">
                        <i class="fas fa-check-circle me-1"></i> TIẾN HÀNH ĐẶT MÁY
                    </a>
                </div>
            </div>
        </div>
    </div>
}
