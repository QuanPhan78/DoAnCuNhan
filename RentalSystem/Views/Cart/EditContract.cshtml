@model RentalSystem.Models.HopDong
@{
    ViewData["Title"] = "Chỉnh sửa Đơn Hàng #" + Model.MaHopDong;
}

<div class="container my-4" style="max-width:640px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="MyContracts" class="btn btn-light border me-3"><i class="fas fa-arrow-left"></i></a>
        <h3 class="fw-bold mb-0">Chỉnh sửa Đơn Hàng #@Model.MaHopDong</h3>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border">
        <div class="card-body">
            <form asp-action="EditContract" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaHopDong" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Ngày nhận máy <span class="text-danger">*</span></label>
                    <input type="date" name="NgayBatDau" class="form-control"
                           value="@Model.NgayBatDau.ToString("yyyy-MM-dd")"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ngày trả máy <span class="text-danger">*</span></label>
                    <input type="date" name="NgayKetThuc" class="form-control"
                           value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")"
                           min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ giao hàng / Ghi chú</label>
                    <textarea name="GhiChu" class="form-control" rows="3">@Model.GhiChu</textarea>
                </div>

                <div class="alert alert-light border small">
                    <strong>Lưu ý:</strong> Chỉ có thể chỉnh sửa ngày nhận, ngày trả và địa chỉ giao hàng.
                    Tổng tiền sẽ được tính lại dựa trên số ngày mới.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark fw-bold px-4">Lưu thay đổi</button>
                    <a asp-action="MyContracts" class="btn btn-light border px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
