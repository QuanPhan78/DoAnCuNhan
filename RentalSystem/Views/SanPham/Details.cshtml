@model RentalSystem.Models.SanPham
@{
    ViewData["Title"] = Model.TenSanPham;
    int inStock = ViewBag.InStock ?? 0;
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<RentalSystem.Models.SanPham>;
}

<div class="bg-light py-3 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fas fa-home"></i> Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/SanPham" class="text-decoration-none text-muted">Dịch vụ cho thuê</a></li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@Model.TenSanPham</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container mb-5">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <!-- Hình ảnh sản phẩm -->
            <div class="col-md-5 bg-white p-4 d-flex align-items-center justify-content-center border-end">
                <img src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "https://via.placeholder.com/500" : Model.HinhAnh)" class="img-fluid" alt="@Model.TenSanPham" style="max-height: 400px; object-fit: contain;">
            </div>
            
            <!-- Chi tiết sản phẩm -->
            <div class="col-md-7">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-brand px-3 py-2 rounded-pill shadow-sm">@Model.LoaiThietBi?.TenLoai</span>
                        @if (inStock > 0)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> Sẵn hàng (@inStock máy)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i> Tạm hết hàng</span>
                        }
                    </div>
                    
                    <h2 class="card-title fw-bolder mt-3 mb-3 text-dark">@Model.TenSanPham</h2>
                    
                    <div class="mb-4 bg-light p-3 rounded-3 border-start border-4 border-primary">
                        <span class="text-muted d-block mb-1">Giá thuê tham khảo:</span>
                        <h3 class="text-danger fw-bolder mb-0">@Model.GiaThueNgay.ToString("N0") VNĐ<span class="fs-5 text-muted fw-normal"> / ngày</span></h3>
                    </div>

                    <h5 class="fw-bold mb-3"><i class="fas fa-cogs me-2 text-secondary"></i> Cấu hình thiết bị</h5>
                    <div class="bg-light p-3 rounded-3 mb-4" style="white-space: pre-line; line-height: 1.8;">
                        @Model.CauHinh
                    </div>

                    <div class="d-grid gap-2">
                        @if (inStock > 0)
                        {
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.MaSanPham" class="btn btn-brand btn-lg fw-bold shadow-sm rounded-pill py-3">
                                <i class="fas fa-shopping-cart me-2"></i> THÊM VÀO GIỎ & ĐẶT THUÊ
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-light btn-lg fw-bold shadow-sm rounded-pill py-3" disabled>
                                <i class="fas fa-box-open me-2"></i> HIỆN ĐANG HẾT MÁY
                            </button>
                            <p class="text-muted text-center mt-2 small">Vui lòng liên hệ Hotline 1900 1234 để đặt trước.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Mô tả -->
    <div class="card shadow-sm border-0 rounded-4 mb-5">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <ul class="nav nav-tabs border-bottom-0" id="productTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold text-dark border-0 border-bottom border-primary border-3 bg-transparent fs-5 pb-3" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">
                        <i class="fas fa-info-circle me-1"></i> Thông tin chi tiết
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-5 pt-4">
            <div class="tab-content" id="productTabsContent">
                <div class="tab-pane fade show active" id="desc" role="tabpanel">
                    <div class="fs-6 text-dark" style="white-space: pre-line; line-height: 1.8;">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Đang cập nhật mô tả..." : Model.MoTa)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sản phẩm cùng loại -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <h4 class="fw-bold mb-4 border-start border-4 border-warning ps-3">Các máy cùng cấu hình</h4>
        <div class="row g-4">
            @foreach (var item in relatedProducts)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card">
                        <div class="position-relative text-center bg-light border-bottom">
                            <a href="/SanPham/Details/@item.MaSanPham">
                                <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "https://via.placeholder.com/300" : item.HinhAnh)" class="card-img-top p-3" style="height: 180px; object-fit: contain;" alt="@item.TenSanPham">
                            </a>
                        </div>
                        <div class="card-body p-3 bg-white">
                            <h6 class="card-title fw-bold text-truncate mb-1">
                                <a href="/SanPham/Details/@item.MaSanPham" class="text-dark text-decoration-none">@item.TenSanPham</a>
                            </h6>
                            <p class="text-danger fw-bolder mb-0">@item.GiaThueNgay.ToString("N0") đ/ngày</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .product-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>
