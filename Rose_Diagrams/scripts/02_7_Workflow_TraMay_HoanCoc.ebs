' ==============================================================================
' ROSESCRIPT 02_7: QUY TRINH NGHIEP VU 2.2.2.7 - QUY TRINH 7 - TRA MAY, NGHIEM THU & HOAN TRA TIEN COC
' (02_7_Workflow_Quy_trinh_7_-_Tra_may,_nghiem_thu_Va_Hoan_tra_tien_coc.ebs)
' ------------------------------------------------------------------------------
' Phan mem: IBM Rational Rose 2003 / Enterprise Win32
' De tai: He thong Quan ly Cho thue Thiet bi (RentalSystem) - HUIT 2025
' Quy chuan: Activity Diagram, Sequence Diagram & Collaboration Diagram
' Ngon ngu: 100% Tieng Viet khong dau (Pure ASCII)
' ==============================================================================
Option Explicit


' ------------------------------------------------------------------------------
' TIEN ICH TRO GIUP MO HINH HOA (MODELING HELPER FUNCTIONS)
' ------------------------------------------------------------------------------
Function GetOrCreateCategory(parentCat As Category, catName As String) As Category
    On Error Resume Next
    Dim aCat As Category
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Categories.Count
            Set aCat = parentCat.Categories.GetAt(i)
            If Not aCat Is Nothing Then
                If aCat.Name = catName Then
                    Set GetOrCreateCategory = aCat
                    Exit Function
                End If
            End If
        Next i
        Set GetOrCreateCategory = parentCat.AddCategory(catName)
    End If
End Function

Function GetOrCreateClass(parentCat As Category, clsName As String, st As String, doc As String) As Class
    On Error Resume Next
    Dim aCls As Class
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Classes.Count
            Set aCls = parentCat.Classes.GetAt(i)
            If Not aCls Is Nothing Then
                If aCls.Name = clsName Then
                    Set GetOrCreateClass = aCls
                    If st <> "" Then aCls.Stereotype = st
                    If doc <> "" Then aCls.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aCls = parentCat.AddClass(clsName)
        If Not aCls Is Nothing Then
            If st <> "" Then aCls.Stereotype = st
            If doc <> "" Then aCls.Documentation = doc
        End If
        Set GetOrCreateClass = aCls
    End If
End Function

Function GetOrCreateUseCase(parentCat As Category, ucName As String, st As String, doc As String) As UseCase
    On Error Resume Next
    Dim aUc As UseCase
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.UseCases.Count
            Set aUc = parentCat.UseCases.GetAt(i)
            If Not aUc Is Nothing Then
                If aUc.Name = ucName Then
                    Set GetOrCreateUseCase = aUc
                    If st <> "" Then aUc.Stereotype = st
                    If doc <> "" Then aUc.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aUc = parentCat.AddUseCase(ucName)
        If Not aUc Is Nothing Then
            If st <> "" Then aUc.Stereotype = st
            If doc <> "" Then aUc.Documentation = doc
        End If
        Set GetOrCreateUseCase = aUc
    End If
End Function

Sub SafeAddAssociation(clientCls As Class, supplierName As String)
    On Error Resume Next
    If Not clientCls Is Nothing And supplierName <> "" Then
        clientCls.AddAssociation "", supplierName
    End If
End Sub

Sub SafeAddAttribute(theCls As Class, attrName As String, attrType As String)
    On Error Resume Next
    Dim anAttr As Attribute
    If Not theCls Is Nothing Then
        Set anAttr = theCls.AddAttribute(attrName, attrType, "")
        If Not anAttr Is Nothing Then
            anAttr.ExportControl.Name = "Public"
        End If
    End If
End Sub

Sub SafeAddOperation(theCls As Class, opName As String, returnType As String)
    On Error Resume Next
    Dim anOp As Operation
    If Not theCls Is Nothing Then
        Set anOp = theCls.AddOperation(opName, returnType)
    End If
End Sub


Sub Main
    On Error Resume Next
    Dim theModel As Model
    Dim rootUC As Category
    Dim rootLog As Category
    Dim pkgWorkflows As Category
    Dim targetCat As Category
    
    Set theModel = RoseApp.CurrentModel
    If theModel Is Nothing Then
        MsgBox "Loi: Vui long mo Model trong Rational Rose truoc khi chay!", 16, "Thong bao"
        Exit Sub
    End If
    
    Set rootUC = theModel.RootUseCaseCategory
    Set rootLog = theModel.RootCategory
    Set pkgWorkflows = GetOrCreateCategory(rootUC, "02_Business_Workflows")
    Set targetCat = GetOrCreateCategory(pkgWorkflows, "Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    
    ' 1. Dinh nghia cac phan vung hoat dong (Activity Swimlanes & Steps)
    ' Swimlane: Ky thuat vien
    ' Swimlane: Nhan vien kinh doanh
    ' Swimlane: HopDongControl
    ' Swimlane: Tai chinh
    Dim actSteps As Class
    Set actSteps = GetOrCreateClass(targetCat, "Activity_Workflow_Steps", "utility", "Danh sach cac buoc hoat dong trong Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    SafeAddAttribute actSteps, "Step_1", "Thu hoi may va kiem tra tem serial [Ky thuat vien]"
    SafeAddAttribute actSteps, "Step_2", "Tham dinh hu hai ngoai quan va linh kien [Ky thuat vien]"
    SafeAddAttribute actSteps, "Step_3", "Lap bien ban nghiem thu thu hoi [Ky thuat vien]"
    SafeAddAttribute actSteps, "Step_4", "Giai thuat quyet toan refund = TienCoc - NoThue - PhiDenBu [HopDongControl]"
    SafeAddAttribute actSteps, "Step_5", "Ca bien refund >= 0 - Can tru coc & PhieuChi hoan du [Tai chinh]"
    SafeAddAttribute actSteps, "Step_6", "Ca bien refund < 0 - Tich thu coc & VietQR truy thu [Tai chinh]"
    SafeAddAttribute actSteps, "Step_7", "Hoan tat tat toan hop dong [Nhan vien kinh doanh]"

    ' 2. Khoi tao cac thuc the Lifelines trong so do Tuan tu va Cong tac
    Dim ll_0 As Class
    Set ll_0 = GetOrCreateClass(targetCat, "ktv:KyThuatVien", "business worker", "Ky thuat vien thu hoi va giam dinh")
    Dim ll_1 As Class
    Set ll_1 = GetOrCreateClass(targetCat, "nvkd:KinhDoanh", "business worker", "Kinh doanh lap phieu chi quyet toan")
    Dim ll_2 As Class
    Set ll_2 = GetOrCreateClass(targetCat, "c:HopDongControl", "control", "Thuat toan quyet toan hoan coc")
    Dim ll_3 As Class
    Set ll_3 = GetOrCreateClass(targetCat, "bb:BienBanBanGiao", "entity", "Bien ban nghiem thu tra may")
    Dim ll_4 As Class
    Set ll_4 = GetOrCreateClass(targetCat, "pc:PhieuChi", "entity", "Phieu chi hoan tien coc")
    Dim ll_5 As Class
    Set ll_5 = GetOrCreateClass(targetCat, "hd:HopDong", "entity", "HopDong quyet toan")
    Dim ll_6 As Class
    Set ll_6 = GetOrCreateClass(targetCat, "tb:ThietBi", "entity", "ThietBi hoan ve kho")

    ' 3. Dang ky danh sach Thong diep (Messages Sequence)
    Dim msgRegistry As Class
    Set msgRegistry = GetOrCreateClass(targetCat, "Interaction_Messages_Registry", "utility", "Chuoi thong diep tuong tac trong Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    SafeAddAttribute msgRegistry, "Msg_1", "1: ThuHoiMayVaKiemTraSerial(soSerial)"
    SafeAddAttribute msgRegistry, "Msg_2", "2: ThamDinhHuHaiLinhKien(tinhTrangNgoaiQuan)"
    SafeAddAttribute msgRegistry, "Msg_3", "3: LapBienBanNghiemThu(maBienBan)"
    SafeAddAttribute msgRegistry, "Msg_4", "4: TinhQuyetToanCanTruCoc(tienCoc, noThue, phiDenBu)"
    SafeAddAttribute msgRegistry, "Msg_5", "5: [Ca bien - Refund duong] LapPhieuChiHoanCocDu(soTienHoan)"
    SafeAddAttribute msgRegistry, "Msg_6", "6: [Ca bien - Refund am] TichThuCocVaTruyThu(soTienThieu)"
    SafeAddAttribute msgRegistry, "Msg_7", "7: CapNhatThietBiSanSang0(khoaHoanTat)"

    ' ==========================================================================
    ' XU LY CA BIEN TRONG YEU (EDGE CASE MODELING): Quyet_Toan_Hoan_Coc_DepositSettlement
    ' ==========================================================================
    Dim edgeCaseClass As Class
    Set edgeCaseClass = GetOrCreateClass(targetCat, "EdgeCase_Quyet_Toan_Hoan_Coc_DepositSettlement", "utility", "Quyet toan tat toan: refund = TienCoc - NoThue - PhiDenBu. Neu refund >= 0 thi lap PhieuChi hoan du; neu refund < 0 thi tich thu coc va truy thu")
    SafeAddAttribute edgeCaseClass, "TenCaBien", "Quyet_Toan_Hoan_Coc_DepositSettlement"
    SafeAddAttribute edgeCaseClass, "MoTaXuLy", "Quyet toan tat toan: refund = TienCoc - NoThue - PhiDenBu. Neu refund >= 0 thi lap PhieuChi hoan du; neu refund < 0 thi tich thu coc va truy thu"
    SafeAddOperation edgeCaseClass, "XuLyNgoaiLe_Quyet_Toan_Hoan_Coc_DepositSettlement", "void"

    ' 4. Khoi tao cac so do truc quan
    Dim diagAct As Diagram, diagSeq As Diagram, diagCollab As Diagram
    Set diagAct = targetCat.AddClassDiagram("Activity Diagram - Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    If Not diagAct Is Nothing Then diagAct.Open
    
    Set diagSeq = targetCat.AddClassDiagram("Sequence Diagram - Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    If Not diagSeq Is Nothing Then diagSeq.Open
    
    Set diagCollab = targetCat.AddClassDiagram("Collaboration Diagram - Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc")
    If Not diagCollab Is Nothing Then diagCollab.Open
    
    MsgBox "DA TAO XONG MO HINH QUY TRINH NGHIEP VU: 2.2.2.7!" & vbCrLf & vbCrLf & _
           "- Ten quy trinh: Quy trinh 7 - Tra may, nghiem thu & Hoan tra tien coc" & vbCrLf & _
           "- So buoc hoat dong: 7" & vbCrLf & _
           "- So doi tuong Lifeline: 7" & vbCrLf & _
           "- So thong diep Messages: 7" & vbCrLf & _
           "- Ca bien mo hinh hoa: Quyet_Toan_Hoan_Coc_DepositSettlement", 64, "Hoan thanh Script 02_7"
End Sub
