    ' 4. THIET LAP CAC LIEN KET GIUA BOUNDARY - CONTROL - ENTITY
    ' --------------------------------------------------------------------------
    Dim bDangKy As Class, bDatThue As Class, bThanhToan As Class, bBanGiao As Class
    Dim bSuCo As Class, bPhanCong As Class, bGiaHan As Class, bSoNo As Class
    
    Set bDangKy = GetOrCreateClass(pkgBound, "DangKyView", "boundary", "")
    Set bDatThue = GetOrCreateClass(pkgBound, "DatThueView", "boundary", "")
    Set bThanhToan = GetOrCreateClass(pkgBound, "ThanhToanView", "boundary", "")
    Set bBanGiao = GetOrCreateClass(pkgBound, "BanGiaoView", "boundary", "")
    Set bSuCo = GetOrCreateClass(pkgBound, "SuCoTicketView", "boundary", "")
    Set bPhanCong = GetOrCreateClass(pkgBound, "PhanCongBaoTriView", "boundary", "")
    Set bGiaHan = GetOrCreateClass(pkgBound, "GiaHanView", "boundary", "")
    Set bSoNo = GetOrCreateClass(pkgBound, "SoCongNoView", "boundary", "")
    
    SafeAddAssociation bDangKy, "AccountControl"
    SafeAddAssociation cAccount, "NguoiDung"
    
    SafeAddAssociation bDatThue, "CartControl"
    SafeAddAssociation cCart, "ThietBi"
    SafeAddAssociation cCart, "HopDong"
    
    SafeAddAssociation bThanhToan, "PaymentControl"
    SafeAddAssociation cPayment, "PhieuThu"
    SafeAddAssociation cPayment, "HopDong"
    
    SafeAddAssociation bBanGiao, "HopDongControl"
    SafeAddAssociation cHopDong, "BienBanBanGiao"
    SafeAddAssociation cHopDong, "ThietBi"
    SafeAddAssociation cHopDong, "PhieuChi"
    
    SafeAddAssociation bSuCo, "BaoTriControl"
    SafeAddAssociation cBaoTri, "PhieuBaoTri"
    
    SafeAddAssociation bPhanCong, "PhanCongControl"
    SafeAddAssociation cPhanCong, "PhanCongCongViec"
    
    SafeAddAssociation bGiaHan, "CongNoControl"
    SafeAddAssociation bSoNo, "CongNoControl"
    SafeAddAssociation cCongNo, "YeuCauGiaHan"
    SafeAddAssociation cCongNo, "KyHanThanhToan"
    
    ' Entity to Entity
    SafeAddAssociation eVaiTro, "NguoiDung"
    SafeAddAssociation eLoaiThietBi, "SanPham"
    SafeAddAssociation eSanPham, "ThietBi"
    SafeAddAssociation eHopDong, "ChiTietHopDong"
    SafeAddAssociation eChiTietHopDong, "ThietBi"
    SafeAddAssociation eHopDong, "KyHanThanhToan"
    SafeAddAssociation eHopDong, "PhieuThu"
    SafeAddAssociation eHopDong, "PhieuChi"
    SafeAddAssociation eHopDong, "PhieuBaoTri"
    SafeAddAssociation eThietBi, "LichSuThietBi"
    
    ' 5. Tao va mo so do BCE Analysis Class Diagram
    Dim diagBCE As Diagram
    Set diagBCE = pkgBCE.AddClassDiagram("BCE Analysis Class Diagram")
    If Not diagBCE Is Nothing Then diagBCE.Activate
    
    MsgBox "Da tao xong toan bo lop phan tich BCE!"
End Sub
