' ==============================================================================
' ROSESCRIPT 02_3: QUY TRINH NGHIEP VU 2.2.2.3 - QUY TRINH 3 - THANH TOAN DAT COC QUA VIETQR DONG
' (02_3_Workflow_Quy_trinh_3_-_Thanh_toan_dat_coc_qua_VietQR_dong.ebs)
' ------------------------------------------------------------------------------
' Phan mem: IBM Rational Rose 2003 / Enterprise Win32
' De tai: He thong Quan ly Cho thue Thiet bi (RentalSystem) - HUIT 2025
' Quy chuan: Activity Diagram, Sequence Diagram & Collaboration Diagram
' Ngon ngu: 100% Tieng Viet khong dau (Pure ASCII)
' ==============================================================================
Option Explicit


' ------------------------------------------------------------------------------
' TIEN ICH TRO GIUP MO HINH HOA (MODELING HELPER FUNCTIONS)
' ------------------------------------------------------------------------------
Function GetOrCreateCategory(parentCat As Category, catName As String) As Category
    On Error Resume Next
    Dim aCat As Category
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Categories.Count
            Set aCat = parentCat.Categories.GetAt(i)
            If Not aCat Is Nothing Then
                If aCat.Name = catName Then
                    Set GetOrCreateCategory = aCat
                    Exit Function
                End If
            End If
        Next i
        Set GetOrCreateCategory = parentCat.AddCategory(catName)
    End If
End Function

Function GetOrCreateClass(parentCat As Category, clsName As String, st As String, doc As String) As Class
    On Error Resume Next
    Dim aCls As Class
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Classes.Count
            Set aCls = parentCat.Classes.GetAt(i)
            If Not aCls Is Nothing Then
                If aCls.Name = clsName Then
                    Set GetOrCreateClass = aCls
                    If st <> "" Then aCls.Stereotype = st
                    If doc <> "" Then aCls.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aCls = parentCat.AddClass(clsName)
        If Not aCls Is Nothing Then
            If st <> "" Then aCls.Stereotype = st
            If doc <> "" Then aCls.Documentation = doc
        End If
        Set GetOrCreateClass = aCls
    End If
End Function

Function GetOrCreateUseCase(parentCat As Category, ucName As String, st As String, doc As String) As UseCase
    On Error Resume Next
    Dim aUc As UseCase
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.UseCases.Count
            Set aUc = parentCat.UseCases.GetAt(i)
            If Not aUc Is Nothing Then
                If aUc.Name = ucName Then
                    Set GetOrCreateUseCase = aUc
                    If st <> "" Then aUc.Stereotype = st
                    If doc <> "" Then aUc.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aUc = parentCat.AddUseCase(ucName)
        If Not aUc Is Nothing Then
            If st <> "" Then aUc.Stereotype = st
            If doc <> "" Then aUc.Documentation = doc
        End If
        Set GetOrCreateUseCase = aUc
    End If
End Function

Sub SafeAddAssociation(clientCls As Class, supplierName As String)
    On Error Resume Next
    If Not clientCls Is Nothing And supplierName <> "" Then
        clientCls.AddAssociation "", supplierName
    End If
End Sub

Sub SafeAddAttribute(theCls As Class, attrName As String, attrType As String)
    On Error Resume Next
    Dim anAttr As Attribute
    If Not theCls Is Nothing Then
        Set anAttr = theCls.AddAttribute(attrName, attrType, "")
        If Not anAttr Is Nothing Then
            anAttr.ExportControl.Name = "Public"
        End If
    End If
End Sub

Sub SafeAddOperation(theCls As Class, opName As String, returnType As String)
    On Error Resume Next
    Dim anOp As Operation
    If Not theCls Is Nothing Then
        Set anOp = theCls.AddOperation(opName, returnType)
    End If
End Sub


Sub Main
    On Error Resume Next
    Dim theModel As Model
    Dim rootUC As Category
    Dim rootLog As Category
    Dim pkgWorkflows As Category
    Dim targetCat As Category
    
    Set theModel = RoseApp.CurrentModel
    If theModel Is Nothing Then
        MsgBox "Loi: Vui long mo Model trong Rational Rose truoc khi chay!", 16, "Thong bao"
        Exit Sub
    End If
    
    Set rootUC = theModel.RootUseCaseCategory
    Set rootLog = theModel.RootCategory
    Set pkgWorkflows = GetOrCreateCategory(rootUC, "02_Business_Workflows")
    Set targetCat = GetOrCreateCategory(pkgWorkflows, "Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    
    ' 1. Dinh nghia cac phan vung hoat dong (Activity Swimlanes & Steps)
    ' Swimlane: Khach hang
    ' Swimlane: Ngan hang / VietQR
    ' Swimlane: PaymentControl
    ' Swimlane: He thong
    Dim actSteps As Class
    Set actSteps = GetOrCreateClass(targetCat, "Activity_Workflow_Steps", "utility", "Danh sach cac buoc hoat dong trong Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    SafeAddAttribute actSteps, "Step_1", "Quet ma VietQR dong NAPAS 247 [Khach hang]"
    SafeAddAttribute actSteps, "Step_2", "Chuyen khoan xac nhan [Ngan hang / VietQR]"
    SafeAddAttribute actSteps, "Step_3", "Phat tin hieu Banking Webhook [Ngan hang / VietQR]"
    SafeAddAttribute actSteps, "Step_4", "Mo PaymentLock dong bo [PaymentControl]"
    SafeAddAttribute actSteps, "Step_5", "Kiem tra transferAmount so voi TienCoc [PaymentControl]"
    SafeAddAttribute actSteps, "Step_6", "Ca bien Coc thieu - Tao PhieuThu do dang & Giu 24h [He thong]"
    SafeAddAttribute actSteps, "Step_7", "Coc du - Gach no & HopDong.TrangThai = 1 [He thong]"

    ' 2. Khoi tao cac thuc the Lifelines trong so do Tuan tu va Cong tac
    Dim ll_0 As Class
    Set ll_0 = GetOrCreateClass(targetCat, "kh:Khach hang", "business actor", "Khach hang quet ma QR thanh toan")
    Dim ll_1 As Class
    Set ll_1 = GetOrCreateClass(targetCat, "mb:NganHang", "actor", "Cong VietQR NAPAS 247 va Ngan hang")
    Dim ll_2 As Class
    Set ll_2 = GetOrCreateClass(targetCat, "c:PaymentControl", "control", "Tiep nhan Webhook va PaymentLock")
    Dim ll_3 As Class
    Set ll_3 = GetOrCreateClass(targetCat, "pt:PhieuThu", "entity", "Thuc the phieu thu thanh toan")
    Dim ll_4 As Class
    Set ll_4 = GetOrCreateClass(targetCat, "hd:HopDong", "entity", "Thuc the hop dong thue")

    ' 3. Dang ky danh sach Thong diep (Messages Sequence)
    Dim msgRegistry As Class
    Set msgRegistry = GetOrCreateClass(targetCat, "Interaction_Messages_Registry", "utility", "Chuoi thong diep tuong tac trong Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    SafeAddAttribute msgRegistry, "Msg_1", "1: QuetMaVietQRDong(maHopDong, soTienCoc)"
    SafeAddAttribute msgRegistry, "Msg_2", "2: GuiTinHieuWebhook(maGiaoDich, transferAmount, noiDung)"
    SafeAddAttribute msgRegistry, "Msg_3", "3: KichHoatPaymentLock(SemaphoreSlim)"
    SafeAddAttribute msgRegistry, "Msg_4", "4: KiemTraSoTienNhan(transferAmount, tienCocBaoDam)"
    SafeAddAttribute msgRegistry, "Msg_5", "5: [Ca bien - Coc thieu] TaoPhieuThuDoDangGiuCho24h(transferAmount)"
    SafeAddAttribute msgRegistry, "Msg_6", "6: [Coc du] GachNoVaXacNhanTrangThai1(daCocDu)"
    SafeAddAttribute msgRegistry, "Msg_7", "7: ThongBaoXacNhanThanhToan(ketQuaThanhToan)"

    ' ==========================================================================
    ' XU LY CA BIEN TRONG YEU (EDGE CASE MODELING): Coc_Thieu_InsufficientDeposit
    ' ==========================================================================
    Dim edgeCaseClass As Class
    Set edgeCaseClass = GetOrCreateClass(targetCat, "EdgeCase_Coc_Thieu_InsufficientDeposit", "utility", "Khach chuyen thieu tien coc: Tao PhieuThu do dang, giu HopDong o TrangThai=0, nhac no han chot 24h truoc khi giai phong may")
    SafeAddAttribute edgeCaseClass, "TenCaBien", "Coc_Thieu_InsufficientDeposit"
    SafeAddAttribute edgeCaseClass, "MoTaXuLy", "Khach chuyen thieu tien coc: Tao PhieuThu do dang, giu HopDong o TrangThai=0, nhac no han chot 24h truoc khi giai phong may"
    SafeAddOperation edgeCaseClass, "XuLyNgoaiLe_Coc_Thieu_InsufficientDeposit", "void"

    ' 4. Khoi tao cac so do truc quan
    Dim diagAct As Diagram, diagSeq As Diagram, diagCollab As Diagram
    Set diagAct = targetCat.AddClassDiagram("Activity Diagram - Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    If Not diagAct Is Nothing Then diagAct.Open
    
    Set diagSeq = targetCat.AddClassDiagram("Sequence Diagram - Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    If Not diagSeq Is Nothing Then diagSeq.Open
    
    Set diagCollab = targetCat.AddClassDiagram("Collaboration Diagram - Quy trinh 3 - Thanh toan dat coc qua VietQR dong")
    If Not diagCollab Is Nothing Then diagCollab.Open
    
    MsgBox "DA TAO XONG MO HINH QUY TRINH NGHIEP VU: 2.2.2.3!" & vbCrLf & vbCrLf & _
           "- Ten quy trinh: Quy trinh 3 - Thanh toan dat coc qua VietQR dong" & vbCrLf & _
           "- So buoc hoat dong: 7" & vbCrLf & _
           "- So doi tuong Lifeline: 5" & vbCrLf & _
           "- So thong diep Messages: 7" & vbCrLf & _
           "- Ca bien mo hinh hoa: Coc_Thieu_InsufficientDeposit", 64, "Hoan thanh Script 02_3"
End Sub
