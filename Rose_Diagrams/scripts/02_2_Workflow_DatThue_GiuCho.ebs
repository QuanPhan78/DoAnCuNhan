' ==============================================================================
' ROSESCRIPT 02_2: QUY TRINH NGHIEP VU 2.2.2.2 - QUY TRINH 2 - DAT THUE MAY & KIEM TRA TON KHO
' (02_2_Workflow_Quy_trinh_2_-_Dat_thue_may_Va_Kiem_tra_ton_kho.ebs)
' ------------------------------------------------------------------------------
' Phan mem: IBM Rational Rose 2003 / Enterprise Win32
' De tai: He thong Quan ly Cho thue Thiet bi (RentalSystem) - HUIT 2025
' Quy chuan: Activity Diagram, Sequence Diagram & Collaboration Diagram
' Ngon ngu: 100% Tieng Viet khong dau (Pure ASCII)
' ==============================================================================
Option Explicit


' ------------------------------------------------------------------------------
' TIEN ICH TRO GIUP MO HINH HOA (MODELING HELPER FUNCTIONS)
' ------------------------------------------------------------------------------
Function GetOrCreateCategory(parentCat As Category, catName As String) As Category
    On Error Resume Next
    Dim aCat As Category
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Categories.Count
            Set aCat = parentCat.Categories.GetAt(i)
            If Not aCat Is Nothing Then
                If aCat.Name = catName Then
                    Set GetOrCreateCategory = aCat
                    Exit Function
                End If
            End If
        Next i
        Set GetOrCreateCategory = parentCat.AddCategory(catName)
    End If
End Function

Function GetOrCreateClass(parentCat As Category, clsName As String, st As String, doc As String) As Class
    On Error Resume Next
    Dim aCls As Class
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Classes.Count
            Set aCls = parentCat.Classes.GetAt(i)
            If Not aCls Is Nothing Then
                If aCls.Name = clsName Then
                    Set GetOrCreateClass = aCls
                    If st <> "" Then aCls.Stereotype = st
                    If doc <> "" Then aCls.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aCls = parentCat.AddClass(clsName)
        If Not aCls Is Nothing Then
            If st <> "" Then aCls.Stereotype = st
            If doc <> "" Then aCls.Documentation = doc
        End If
        Set GetOrCreateClass = aCls
    End If
End Function

Function GetOrCreateUseCase(parentCat As Category, ucName As String, st As String, doc As String) As UseCase
    On Error Resume Next
    Dim aUc As UseCase
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.UseCases.Count
            Set aUc = parentCat.UseCases.GetAt(i)
            If Not aUc Is Nothing Then
                If aUc.Name = ucName Then
                    Set GetOrCreateUseCase = aUc
                    If st <> "" Then aUc.Stereotype = st
                    If doc <> "" Then aUc.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aUc = parentCat.AddUseCase(ucName)
        If Not aUc Is Nothing Then
            If st <> "" Then aUc.Stereotype = st
            If doc <> "" Then aUc.Documentation = doc
        End If
        Set GetOrCreateUseCase = aUc
    End If
End Function

Sub SafeAddAssociation(clientCls As Class, supplierName As String)
    On Error Resume Next
    If Not clientCls Is Nothing And supplierName <> "" Then
        clientCls.AddAssociation "", supplierName
    End If
End Sub

Sub SafeAddAttribute(theCls As Class, attrName As String, attrType As String)
    On Error Resume Next
    Dim anAttr As Attribute
    If Not theCls Is Nothing Then
        Set anAttr = theCls.AddAttribute(attrName, attrType, "")
        If Not anAttr Is Nothing Then
            anAttr.ExportControl.Name = "Public"
        End If
    End If
End Sub

Sub SafeAddOperation(theCls As Class, opName As String, returnType As String)
    On Error Resume Next
    Dim anOp As Operation
    If Not theCls Is Nothing Then
        Set anOp = theCls.AddOperation(opName, returnType)
    End If
End Sub


Sub Main
    On Error Resume Next
    Dim theModel As Model
    Dim rootUC As Category
    Dim rootLog As Category
    Dim pkgWorkflows As Category
    Dim targetCat As Category
    
    Set theModel = RoseApp.CurrentModel
    If theModel Is Nothing Then
        MsgBox "Loi: Vui long mo Model trong Rational Rose truoc khi chay!", 16, "Thong bao"
        Exit Sub
    End If
    
    Set rootUC = theModel.RootUseCaseCategory
    Set rootLog = theModel.RootCategory
    Set pkgWorkflows = GetOrCreateCategory(rootUC, "02_Business_Workflows")
    Set targetCat = GetOrCreateCategory(pkgWorkflows, "Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    
    ' 1. Dinh nghia cac phan vung hoat dong (Activity Swimlanes & Steps)
    ' Swimlane: Khach hang
    ' Swimlane: CartControl
    ' Swimlane: ApplicationDbContext
    Dim actSteps As Class
    Set actSteps = GetOrCreateClass(targetCat, "Activity_Workflow_Steps", "utility", "Danh sach cac buoc hoat dong trong Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    SafeAddAttribute actSteps, "Step_1", "Chon may va thoi han thue [Khach hang]"
    SafeAddAttribute actSteps, "Step_2", "Kich hoat khoa InventoryLock (SemaphoreSlim) [CartControl]"
    SafeAddAttribute actSteps, "Step_3", "Kiem tra lich trong thiet bi serial [ApplicationDbContext]"
    SafeAddAttribute actSteps, "Step_4", "Giu cho thiet bi 24h HanChotKy [ApplicationDbContext]"
    SafeAddAttribute actSteps, "Step_5", "Giai phong khoa SemaphoreSlim [CartControl]"
    SafeAddAttribute actSteps, "Step_6", "Xac nhan giu cho thanh cong [Khach hang]"

    ' 2. Khoi tao cac thuc the Lifelines trong so do Tuan tu va Cong tac
    Dim ll_0 As Class
    Set ll_0 = GetOrCreateClass(targetCat, "kh:Khach hang", "business actor", "Khach hang chon thue may")
    Dim ll_1 As Class
    Set ll_1 = GetOrCreateClass(targetCat, "v:DatThueView", "boundary", "Giao dien chon may va ngay thue")
    Dim ll_2 As Class
    Set ll_2 = GetOrCreateClass(targetCat, "c:CartControl", "control", "Dieu phoi gio hang va SemaphoreSlim")
    Dim ll_3 As Class
    Set ll_3 = GetOrCreateClass(targetCat, "tb:ThietBi", "entity", "Thuc the thiet bi serial")
    Dim ll_4 As Class
    Set ll_4 = GetOrCreateClass(targetCat, "hd:HopDong", "entity", "Thuc the hop dong giu cho")

    ' 3. Dang ky danh sach Thong diep (Messages Sequence)
    Dim msgRegistry As Class
    Set msgRegistry = GetOrCreateClass(targetCat, "Interaction_Messages_Registry", "utility", "Chuoi thong diep tuong tac trong Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    SafeAddAttribute msgRegistry, "Msg_1", "1: ChonMayVaNgayThue(maSanPham, tuNgay, denNgay)"
    SafeAddAttribute msgRegistry, "Msg_2", "2: KichHoatKhoaInventoryLock(SemaphoreSlim)"
    SafeAddAttribute msgRegistry, "Msg_3", "3: KiemTraLichTrongSerial(maSanPham, tuNgay, denNgay)"
    SafeAddAttribute msgRegistry, "Msg_4", "4: CapNhatTrangThaiGiuCho3(maThietBi, hanChotKy24h)"
    SafeAddAttribute msgRegistry, "Msg_5", "5: TaoDonThueGiuCho24h(maHopDong, trangThai0)"
    SafeAddAttribute msgRegistry, "Msg_6", "6: GiaiPhongKhoaInventoryLock()"
    SafeAddAttribute msgRegistry, "Msg_7", "7: ThongBaoGiuChoThanhCong(maHopDong, hanChot24h)"

    ' 4. Khoi tao cac so do truc quan
    Dim diagAct As Diagram, diagSeq As Diagram, diagCollab As Diagram
    Set diagAct = targetCat.AddClassDiagram("Activity Diagram - Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    If Not diagAct Is Nothing Then diagAct.Open
    
    Set diagSeq = targetCat.AddClassDiagram("Sequence Diagram - Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    If Not diagSeq Is Nothing Then diagSeq.Open
    
    Set diagCollab = targetCat.AddClassDiagram("Collaboration Diagram - Quy trinh 2 - Dat thue may & Kiem tra ton kho")
    If Not diagCollab Is Nothing Then diagCollab.Open
    
    MsgBox "DA TAO XONG MO HINH QUY TRINH NGHIEP VU: 2.2.2.2!" & vbCrLf & vbCrLf & _
           "- Ten quy trinh: Quy trinh 2 - Dat thue may & Kiem tra ton kho" & vbCrLf & _
           "- So buoc hoat dong: 6" & vbCrLf & _
           "- So doi tuong Lifeline: 5" & vbCrLf & _
           "- So thong diep Messages: 7" & vbCrLf & _
           "- Ca bien mo hinh hoa: Khong co", 64, "Hoan thanh Script 02_2"
End Sub
