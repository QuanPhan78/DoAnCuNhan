' ==============================================================================
' ROSESCRIPT 02_6: QUY TRINH NGHIEP VU 2.2.2.6 - QUY TRINH 6 - GIA HAN HOP DONG & PHAN KY NO
' (02_6_Workflow_Quy_trinh_6_-_Gia_han_hop_dong_Va_Phan_ky_no.ebs)
' ------------------------------------------------------------------------------
' Phan mem: IBM Rational Rose 2003 / Enterprise Win32
' De tai: He thong Quan ly Cho thue Thiet bi (RentalSystem) - HUIT 2025
' Quy chuan: Activity Diagram, Sequence Diagram & Collaboration Diagram
' Ngon ngu: 100% Tieng Viet khong dau (Pure ASCII)
' ==============================================================================
Option Explicit


' ------------------------------------------------------------------------------
' TIEN ICH TRO GIUP MO HINH HOA (MODELING HELPER FUNCTIONS)
' ------------------------------------------------------------------------------
Function GetOrCreateCategory(parentCat As Category, catName As String) As Category
    On Error Resume Next
    Dim aCat As Category
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Categories.Count
            Set aCat = parentCat.Categories.GetAt(i)
            If Not aCat Is Nothing Then
                If aCat.Name = catName Then
                    Set GetOrCreateCategory = aCat
                    Exit Function
                End If
            End If
        Next i
        Set GetOrCreateCategory = parentCat.AddCategory(catName)
    End If
End Function

Function GetOrCreateClass(parentCat As Category, clsName As String, st As String, doc As String) As Class
    On Error Resume Next
    Dim aCls As Class
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.Classes.Count
            Set aCls = parentCat.Classes.GetAt(i)
            If Not aCls Is Nothing Then
                If aCls.Name = clsName Then
                    Set GetOrCreateClass = aCls
                    If st <> "" Then aCls.Stereotype = st
                    If doc <> "" Then aCls.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aCls = parentCat.AddClass(clsName)
        If Not aCls Is Nothing Then
            If st <> "" Then aCls.Stereotype = st
            If doc <> "" Then aCls.Documentation = doc
        End If
        Set GetOrCreateClass = aCls
    End If
End Function

Function GetOrCreateUseCase(parentCat As Category, ucName As String, st As String, doc As String) As UseCase
    On Error Resume Next
    Dim aUc As UseCase
    Dim i As Integer
    If Not parentCat Is Nothing Then
        For i = 1 To parentCat.UseCases.Count
            Set aUc = parentCat.UseCases.GetAt(i)
            If Not aUc Is Nothing Then
                If aUc.Name = ucName Then
                    Set GetOrCreateUseCase = aUc
                    If st <> "" Then aUc.Stereotype = st
                    If doc <> "" Then aUc.Documentation = doc
                    Exit Function
                End If
            End If
        Next i
        Set aUc = parentCat.AddUseCase(ucName)
        If Not aUc Is Nothing Then
            If st <> "" Then aUc.Stereotype = st
            If doc <> "" Then aUc.Documentation = doc
        End If
        Set GetOrCreateUseCase = aUc
    End If
End Function

Sub SafeAddAssociation(clientCls As Class, supplierName As String)
    On Error Resume Next
    If Not clientCls Is Nothing And supplierName <> "" Then
        clientCls.AddAssociation "", supplierName
    End If
End Sub

Sub SafeAddAttribute(theCls As Class, attrName As String, attrType As String)
    On Error Resume Next
    Dim anAttr As Attribute
    If Not theCls Is Nothing Then
        Set anAttr = theCls.AddAttribute(attrName, attrType, "")
        If Not anAttr Is Nothing Then
            anAttr.ExportControl.Name = "Public"
        End If
    End If
End Sub

Sub SafeAddOperation(theCls As Class, opName As String, returnType As String)
    On Error Resume Next
    Dim anOp As Operation
    If Not theCls Is Nothing Then
        Set anOp = theCls.AddOperation(opName, returnType)
    End If
End Sub


Sub Main
    On Error Resume Next
    Dim theModel As Model
    Dim rootUC As Category
    Dim rootLog As Category
    Dim pkgWorkflows As Category
    Dim targetCat As Category
    
    Set theModel = RoseApp.CurrentModel
    If theModel Is Nothing Then
        MsgBox "Loi: Vui long mo Model trong Rational Rose truoc khi chay!", 16, "Thong bao"
        Exit Sub
    End If
    
    Set rootUC = theModel.RootUseCaseCategory
    Set rootLog = theModel.RootCategory
    Set pkgWorkflows = GetOrCreateCategory(rootUC, "02_Business_Workflows")
    Set targetCat = GetOrCreateCategory(pkgWorkflows, "Quy trinh 6 - Gia han hop dong & Phan ky no")
    
    ' 1. Dinh nghia cac phan vung hoat dong (Activity Swimlanes & Steps)
    ' Swimlane: Khach hang
    ' Swimlane: Nhan vien kinh doanh
    ' Swimlane: CongNoControl
    ' Swimlane: He thong
    Dim actSteps As Class
    Set actSteps = GetOrCreateClass(targetCat, "Activity_Workflow_Steps", "utility", "Danh sach cac buoc hoat dong trong Quy trinh 6 - Gia han hop dong & Phan ky no")
    SafeAddAttribute actSteps, "Step_1", "Gui yeu cau gia han them thoi gian [Khach hang]"
    SafeAddAttribute actSteps, "Step_2", "Kiem tra xung dot don dat ke tiep [He thong]"
    SafeAddAttribute actSteps, "Step_3", "Kinh doanh tham dinh va phe duyet [Nhan vien kinh doanh]"
    SafeAddAttribute actSteps, "Step_4", "Chia ky han cong no bo sung [CongNoControl]"
    SafeAddAttribute actSteps, "Step_5", "Ca bien Tre han - An han 3 ngay tu dong [He thong]"
    SafeAddAttribute actSteps, "Step_6", "Ca bien Tre han - Phat 0.1%/ngay tu ngay 4 [CongNoControl]"
    SafeAddAttribute actSteps, "Step_7", "Ca bien Tre han - Khoa tai khoan ngay 15 & Khoi kien >30 ngay [He thong]"

    ' 2. Khoi tao cac thuc the Lifelines trong so do Tuan tu va Cong tac
    Dim ll_0 As Class
    Set ll_0 = GetOrCreateClass(targetCat, "kh:KhachHang", "business actor", "Khach hang de xuat gia han")
    Dim ll_1 As Class
    Set ll_1 = GetOrCreateClass(targetCat, "nvkd:KinhDoanh", "business worker", "Nhan vien kinh doanh phe duyet")
    Dim ll_2 As Class
    Set ll_2 = GetOrCreateClass(targetCat, "c:CongNoControl", "control", "Dieu phoi phan ky no va tinh phat")
    Dim ll_3 As Class
    Set ll_3 = GetOrCreateClass(targetCat, "ygh:YeuCauGiaHan", "entity", "Thuc the yeu cau gia han")
    Dim ll_4 As Class
    Set ll_4 = GetOrCreateClass(targetCat, "kht:KyHanThanhToan", "entity", "Thuc the ky han cong no")

    ' 3. Dang ky danh sach Thong diep (Messages Sequence)
    Dim msgRegistry As Class
    Set msgRegistry = GetOrCreateClass(targetCat, "Interaction_Messages_Registry", "utility", "Chuoi thong diep tuong tac trong Quy trinh 6 - Gia han hop dong & Phan ky no")
    SafeAddAttribute msgRegistry, "Msg_1", "1: DeXuatGiaHanHopDong(maHopDong, soNgayGiaHan)"
    SafeAddAttribute msgRegistry, "Msg_2", "2: KiemTraLichVaDuyetGiaHan(maYeuCau)"
    SafeAddAttribute msgRegistry, "Msg_3", "3: PhanKyCongNoMoi(soKyHanBoSung)"
    SafeAddAttribute msgRegistry, "Msg_4", "4: SinhCacKyHanThanhToan(lichThanhToanMoi)"
    SafeAddAttribute msgRegistry, "Msg_5", "5: [Ca bien - Tre han] TinhPhat0.1PhanTram(daysPastDue, unpaidAmount)"
    SafeAddAttribute msgRegistry, "Msg_6", "6: [Ca bien - Tre han qua 15 ngay] KhoaTaiKhoanBlacklist(maKhachHang)"
    SafeAddAttribute msgRegistry, "Msg_7", "7: ThongBaoKeHoachTraNo(chiTietKyHan)"

    ' ==========================================================================
    ' XU LY CA BIEN TRONG YEU (EDGE CASE MODELING): Tre_Han_Khong_Tra_May_OverdueRetention
    ' ==========================================================================
    Dim edgeCaseClass As Class
    Set edgeCaseClass = GetOrCreateClass(targetCat, "EdgeCase_Tre_Han_Khong_Tra_May_OverdueRetention", "utility", "Qua han khong tra may: An han 3 ngay tu dong, phat 0.1%/ngay tu ngay 4, khoa tai khoan blacklist ngay 15, khoi kien sau 30 ngay")
    SafeAddAttribute edgeCaseClass, "TenCaBien", "Tre_Han_Khong_Tra_May_OverdueRetention"
    SafeAddAttribute edgeCaseClass, "MoTaXuLy", "Qua han khong tra may: An han 3 ngay tu dong, phat 0.1%/ngay tu ngay 4, khoa tai khoan blacklist ngay 15, khoi kien sau 30 ngay"
    SafeAddOperation edgeCaseClass, "XuLyNgoaiLe_Tre_Han_Khong_Tra_May_OverdueRetention", "void"

    ' 4. Khoi tao cac so do truc quan
    Dim diagAct As Diagram, diagSeq As Diagram, diagCollab As Diagram
    Set diagAct = targetCat.AddClassDiagram("Activity Diagram - Quy trinh 6 - Gia han hop dong & Phan ky no")
    If Not diagAct Is Nothing Then diagAct.Open
    
    Set diagSeq = targetCat.AddClassDiagram("Sequence Diagram - Quy trinh 6 - Gia han hop dong & Phan ky no")
    If Not diagSeq Is Nothing Then diagSeq.Open
    
    Set diagCollab = targetCat.AddClassDiagram("Collaboration Diagram - Quy trinh 6 - Gia han hop dong & Phan ky no")
    If Not diagCollab Is Nothing Then diagCollab.Open
    
    MsgBox "DA TAO XONG MO HINH QUY TRINH NGHIEP VU: 2.2.2.6!" & vbCrLf & vbCrLf & _
           "- Ten quy trinh: Quy trinh 6 - Gia han hop dong & Phan ky no" & vbCrLf & _
           "- So buoc hoat dong: 7" & vbCrLf & _
           "- So doi tuong Lifeline: 5" & vbCrLf & _
           "- So thong diep Messages: 7" & vbCrLf & _
           "- Ca bien mo hinh hoa: Tre_Han_Khong_Tra_May_OverdueRetention", 64, "Hoan thanh Script 02_6"
End Sub
