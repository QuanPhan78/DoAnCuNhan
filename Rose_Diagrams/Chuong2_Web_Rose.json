    {"first":17,"title":"Gia han hop dong","ucs":"UC-09","lanes":["Khach hang","He thong Web","Nguoi duyet"],"nodes":[{"id":"s","row":0,"lane":0,"track":0,"kind":"start","label":""},{"id":"request","row":1,"lane":0,"track":0,"kind":"activity","label":"Nhap so ngay va ly do"},{"id":"first","row":2,"lane":1,"track":0,"kind":"decision","label":"Hop dong va lich hop le?"},{"id":"bad","row":2,"lane":1,"track":1,"kind":"activity","label":"Bao loi khi gui"},{"id":"pending","row":3,"lane":1,"track":0,"kind":"activity","label":"Ghi yeu cau cho duyet"},{"id":"decision","row":4,"lane":2,"track":0,"kind":"decision","label":"Chap nhan?"},{"id":"reject","row":5,"lane":2,"track":1,"kind":"activity","label":"Ghi quyet dinh tu choi"},{"id":"again","row":5,"lane":1,"track":0,"kind":"decision","label":"Lich van con trong?"},{"id":"conflict","row":5,"lane":1,"track":1,"kind":"activity","label":"Bao xung dot lich"},{"id":"new","row":6,"lane":1,"track":0,"kind":"activity","label":"Doi ngay va them ky thu"},{"id":"show","row":7,"lane":0,"track":0,"kind":"activity","label":"Xem trang thai yeu cau"},{"id":"e","row":8,"lane":0,"track":0,"kind":"final","label":""}],"edges":[{"from":"s","to":"request","guard":""},{"from":"request","to":"first","guard":""},{"from":"first","to":"bad","guard":"Khong"},{"from":"first","to":"pending","guard":"Co"},{"from":"pending","to":"decision","guard":""},{"from":"decision","to":"reject","guard":"Tu choi"},{"from":"decision","to":"again","guard":"Chap nhan"},{"from":"again","to":"conflict","guard":"Khong"},{"from":"again","to":"new","guard":"Co"},{"from":"reject","to":"show","guard":""},{"from":"new","to":"show","guard":""},{"from":"show","to":"e","guard":""},{"from":"bad","to":"e","guard":""},{"from":"conflict","to":"e","guard":""}],"parties":{"user":"Khach hang","ui":"Trang gia han Web","ctrl":"Xu ly gia han","db":"Co so du lieu","staff":"Nguoi duyet gia han"},"messages":[{"from":"user","to":"ui","label":"Gui so ngay va ly do gia han","kind":"call"},{"from":"