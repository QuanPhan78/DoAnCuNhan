{
  "actors": {"KH":"Khach hang","KD":"Nhan vien kinh doanh","KT":"Ky thuat vien","QT":"Quan tri vien","TT":"Dich vu thanh toan"},
  "cases": [
    ["01","Dang ky tai khoan",["KH"],"Ho ten, so dien thoai, email, mat khau va nhap lai. So khop mat khau, kiem tra email, tim vai tro Khach hang va luu. Chuyen den dang nhap; hien loi neu mot buoc kiem tra that bai."],
    ["02","Dang nhap va phan quyen",["KH","KD","KT","QT"],"Nhan email va mat khau. Kiem tra khoa tam thoi, thong tin dang nhap, trang thai tai khoan. Tao phien va chuyen trang theo vai tro."],
    ["03","Dat thue va giu cho",["KH"],"Nhan gio hang, ngay thue, dia chi va ma uu dai neu co. Kiem tra CCCD trong ho so, dieu kien cong no, ngay thue va kha dung. Lap hop dong Cho duyet, giu thiet bi va mo trang ky."],
    ["04","Ky hop dong tren Web",["KH"],"Chu ho so chon so ky, tai anh CCCD hai mat va ky. Luu ho so ky khi hop le. Ho tro tep mat truoc tu luong cu; dieu kien giao may duoc kiem tra rieng."],
    ["05","Thanh toan va doi soat",["KH","TT","KD","QT"],"Khach chuyen tien. Doi soat ma hop dong, so tien va ma giao dich. Bo qua giao dich trung; ghi phieu thu moi va so du. Tra thieu theo ky thi giu phan con phai thu."],
    ["06","Ban giao va lap bien ban",["KD","QT","KT"],"Doi chieu serial theo chi tiet hop dong. Admin/KinhDoanh xac nhan giao khi co chu ky khach, CCCD mat truoc va chu ky nhan vien. Tao bien ban neu chua co."],
    ["07","Bao cao su co",["KH"],"Chon thiet bi thuoc hop dong dang thue va gui mo ta loi. Kiem tra quyen va phieu dang xu ly cua thiet bi, sau do tiep nhan."],
    ["08","Dieu phoi va xu ly bao tri",["QT","KT"],"Phan cong, sua chua va cap nhat ket qua. Khach co the nghiem thu hoac yeu cau kiem tra lai khi phieu da xu ly."],
    ["09","Yeu cau va duyet gia han",["KH","KD","QT"],"Gui so ngay va ly do. Kiem tra lich luc gui va kiem tra lai luc duyet. Khi duyet, doi ngay ket thuc va them ky thanh toan."],
    ["10","Thu hoi va quyet toan",["KD","QT","KT"],"Lap bien ban thu hoi va cap nhat thiet bi. Admin/KinhDoanh xac nhan tra may va quyet toan. Con no thi cho quyet toan; co du coc thi ghi phieu chi hoan coc."],
    ["11","Theo doi cong no",["KD","QT"],"Tra cuu no theo hop dong, cac ky con no va lich su. Co mot nhom dung han va bon nhom qua han."],
    ["12","Xem va xuat bao cao",["KD","QT"],"Chon khoang thoi gian, xem bao cao va xuat Excel theo quyen."],
    ["13","Danh gia ket qua bao tri",["KH"],"Phieu thuoc khach va trang thai 3 hoac 5. Gui diem 1 den 5 va nhan xet neu co."]
  ],
  "business": [
    ["1","Tiep nhan va kiem tra lich",["KH","KD"]],
    ["2","Lap va ky hop dong",["KH","KD","QT"]],
    ["3","Ghi nhan khoan thu",["KH","TT","KD"]],
    ["4","Ban giao thiet bi",["KH","KD","KT"]],
    ["5","Theo doi su co va bao tri",["KH","QT","KT"]],
    ["6","Xu ly gia han",["KH","KD","QT"]],
    ["7","Thu hoi va quyet toan",["KH","KD","KT","QT"]]
  ],
